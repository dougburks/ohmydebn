#!/bin/bash
#
# ohmydebn-ai: launches the user's default AI assistant. Bound to Super+A
# (see install/keybinding/keybinding-custom.txt). The default is set by
# ohmydebn-ai-set-default - from each AI installer's "make it your
# default?" question, or OhMyDebn Menu > Setup > Defaults > Agent. Falls
# back to OpenCode - Super+A's original, hardcoded target - when nothing's
# been picked yet or the stored value isn't one of the known names, so
# upgraders' muscle memory doesn't change until they deliberately pick
# something else.
#
# Unless OpenCode isn't installed either: then nobody has been using it
# through Super+A, and going straight to its install prompt made OpenCode
# look like the only choice to a new user (now that the panel's AI button
# runs this too). Instead the OhMyDebn menu opens on Apps > AI, every
# assistant OhMyDebn offers; picking one installs it and asks whether to
# make it the default.

set -euo pipefail

DEFAULT_AI_FILE="$HOME/.config/ohmydebn/current/default-ai"

name=""
if [[ -f "$DEFAULT_AI_FILE" ]]; then
  stored=$(<"$DEFAULT_AI_FILE")
  case "$stored" in
  opencode | opencode-desktop | claude-code | claude-desktop | chatgpt | codex | grok | crush | omp | pi | t3code | vscode) name="$stored" ;;
  esac
fi

if [[ -z "$name" ]]; then
  if ! dpkg -s ohmydebn-opencode-cli >/dev/null 2>&1; then
    notify-send -i ohmydebn "Choose an AI assistant" \
      "Pick one to install. OhMyDebn then asks whether to make it your default for Super + A and the panel's AI button." 2>/dev/null || true
    exec /usr/share/ohmydebn/bin/ohmydebn-menu ai
  fi
  name="opencode"
fi

case "$name" in
opencode) exec /usr/share/ohmydebn/bin/ohmydebn-opencode ;;
opencode-desktop) exec /usr/share/ohmydebn/bin/ohmydebn-opencode-desktop ;;
claude-code) exec /usr/share/ohmydebn/bin/ohmydebn-claude-code ;;
claude-desktop) exec /usr/share/ohmydebn/bin/ohmydebn-claude-desktop ;;
chatgpt) exec /usr/share/ohmydebn/bin/ohmydebn-chatgpt ;;
codex) exec /usr/share/ohmydebn/bin/ohmydebn-codex ;;
grok) exec /usr/share/ohmydebn/bin/ohmydebn-grok ;;
crush) exec /usr/share/ohmydebn/bin/ohmydebn-crush ;;
omp) exec /usr/share/ohmydebn/bin/ohmydebn-omp ;;
pi) exec /usr/share/ohmydebn/bin/ohmydebn-pi ;;
t3code) exec /usr/share/ohmydebn/bin/ohmydebn-t3code ;;
vscode) exec /usr/share/ohmydebn/bin/ohmydebn-code ;;
esac
