#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "ohmydebn-t3code" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "T3 Code is not currently installed."
    echo
    echo "Continuing will install it, built from:"
    echo "https://github.com/pingdotgg/t3code"
    echo
    echo "T3 Code runs the AI coding agents you already have installed"
    echo "(OpenCode, Claude Code, Codex, Grok Build) side by side in one window."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  # This runs standalone, on-demand (via ohmydebn-t3code when it isn't
  # installed yet), independent of install.sh/ohmydebn-update's own flow -
  # see ohmydebn-gestures-install's/ohmydebn-opencode-install's own
  # comments for why that means it needs its own `apt update` first.
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install ohmydebn-t3code

  # Match T3 Code to the current OhMyDebn theme from its very first launch,
  # and keep it matched: ohmydebn-theme-set-t3code only publishes into an
  # existing state directory, so create it first.
  mkdir -p "${T3CODE_HOME:-$HOME/.t3}/userdata"
  /usr/share/ohmydebn/bin/ohmydebn-theme-set-t3code --activate || true

  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-ai-set-default --ask t3code || true
  fi
fi
