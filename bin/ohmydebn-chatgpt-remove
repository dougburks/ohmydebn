#!/bin/bash

set -euo pipefail

if ! dpkg -s "chatgpt" >/dev/null 2>&1; then
  echo
  echo "ChatGPT is not currently installed."
else
  if [ $# -eq 0 ]; then
    echo
    echo "Continuing will remove ChatGPT and its repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y purge chatgpt
  sudo /usr/bin/apt -y autoremove
fi
