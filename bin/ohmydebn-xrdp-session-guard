#!/bin/bash
# One graphical session per user, checked from either side. Exit 1 (with
# the reason on stdout, and in the system log) when the login must not go
# ahead, 0 otherwise. Run from /etc/X11/Xsession.d/45ohmydebn-xrdp-
# session-guard (config/xrdp/) at the start of every X login while the
# Remote Desktop Server is installed - see there for why. The user comes
# from USER (PAM_USER is honored too).
#
#   ohmydebn-xrdp-session-guard remote   an XRDP session is starting:
#                                        refuse if the user already has a
#                                        local (seated) graphical session
#   ohmydebn-xrdp-session-guard local    a local session is starting:
#                                        refuse if the user still has a
#                                        remote (seatless) graphical
#                                        session open - a disconnected but
#                                        not logged-out XRDP session would
#                                        otherwise make this login exit at
#                                        once (seen live)
#
# No argument means "remote", for a hand run.

set -euo pipefail

MODE=${1:-remote}
case "$MODE" in
remote | local) ;;
*)
  echo "Usage: ohmydebn-xrdp-session-guard [remote|local]" >&2
  exit 2
  ;;
esac

USER_TO_CHECK=${PAM_USER:-${USER:-}}
if [[ -z "$USER_TO_CHECK" ]]; then
  exit 0
fi

# Override for a site that really wants shared-user sessions: set it in
# /etc/environment, which both the display manager's and xrdp-sesman's
# PAM stacks load into the session.
if [[ "${OHMYDEBN_XRDP_ALLOW_SHARED_USER:-}" == "1" ]]; then
  exit 0
fi

if ! command -v loginctl >/dev/null 2>&1; then
  exit 0
fi

# Columns: SESSION UID USER SEAT ... on every systemd/elogind version
# (later ones add more after SEAT). A local desktop has a seat; an XRDP
# session never does - that, plus a graphical Type (an ssh login is
# seatless too, but "tty"), is what tells the two apart.
while read -r sid _uid name seat _rest; do
  [[ "$name" == "$USER_TO_CHECK" ]] || continue
  [[ "$sid" != "${XDG_SESSION_ID:-}" ]] || continue
  seated=1
  [[ -n "$seat" && "$seat" != "-" ]] || seated=0
  if [[ "$MODE" == remote ]]; then
    [[ $seated -eq 1 ]] || continue
  else
    [[ $seated -eq 0 ]] || continue
  fi

  class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || true)
  state=$(loginctl show-session "$sid" -p State --value 2>/dev/null || true)
  type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || true)

  [[ "$class" == "user" ]] || continue
  [[ "$state" != "closing" ]] || continue
  [[ "$type" == "x11" || "$type" == "wayland" ]] || continue

  # Short lines: the drop-in shows this through xmessage, which doesn't
  # wrap - one long line runs off the screen.
  if [[ "$MODE" == remote ]]; then
    logger -t ohmydebn-xrdp-session-guard \
      "Refusing XRDP session for '$USER_TO_CHECK': local graphical session '$sid' is active on '$seat'" || true
    printf '%s\n' \
      "OhMyDebn: user '$USER_TO_CHECK' is still logged into the local desktop (session $sid on $seat)," \
      "so this remote session can't start." \
      "Log out of the local desktop first, then connect again."
  else
    logger -t ohmydebn-xrdp-session-guard \
      "Refusing local session for '$USER_TO_CHECK': remote desktop session '$sid' is still open" || true
    printf '%s\n' \
      "OhMyDebn: user '$USER_TO_CHECK' still has a remote desktop session open (session $sid)," \
      "so this login can't start." \
      "Log out of that remote session first - or end it from a text console" \
      "(Ctrl+Alt+F3, log in, then: loginctl terminate-session $sid)."
  fi
  exit 1
done < <(loginctl list-sessions --no-legend 2>/dev/null || true)

exit 0
