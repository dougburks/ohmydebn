#!/bin/bash

set -euo pipefail

if ! dpkg -s "tailscale" >/dev/null 2>&1; then
  echo
  echo "Tailscale is not currently installed."
  echo
  echo "Continuing will install it from:"
  echo "https://pkgs.tailscale.com/"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r

  # The key is checked against its fingerprint before apt trusts it (see
  # ohmydebn-pgp-fingerprint), so a key swapped in transit or on the server
  # is refused. Tailscale doesn't publish the fingerprint anywhere; this is
  # the key every one of its repos (Debian, Ubuntu, Fedora) has served since
  # 2020 (checked 2026-10-27). Its tailscale-archive-keyring package rotates
  # the key on installed systems; a new install refuses a replaced key until
  # the fingerprint here is updated.
  KEY_URL=https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg
  KEY_FILE=$(mktemp)
  trap 'rm -f "$KEY_FILE"' EXIT
  curl -fsSL "$KEY_URL" -o "$KEY_FILE"
  if [ "$(/usr/share/ohmydebn/bin/ohmydebn-pgp-fingerprint "$KEY_FILE" || true)" != 2596A99EAAB33821893C0A79458CA832957F5868 ]; then
    echo "The signing key from $KEY_URL isn't Tailscale's, so it wasn't installed."
    exit 1
  fi
  sudo mkdir -p --mode=0755 /usr/share/keyrings
  sudo install -m 0644 "$KEY_FILE" /usr/share/keyrings/tailscale-archive-keyring.gpg

  # Written here rather than downloaded from Tailscale's
  # trixie.tailscale-keyring.list (which holds just this line): a file
  # fetched into sources.list.d as root could add any repo, or mark one
  # trusted, as Brave's downloaded .sources could before ohmydebn-brave-repo.
  echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian trixie main" |
    sudo /usr/bin/tee /etc/apt/sources.list.d/tailscale.list

  # Restricts this repo to the packages it's actually needed for - a bare
  # signed-by trusts the repo's key to sign anything, so without this a
  # compromised or malicious upstream could ship a package under some
  # other name and have apt prefer it on some later, completely unrelated
  # `apt install`/upgrade. tailscale-archive-keyring is only a Recommends
  # (confirmed via `apt-cache depends tailscale`, not a hard Depends like
  # Brave's brave-keyring), but it's how this repo rotates its own signing
  # key over time, so it's allowed alongside tailscale itself rather than
  # left to silently never install.
  printf 'Package: *\nPin: origin "pkgs.tailscale.com"\nPin-Priority: -1\n\nPackage: tailscale tailscale-archive-keyring\nPin: origin "pkgs.tailscale.com"\nPin-Priority: 500\n' |
    sudo tee /etc/apt/preferences.d/tailscale.pref >/dev/null

  # On separate lines so a failed update stops here under set -e: as
  # `update && install`, a failure skipped the install and carried on.
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install tailscale
  sudo /usr/bin/tailscale set --operator="$USER"
fi
