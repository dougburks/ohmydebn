#!/bin/bash
#
# Opens a plain (untiled) terminal running ohmydebn-omp-run - see
# ohmydebn-cliamp's own comment on why the payload lives in a separate
# script instead of here.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'Oh My Pi' -e /usr/share/ohmydebn/bin/ohmydebn-omp-run
