  case $(menu "Install" "🎵︎ cliamp terminal music player\n🎨︎ GIMP image editor\n🛜︎ UxPlay AirPlay receiver") in
  *cliamp*) install "cliamp" "cliamp" ;;
  *GIMP*) /usr/share/ohmydebn/bin/ohmydebn-gimp ;;
