#!/bin/bash
#
# Opens a plain (untiled) terminal running ohmydebn-claude-code-run - see
# ohmydebn-cliamp's own comment on why the payload lives in a separate
# script instead of here.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'Claude Code' -e /usr/share/ohmydebn/bin/ohmydebn-claude-code-run
