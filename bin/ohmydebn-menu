  menu "VPN" "󰖂  Cloudflare Warp\n󰖂  Tailscale"
  case "$MENU_RESULT" in
  *Cloudflare*) /usr/share/ohmydebn/bin/ohmydebn-cloudflare-warp ;;
  *Tailscale*) /usr/share/ohmydebn/bin/ohmydebn-tailscale ;;
