#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if dpkg -s "distrobox" >/dev/null 2>&1; then
  echo
  echo "Distrobox is already installed."
else
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Distrobox is not currently installed."
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  # Install packages
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install distrobox

  # Output message to user
  cat <<EOF

================================================================================

Distrobox is now installed.

EOF
fi
