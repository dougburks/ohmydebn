# Apps groups every app-launching category (previously top-level Go-menu
# entries in their own right) under one Go-menu entry, so the Go menu
# itself stays short - everything else there (Install, Remove, Update,
# System, ...) is a one-off action or tool, not "launch an app". A real,
# ordinary static menu() call - only its own last item, Other Apps, is the
# exception (see its own comment below).
show_apps_menu() {
  menu "Apps" "󱚤  AI\n󰖟  Browsers\n  Containers\n  Cybersecurity\n  Editors\n♫  Media\n  Office\n  Terminals\n󰒒  Utility\n  Virtualization\n󰖂  VPN\n󰀻  Other Apps"
  case "$MENU_RESULT" in
  *AI*) show_ai_menu ;;
  *Browsers*) show_browsers_menu ;;
  *Containers*) show_containers_menu ;;
  *Cybersecurity*) show_cybersecurity_menu ;;
  *Editor*) show_editor_menu ;;
  *Media*) show_media_menu ;;
  *Office*) show_office_menu ;;
  *Terminals*) show_terminals_menu ;;
  *Utility*) show_utility_menu ;;
  *Virtualization*) show_virtualization_menu ;;
  *VPN*) show_vpn_menu ;;
  *Other*) show_other_apps_menu ;;
  *) show_main_menu ;;
  esac
}

# Other Apps, unlike every other show_*_menu here, never calls menu() -
# there's no static "Title" "items" string to hand it (its content is
# runtime-discovered .desktop entries, scanned live inside
# ohmydebn-menu-picker itself - see get_apps_picker_result()'s own
# comment), so it talks to the persistent picker directly instead. That
# also means the menu-tree walk (bin/ohmydebn-menu-tree's _mt_walk(),
# recursing into show_apps_menu's own "Other Apps" item above) can't find
# a menu() call to parse here either - it warns ("no block for
# show_other_apps_menu") and moves on rather than failing, which is
# exactly the desired outcome: Other Apps stays out of the flattened
# search tree, live-merged into the top-level Go-menu search instead (see
# ohmydebn-menu-picker's load_leaves()/_matching_app_rows()).
show_other_apps_menu() {
  get_apps_picker_result
  case "$MENU_PICKER_RESULT" in
  "") show_apps_menu ;;
  esac
}

show_containers_menu() {
  menu "Containers" "  Docker\n  Podman\n  Distrobox"
  case "$MENU_RESULT" in
  *Docker*) /usr/share/ohmydebn/bin/ohmydebn-docker ;;
  *Podman*) /usr/share/ohmydebn/bin/ohmydebn-podman ;;
  *Distrobox*) /usr/share/ohmydebn/bin/ohmydebn-distrobox ;;
  *) show_apps_menu ;;
  esac
}

show_virtualization_menu() {
  menu "Virtualization" "  Boxes (Simple)\n  Virtual Machine Manager (Advanced)\n  Virtual Machine Networking"
  case "$MENU_RESULT" in
  *Boxes*) /usr/share/ohmydebn/bin/ohmydebn-boxes ;;
  *Manager*) /usr/share/ohmydebn/bin/ohmydebn-virtmanager ;;
  *Networking*) /usr/share/ohmydebn/bin/ohmydebn-virtmanager-passt-upgrade ;;
  *) show_apps_menu ;;
  esac
}

show_browsers_menu() {
  menu "Browsers" "󰖟  Brave Origin (minimal)\n󰖟  Brave Browser (extras)\n  Chromium (installed by default)\n  Firefox\n󰊯  Google Chrome\n󰖟  Helium"
  case "$MENU_RESULT" in
  *Origin*) /usr/share/ohmydebn/bin/ohmydebn-brave-origin ;;
  *Browser*) /usr/share/ohmydebn/bin/ohmydebn-brave-browser ;;
  *Chromium*) install "Chromium" "chromium" ;;
  *Firefox*) install "Firefox" "firefox-esr" ;;
  *Google*) /usr/share/ohmydebn/bin/ohmydebn-google-chrome-stable ;;
  *Helium*) /usr/share/ohmydebn/bin/ohmydebn-helium-bin ;;
  *) show_apps_menu ;;
  esac
}

show_ai_menu() {
  # Picking any of these also makes it ohmydebn-ai's (Super+A's) default -
  # see ohmydebn-ai-set-default - so there's no separate "set default AI"
  # menu duplicating this same list.
  menu "AI" "󱚤  OpenCode (supports free/$ models)\n󱚤  Claude Code (Anthropic)\n󱚤  ChatGPT (OpenAI)\n󱚤  Pi (earendil-works)\n  VSCode (GitHub Copilot AI)\n  Antigravity (Google Agentic AI)"
  case "$MENU_RESULT" in
  *OpenCode*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default opencode; /usr/share/ohmydebn/bin/ohmydebn-ai ;;
  *Claude*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default claude-code; /usr/share/ohmydebn/bin/ohmydebn-claude-code ;;
  *ChatGPT*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default chatgpt; /usr/share/ohmydebn/bin/ohmydebn-chatgpt ;;
  *Pi*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default pi; /usr/share/ohmydebn/bin/ohmydebn-ai ;;
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default antigravity; /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default vscode; /usr/share/ohmydebn/bin/ohmydebn-code ;;
  *) show_apps_menu ;;
  esac
}

show_editor_menu() {
  menu "Editors" "  VSCode\n  Antigravity\n  Emacs\n  GIMP"
  case "$MENU_RESULT" in
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-code ;;
  *Emacs*) /usr/share/ohmydebn/bin/ohmydebn-emacs ;;
  *GIMP*) /usr/share/ohmydebn/bin/ohmydebn-gimp ;;
  *) show_apps_menu ;;
  esac
}


show_remove_menu() {
  menu "Remove" "  Package\n  Web App\n  TUI"
  case "$MENU_RESULT" in
  *Package*) terminal "Remove Package" /usr/share/ohmydebn/bin/ohmydebn-pkg-remove ;;
  *Web*) present_terminal "Remove Web App" /usr/share/ohmydebn/bin/ohmydebn-webapp-remove ;;
  *TUI*) present_terminal "Remove TUI App" /usr/share/ohmydebn/bin/ohmydebn-tui-remove ;;
  *) show_main_menu ;;
  esac
}

show_update_menu() {
  menu "Update" "  OhMyDebn\n  Password\n  Timezone"
  case "$MENU_RESULT" in
  *OhMyDebn*) /usr/share/ohmydebn/bin/ohmydebn-update-gui ;;
  *Password*) show_update_password_menu ;;
  *Timezone*) cinnamon-settings calendar ;;
  *) show_main_menu ;;
  esac
}

show_update_password_menu() {
  menu "Update Password" "  User"
  case "$MENU_RESULT" in
  *User*) present_terminal "Change Password" passwd ;;
  *) show_update_menu ;;
  esac
}

show_system_menu() {
  menu "System" "  Lock\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown"
  case "$MENU_RESULT" in
  *Lock*) cinnamon-screensaver-command -l ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) /usr/bin/cinnamon --replace & ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  # go_items is the single source of truth for both the picker's default
  # (empty-query) view and menu_tree_flatten/-categories' recursive walk
  # (bin/ohmydebn-menu-tree) - it's real, executed bash (passed as an
  # argument below), not a comment, so it can't silently drift out of
  # sync the way dead/unused data could.
  local go_items="󰀻  Apps\n󰧑  Learn\n  Trigger\n  Style\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  Demo\n  System"
  menu "Go" "$go_items"
  go_to_menu "$MENU_RESULT"
}

# Dispatches a bare category label - used both for show_main_menu's own
# picker result above, and directly for the DIRECT_ACCESS CLI-arg path at
# the bottom of this script (e.g. `ohmydebn-menu install` from a
# keybinding). menu() now resolves every searched-descendant breadcrumb
# itself before anything gets here, so this never receives one anymore -
# every "${1,,}" case arm here only ever needs to match a same-level label.
go_to_menu() {
  case "${1,,}" in
  *office*) show_office_menu ;;
  *apps*) show_apps_menu ;;
  *trigger*) show_trigger_menu ;;
  *learn*) show_learn_menu ;;
  *style*) /usr/share/ohmydebn/bin/ohmydebn-theme-carousel ;;
  *theme*) /usr/share/ohmydebn/bin/ohmydebn-theme-carousel ;;
  *container*) show_containers_menu ;;
  *ai*) show_ai_menu ;;
  *browser*) show_browsers_menu ;;
  *capture*) show_capture_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *speedtest*) show_speed_test_menu ;;
  *install*) show_install_menu ;;
  *virtualization*) show_virtualization_menu ;;
  *vpn*) show_vpn_menu ;;
  *editor*) show_editor_menu ;;
  *cybersecurity*) show_cybersecurity_menu ;;
  *media*) show_media_menu ;;
  *utility*) show_utility_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) /usr/share/ohmydebn/bin/ohmydebn-fastfetch-gui ;;
  *demo*) /usr/share/ohmydebn/bin/ohmydebn-demo-gui ;;
  *system*) show_system_menu ;;
  esac
}

if [[ -n "${1:-}" ]]; then
  DIRECT_ACCESS=true
  go_to_menu "$1"
else
  show_main_menu
fi
