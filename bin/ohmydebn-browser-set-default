#!/bin/bash
#
# ohmydebn-browser-set-default: makes one installed browser the default web
# browser - the one xdg-open, links clicked in other apps, Super+B
# (bin/ohmydebn-browser) and PDFs all land in. One script for the whole
# job because it's four separate mechanisms that have to agree:
#   update-alternatives  x-www-browser and gnome-www-browser - what
#                        sensible-browser and Debian-style tools go by
#   xdg-settings         the desktop-wide default - what ohmydebn-browser
#                        and xdg-open go by; Cinnamon's Preferred
#                        Applications panel sets only this one
#   xdg-mime             the http/https scheme handlers, and the PDF viewer
# A browser's own "make me the default" dialog and Cinnamon's panel each
# set just the xdg part, which is how a system ends up with two different
# answers to "what's my browser".
#
# Callers: install/config/mimetypes.sh (a new install's default),
# each ohmydebn-<browser>-install's "make it your default?" question after
# a browser is installed from the menu (--ask), and OhMyDebn Menu > Setup >
# Defaults > Browser (bin/ohmydebn-menu's pick_default_browser), which lists
# --list-installed and marks --current. Every browser in Apps > Browsers is
# in the table below.
#
# Usage: ohmydebn-browser-set-default [--ask|--pdf-only] <package>
#        ohmydebn-browser-set-default --current | --list-installed | --repair
#   <package>   the apt package name: brave-origin, brave-browser, chromium,
#               google-chrome-stable, helium-bin or firefox-esr. "chromium"
#               covers Ubuntu's snap too (see bin/ohmydebn-chromium-install).
#   --ask       ask first, defaulting to no. This runs right after an
#               installer's own "Press Enter to continue", so a reflexive
#               second Enter must not silently take over the default. A
#               "no" is not an error; the user is told where to change it
#               later.
#   --pdf-only  only the PDF viewer - mimetypes.sh's one-time catch-up for
#               installs from before the PDF handler was ever set.
#   --current   print the package of the current default browser (the
#               xdg-settings one), or nothing if it isn't one of these.
#   --list-installed
#               print "package<TAB>name" for each installed browser.
#   --repair    if the default browser has been uninstalled, make another
#               installed one the default: Brave Origin first, then
#               Chromium (the same order a new install picks in), then the
#               rest. Changes nothing otherwise. No question: the browser
#               it replaces is gone, so there's no choice to keep. Run by
#               every ohmydebn-<browser>-remove after its purge, and by
#               install/config/mimetypes.sh on every update, for a browser
#               removed with apt directly.

set -uo pipefail

ALL_PACKAGES=(brave-origin brave-browser chromium firefox-esr google-chrome-stable helium-bin)

MODE=full
case "${1:-}" in
--ask) MODE=ask; shift ;;
--pdf-only) MODE=pdf; shift ;;
--current) MODE=current ;;
--list-installed) MODE=list ;;
--repair) MODE=repair ;;
esac
PACKAGE="${1:-}"

# The binary given to update-alternatives has to be the exact path the
# package's own postinst registered (Brave's, Chrome's and Debian's Firefox
# all register one; Helium's doesn't) - /usr/bin/brave-origin and friends
# are themselves alternatives symlinks on top of it and would register as
# a second, separate entry. Desktop ids are the primary .desktop each
# package ships; Brave and Chrome also ship a reverse-DNS duplicate
# (com.brave.Origin.desktop, com.google.Chrome.desktop) that isn't used.
# lookup() sets NAME, BIN and DESKTOP for one package and fails for an
# unknown one.
lookup() {
  case "$1" in
  brave-origin)
    NAME="Brave Origin"; BIN=/usr/bin/brave-origin-stable; DESKTOP=brave-origin.desktop ;;
  brave-browser)
    NAME="Brave Browser"; BIN=/usr/bin/brave-browser-stable; DESKTOP=brave-browser.desktop ;;
  chromium)
    # Debian's deb, or Ubuntu's strictly-confined snap: no /usr/bin/chromium,
    # a /snap/bin dispatcher symlink, and a snapd-scheme desktop id.
    NAME="Chromium"
    if snap list chromium >/dev/null 2>&1 && ! dpkg -s chromium >/dev/null 2>&1; then
      BIN=/snap/bin/chromium; DESKTOP=chromium_chromium.desktop
    else
      BIN=/usr/bin/chromium; DESKTOP=chromium.desktop
    fi ;;
  google-chrome-stable)
    NAME="Google Chrome"; BIN=/usr/bin/google-chrome-stable; DESKTOP=google-chrome.desktop ;;
  helium-bin)
    NAME="Helium"; BIN=/usr/bin/helium; DESKTOP=helium.desktop ;;
  firefox-esr)
    NAME="Firefox"; BIN=/usr/bin/firefox-esr; DESKTOP=firefox-esr.desktop ;;
  *) return 1 ;;
  esac
}

installed() {
  dpkg -s "$1" >/dev/null 2>&1 && return 0
  [ "$1" = chromium ] && snap list chromium >/dev/null 2>&1
}

if [ "$MODE" = list ]; then
  for pkg in "${ALL_PACKAGES[@]}"; do
    if installed "$pkg" && lookup "$pkg"; then
      printf '%s\t%s\n' "$pkg" "$NAME"
    fi
  done
  exit 0
fi

if [ "$MODE" = current ]; then
  current_desktop=$(xdg-settings get default-web-browser 2>/dev/null)
  for pkg in "${ALL_PACKAGES[@]}"; do
    if lookup "$pkg" && [ "$DESKTOP" = "$current_desktop" ]; then
      echo "$pkg"
      break
    fi
  done
  exit 0
fi

# The first desktop id ~/.config/mimeapps.list names as the default for a
# MIME type, or nothing. Read directly rather than asked of xdg-settings or
# xdg-mime: when the default's .desktop file is gone, they quietly answer
# with some other browser that handles the type instead (Firefox, in a VM
# where Chrome was the default and was removed).
mimeapps_default() {
  local line in_defaults=0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in
    "[Default Applications]") in_defaults=1 ;;
    "["*) in_defaults=0 ;;
    "$1="*)
      if [ $in_defaults -eq 1 ]; then
        line=${line#*=}
        echo "${line%%;*}"
        return
      fi
      ;;
    esac
  done <"${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" 2>/dev/null
}

# Whether the app behind a desktop id is still there: for the browsers in
# the table, whether their package is installed (Chromium's two ids both
# count, deb or snap), and for anything else, whether its .desktop file is
# in an applications dir - the XDG data dirs, plus snap's and flatpak's
# export dirs in case this runs outside a session that lists them.
app_present() {
  local id=$1 pkg dir
  if [ "$id" = chromium.desktop ] || [ "$id" = chromium_chromium.desktop ]; then
    installed chromium
    return
  fi
  for pkg in "${ALL_PACKAGES[@]}"; do
    if lookup "$pkg" && [ "$DESKTOP" = "$id" ]; then
      installed "$pkg"
      return
    fi
  done
  local -a dirs
  IFS=: read -r -a dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"
  for dir in "${dirs[@]}"; do
    [ -n "$dir" ] && [ -f "$dir/applications/$id" ] && return 0
  done
  return 1
}

if [ "$MODE" = repair ]; then
  removed=$(mimeapps_default x-scheme-handler/https)
  if [ -z "$removed" ] || app_present "$removed"; then
    exit 0
  fi
  PACKAGE=""
  for pkg in brave-origin chromium "${ALL_PACKAGES[@]}"; do
    if installed "$pkg"; then
      PACKAGE=$pkg
      break
    fi
  done
  if [ -z "$PACKAGE" ]; then
    echo "Your default web browser is no longer installed, and there's no other browser to switch to. Install one: OhMyDebn Menu > Apps > Browsers."
    exit 0
  fi
  lookup "$PACKAGE"
  echo "Your default web browser is no longer installed, so $NAME is your default browser now. Change it any time: OhMyDebn Menu > Setup > Defaults > Browser."
  # The PDF viewer moves too only if it was the same removed app: one the
  # user picked separately stays.
  [ "$(mimeapps_default application/pdf)" = "$removed" ] && REPAIR_PDF=true || REPAIR_PDF=false
fi

if ! lookup "$PACKAGE"; then
  echo "Usage: ohmydebn-browser-set-default [--ask|--pdf-only] <brave-origin|brave-browser|chromium|google-chrome-stable|helium-bin|firefox-esr> | --current | --list-installed | --repair" >&2
  exit 1
fi

if ! installed "$PACKAGE"; then
  echo "$NAME is not installed. Install it first: OhMyDebn Menu > Apps > Browsers." >&2
  exit 1
fi

if [ "$MODE" = ask ]; then
  echo
  # printf + read rather than read -p: bash shows a -p prompt only when
  # stdin is a terminal, and the floating install terminal's isn't always.
  printf 'Make %s your default web browser? [y/N] ' "$NAME"
  read -r answer
  if [[ "${answer,,}" != y* ]]; then
    echo "Keeping your current default browser. Change it any time: OhMyDebn Menu > Setup > Defaults > Browser."
    exit 0
  fi
fi

# Every step runs even if an earlier one fails (a denied sudo shouldn't
# also cost the xdg half), and the exit status says whether all of them
# took: mimetypes.sh ignores it, the menu's terminal shows it.
FAILED=false
step() { "$@" || FAILED=true; }

if [ "$MODE" != pdf ]; then
  /usr/share/ohmydebn/bin/ohmydebn-headline "Configuring $NAME as default web browser"
  step sudo update-alternatives --install /usr/bin/x-www-browser x-www-browser "$BIN" 200
  step sudo update-alternatives --set x-www-browser "$BIN"
  step sudo update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser "$BIN" 200
  step sudo update-alternatives --set gnome-www-browser "$BIN"
  step xdg-settings set default-web-browser "$DESKTOP"
  step xdg-mime default "$DESKTOP" x-scheme-handler/http
  step xdg-mime default "$DESKTOP" x-scheme-handler/https
fi

if [ "$MODE" != repair ] || [ "$REPAIR_PDF" = true ]; then
  /usr/share/ohmydebn/bin/ohmydebn-headline "Configuring $NAME as default pdf viewer"
  step xdg-mime default "$DESKTOP" application/pdf
fi

if [ "$FAILED" = true ]; then
  echo "Warning: not every default-browser setting could be applied - see the errors above." >&2
  exit 1
fi
