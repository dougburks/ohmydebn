#!/bin/bash
#
# ohmydebn-theme-set-icon: Set icon theme based on current theme
# Usage: ohmydebn-theme-set-icon
#

set -e

# Set default icon theme to grey which should work with most themes
ICON_THEME="Mint-Y-Grey"

# Read theme name from current theme file
THEME_NAME=$(cat ~/.config/ohmydebn/current/theme.name 2>/dev/null || echo "ohmydebn")

# For our default themes and certain extra themes, select a corresponding mint icon theme
case $THEME_NAME in
# blue
ethereal | hackerman | ohmydebn | solarizedosaka | white)
  ICON_THEME="Mint-Y-Blue"
  ;;
# green
gruvbox | osaka-jade | solarized)
  ICON_THEME="Mint-Y"
  ;;
# grey
ash | everforest | flexoki-light | miasma | vantablack)
  ICON_THEME="Mint-Y-Grey"
  ;;
# navy
kanagawa | nord | solarized-light)
  ICON_THEME="Mint-Y-Navy"
  ;;
# pink
pink-blood-omarchy | rose-pine-dark)
  ICON_THEME="Mint-Y-Pink"
  ;;
# purple
catppuccin | catppuccin-latte | rose-pine | synthwave84 | tokyo-night)
  ICON_THEME="Mint-Y-Purple"
  ;;
# yellow
matte-black | retropc | ristretto)
  ICON_THEME="Mint-Y-Sand"
  ;;
*)
  # For any other theme, check to see if it specifies an icon theme
  # If so, then use that icon theme to select a corresponding mint icon theme
  if [[ -f ~/.config/ohmydebn/current/theme/icons.theme ]]; then
    ORIG_ICON_THEME=$(cat ~/.config/ohmydebn/current/theme/icons.theme)
    case $ORIG_ICON_THEME in
    # blue
    DodgerBlue | Papirus-Dark | Yaru-blue | Yaru-blue-dark)
      ICON_THEME="Mint-Y-Blue"
      ;;
    # green
    Yaru-sage | Yaru-olive | Yaru-prussiangreen)
      ICON_THEME="Mint-Y"
      ;;
    # purple
    Yaru-magenta | Yaru-purple | Yaru-purple-dark)
      ICON_THEME="Mint-Y-Purple"
      ;;
    # red
    Yaru | Yaru-red | Yaru-red-dark)
      ICON_THEME="Mint-Y-Red"
      ;;
    # yellow
    Yaru-yellow | Yaru-yellow-dark)
      ICON_THEME="Mint-Y-Sand"
      ;;
    esac
  fi
  ;;
esac

# Apply icon theme using gsettings
gsettings set org.cinnamon.desktop.interface icon-theme "$ICON_THEME"
