#!/bin/bash

set -euo pipefail

if ! dpkg -s "libreoffice-common" >/dev/null 2>&1; then
  echo
  echo "Libreoffice is not currently installed."
else
  echo
  echo "Continuing will remove Libreoffice."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read input
  sudo /usr/bin/apt -y purge "libreoffice-*"
  sudo /usr/bin/apt -y autoremove
fi
