#!/bin/bash
set -euo pipefail

# Cycles through the background images available
# Usage: ohmydebn-theme-bg-next [--print] [--background <arg>]
#   <arg> can be "random" or a number (1-based index)
#   --print prints the background that would be chosen instead of setting
#   it: ohmydebn-theme-set starts the background's intro first, so the
#   switch happens underneath it.

PRINT_ONLY=false
if [[ "${1:-}" == "--print" ]]; then
  PRINT_ONLY=true
  shift
fi
BG_ARG=""
if [[ "${1:-}" == "--background" ]]; then
  BG_ARG="${2:-}"
  if [[ -n "$BG_ARG" && "$BG_ARG" != "random" && ! "$BG_ARG" =~ ^[0-9]+$ ]]; then
    echo "Error: --background argument must be 'random' or a number" >&2
    exit 1
  fi
fi

# cat, not $(<file): with a redirect added, $(<file) is an empty command
# rather than a read, and always came back empty - so the user's own
# backgrounds for the theme (USER_BACKGROUNDS_PATH) were never looked in,
# and the theme carousel, which does list them, applied the wrong one.
THEME_NAME=$(cat "$HOME/.config/ohmydebn/current/theme.name" 2>/dev/null) || true
THEME_BACKGROUNDS_PATH="$HOME/.config/ohmydebn/current/theme/backgrounds/"
USER_BACKGROUNDS_PATH="$HOME/.config/ohmydebn/backgrounds/$THEME_NAME/"
CURRENT_BACKGROUND_LINK="$HOME/.config/ohmydebn/current/background"

# LC_ALL=C: by byte (so by codepoint), the order the theme carousel sorts
# in. The carousel applies its N-th background as `--background N`, and a
# locale sort put "aurora.jpg" before "Beach.jpg" where the carousel puts
# it after, so it could apply a different wallpaper than it showed.
mapfile -d '' -t BACKGROUNDS < <(
  find -L "$USER_BACKGROUNDS_PATH" "$THEME_BACKGROUNDS_PATH" -maxdepth 1 -type f -print0 2>/dev/null | LC_ALL=C sort -z
)
TOTAL=${#BACKGROUNDS[@]}

if [[ $TOTAL -eq 0 ]]; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -i ohmydebn "No background was found for theme" -t 2000
  fi
else
  # Get current background from symlink
  if [[ -L "$CURRENT_BACKGROUND_LINK" ]]; then
    CURRENT_BACKGROUND=$(readlink "$CURRENT_BACKGROUND_LINK")
  else
    # Default to first background if no symlink exists
    CURRENT_BACKGROUND=""
  fi

  # Find current background index
  INDEX=-1
  for i in "${!BACKGROUNDS[@]}"; do
    if [[ "${BACKGROUNDS[$i]}" == "$CURRENT_BACKGROUND" ]]; then
      INDEX=$i
      break
    fi
  done

  if [[ "$BG_ARG" == "random" ]]; then
    RANDOM_INDEX=$(( RANDOM % TOTAL ))
    NEW_BACKGROUND="${BACKGROUNDS[$RANDOM_INDEX]}"
  elif [[ "$BG_ARG" =~ ^[0-9]+$ ]]; then
    # 1-based index, wrapping past the last one. 10#: a leading zero ("08")
    # would otherwise be read as octal and abort the switch half done; 0
    # means the first, not (wrapping backwards) the last.
    SPECIFIC_INDEX=$((10#$BG_ARG))
    ((SPECIFIC_INDEX >= 1)) || SPECIFIC_INDEX=1
    SPECIFIC_INDEX=$(((SPECIFIC_INDEX - 1) % TOTAL))
    NEW_BACKGROUND="${BACKGROUNDS[$SPECIFIC_INDEX]}"
  elif [[ $INDEX -eq -1 ]]; then
    # Use the first background when no match was found
    NEW_BACKGROUND="${BACKGROUNDS[0]}"
  else
    NEXT_INDEX=$(((INDEX + 1) % TOTAL))
    NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
  fi

  if [[ "$PRINT_ONLY" == true ]]; then
    echo "$NEW_BACKGROUND"
  else
    /usr/share/ohmydebn/bin/ohmydebn-theme-bg-set "$NEW_BACKGROUND"
  fi
fi
