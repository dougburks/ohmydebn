#!/bin/bash

set -euo pipefail

# One terminal window for the whole lifecycle (install-if-needed, then
# run) instead of a separate floating install-presentation terminal
# followed by a second terminal for Pi itself - see ohmydebn-cliamp's
# own comment for why (confirmed live, same bug). Pi is a CLI/TUI coding
# agent (like OpenCode, not a GUI app like ChatGPT/Claude Code) and the
# package installs no /usr/bin symlink - only
# /usr/lib/ohmydebn-pi-coding-agent/pi - so it has to be run through a
# terminal directly at that path, the same way ohmydebn-opencode runs
# /usr/bin/opencode-cli.
exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'Pi' -e bash -c '
  if ! dpkg -s "ohmydebn-pi-coding-agent" >/dev/null 2>&1; then
    /usr/share/ohmydebn/bin/ohmydebn-show-logo
    /usr/share/ohmydebn/bin/ohmydebn-pi-install
    /usr/share/ohmydebn/bin/ohmydebn-show-done
  fi
  if dpkg -s "ohmydebn-pi-coding-agent" >/dev/null 2>&1; then
    mkdir -p ~/pi-sessions && cd "$(mktemp -d ~/pi-sessions/session-XXXXXX)"
    exec /usr/lib/ohmydebn-pi-coding-agent/pi
  fi
'
