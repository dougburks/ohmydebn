#!/bin/bash
#
# The browser tiled full-screen-with-gaps immediately after launch, via
# the shared ohmydebn-launch-tiled helper - the same TileFocusedWindow
# grid ("2 2 0 0 2 2") as the "Tile with gaps 5 full" keybinding. Bound
# to Super+B in keybinding-custom.txt in place of a bare call to
# ohmydebn-browser.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 0 0 2 2 -- /usr/share/ohmydebn/bin/ohmydebn-browser
