#!/bin/bash
#
# Aether theme builder tiled to the right half with gaps immediately
# after launch, via the shared ohmydebn-launch-tiled helper - the same
# TileFocusedWindow grid ("2 2 1 0 1 2") as the "Tile with gaps 6 right
# half" keybinding. Bound to Ctrl+Shift+A in keybinding-custom.txt in
# place of a bare call to /usr/share/aether/aether. Right half (not
# left) because the left half is reserved for the persistently-open
# terminal - see ohmydebn-terminal-left-tiled.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 1 0 1 2 -- /usr/share/aether/aether
