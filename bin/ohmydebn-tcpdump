#!/bin/bash

set -euo pipefail

if ! dpkg -s "tcpdump" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "tcpdump" /usr/share/ohmydebn/bin/ohmydebn-tcpdump-install
fi

if dpkg -s "tcpdump" >/dev/null 2>&1; then
  # tcpdump has no GUI, so "launching" it means opening a terminal already
  # running --help - a starting point for whatever capture options the
  # user actually needs - then dropping into an interactive shell in that
  # same window so they can act on it immediately instead of the terminal
  # just closing again.
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal "tcpdump" "tcpdump --help; exec bash"
fi
