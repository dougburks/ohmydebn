#!/bin/bash

set -euo pipefail

# One terminal window for the whole lifecycle (install-if-needed, then
# run) instead of a separate floating install-presentation terminal
# followed by a second terminal for Claude Code itself - see
# ohmydebn-cliamp's own comment for why (confirmed live, same bug).
exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'Claude Code' -e bash -c '
  if ! dpkg -s "claude-code" >/dev/null 2>&1; then
    /usr/share/ohmydebn/bin/ohmydebn-show-logo
    /usr/share/ohmydebn/bin/ohmydebn-claude-code-install
    /usr/share/ohmydebn/bin/ohmydebn-show-done
  fi
  if dpkg -s "claude-code" >/dev/null 2>&1; then
    mkdir -p ~/claude-sessions && cd "$(mktemp -d ~/claude-sessions/session-XXXXXX)"
    exec /usr/bin/claude
  fi
'
