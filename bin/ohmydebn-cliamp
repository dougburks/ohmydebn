#!/bin/bash
#
# Opens a terminal running ohmydebn-cliamp-run - the
# install-if-needed-then-run payload lives there, not here, matching the
# same single-terminal-window shape as claude-code/opencode/pi/socrates
# (see ohmydebn-cliamp-run's own comment). gTile-OhMyDebn's own
# window-created auto-tile handler tiles this window itself, matching its
# alacritty --title against /usr/share/ohmydebn/config/tile-rules.json -
# no separate *-tiled wrapper needed.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'cliamp' -e /usr/share/ohmydebn/bin/ohmydebn-cliamp-run
