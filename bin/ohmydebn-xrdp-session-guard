#!/bin/bash
# One graphical session per user: exit 1 (with the reason on stdout, and
# in the system log) when the user already owns a local graphical seat
# session, 0 otherwise. Run from /etc/X11/Xsession.d/45ohmydebn-xrdp-
# session-guard (config/xrdp/) at the start of every XRDP session - see
# there for why. The user comes from USER (PAM_USER is honored too, so a
# PAM hook could call this the same way).

set -euo pipefail

USER_TO_CHECK=${PAM_USER:-${USER:-}}
if [[ -z "$USER_TO_CHECK" ]]; then
  exit 0
fi

# Override for a site that really wants shared-user sessions: set it in
# /etc/environment, which xrdp-sesman's PAM stack loads into the session.
if [[ "${OHMYDEBN_XRDP_ALLOW_SHARED_USER:-}" == "1" ]]; then
  exit 0
fi

if ! command -v loginctl >/dev/null 2>&1; then
  exit 0
fi

# Columns: SESSION UID USER SEAT ... on every systemd/elogind version
# (later ones add more after SEAT); a remote session has no seat ("-" or
# empty), which is what separates a local desktop from another XRDP one.
while read -r sid _uid name seat _rest; do
  [[ "$name" == "$USER_TO_CHECK" ]] || continue
  [[ -n "$seat" && "$seat" != "-" ]] || continue

  class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || true)
  state=$(loginctl show-session "$sid" -p State --value 2>/dev/null || true)
  type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || true)

  [[ "$class" == "user" ]] || continue
  [[ "$state" != "closing" ]] || continue
  [[ "$type" == "x11" || "$type" == "wayland" ]] || continue

  logger -t ohmydebn-xrdp-session-guard \
    "Refusing XRDP session for '$USER_TO_CHECK': local graphical session '$sid' is active on '$seat'" || true
  # Short lines: the drop-in shows this through xmessage, which doesn't
  # wrap - one long line runs off the screen.
  printf '%s\n' \
    "OhMyDebn: user '$USER_TO_CHECK' is already logged into the local desktop (session $sid on $seat)," \
    "so this remote session can't start." \
    "Log out locally first, or use a separate user for remote desktop."
  exit 1
done < <(loginctl list-sessions --no-legend 2>/dev/null || true)

exit 0
