#!/bin/bash
#
# ohmydebn-firewall-hint <port> <label>: show whether the firewall lets a
# service through, and how to let it through if not. OhMyDebn turns ufw on
# with inbound denied (install/config/ufw.sh), so a freshly installed
# server listens but no one can reach it - and OhMyDebn deliberately never
# opens a port itself: whether a service should be reachable from anywhere
# or from one address or range is the user's call. Reads the live state
# (ufw status needs root, so this asks for sudo - a declined prompt falls
# back to the commands alone), lists the rules for the port when there
# are any, and otherwise prints the two allow commands, most restrictive
# first. The restrictive one's example range is this machine's own
# network: a fixed 192.168.1.0/24, pasted as it was, made a rule that
# didn't admit a host on any other network (a VM's on 192.168.199.0/24).
#
# Usage: ohmydebn-firewall-hint 3389 "Remote Desktop Server"

if [ "$#" -ne 2 ]; then
  echo "Usage: ohmydebn-firewall-hint <port> <label>" >&2
  exit 1
fi
PORT="$1"
LABEL="$2"

# ufw is in /usr/sbin, which a normal user's PATH leaves out on Debian
# (Ubuntu's has it), so command -v alone never found it there and this
# said nothing at all. Looked for on PATH first, then in these.
SBIN_DIRS="/usr/sbin:/sbin"
if ! PATH="$PATH:$SBIN_DIRS" command -v ufw >/dev/null 2>&1; then
  exit 0
fi

# The network on the default route's interface (its link-scope route,
# such as 192.168.199.0/24: the network itself, no arithmetic needed), or
# nothing. Link-local 169.254.0.0/16 isn't one to suggest.
local_network() {
  local dev
  dev=$(PATH="$PATH:$SBIN_DIRS" ip -4 route show default 2>/dev/null |
    awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
  [ -n "$dev" ] || return 0
  PATH="$PATH:$SBIN_DIRS" ip -4 route show dev "$dev" scope link 2>/dev/null |
    awk '$1 ~ /\// && $1 !~ /^169\.254\./ {print $1; exit}'
}

allow_commands() {
  local network
  network=$(local_network)
  if [ -n "$network" ]; then
    echo "To allow it from one address or range (recommended), such as this machine's network:"
  else
    echo "To allow it from one address or range (recommended):"
  fi
  cat <<MSG
  sudo ufw allow from ${network:-192.168.1.0/24} to any port $PORT proto tcp comment 'OhMyDebn $LABEL'
From anywhere:
  sudo ufw allow $PORT/tcp comment 'OhMyDebn $LABEL'
MSG
}

if ! STATUS=$(sudo ufw status 2>/dev/null); then
  echo "The firewall denies inbound connections by default, so port $PORT stays closed until you allow it."
  allow_commands
  echo "To see what's allowed now: sudo ufw status"
  exit 0
fi

if [ "$(head -n1 <<<"$STATUS")" = "Status: inactive" ]; then
  echo "The firewall is inactive, so port $PORT is reachable."
  exit 0
fi

# Rule lines for this port: the To column is "3389", "3389/tcp" or
# "3389/tcp (v6)"; a port in the From column (a source port) isn't ours.
RULES=$(grep -E "^$PORT(/(tcp|udp))?( \(v6\))?[[:space:]]" <<<"$STATUS")
if [ -n "$RULES" ]; then
  echo "Firewall rules for port $PORT (sudo ufw status):"
  grep -E '^(To|--)[[:space:]]' <<<"$STATUS" | sed 's/^/  /'
  sed 's/^/  /' <<<"$RULES"
else
  echo "The firewall denies inbound connections by default, and no rule allows port $PORT yet."
  allow_commands
fi
