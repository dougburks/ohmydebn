#!/bin/bash
#
# Sets an X11 window fully transparent via _NET_WM_WINDOW_OPACITY, a
# compositor hint Cinnamon honors, so it stays invisible while it's moved
# into place. Used by ohmydebn-console for its window (Alacritty, an X11
# window under XWayland in Cinnamon's Wayland session too). Launchers
# that tile a new window don't need it: gTile keeps the window hidden
# itself (see ohmydebn-gtile-tile-next).

set -uo pipefail

WIN_ID="${1:-}"
[ -z "$WIN_ID" ] && exit 0

/usr/bin/xprop -id "$WIN_ID" -f _NET_WM_WINDOW_OPACITY 32c \
  -set _NET_WM_WINDOW_OPACITY 0 2>/dev/null || true
