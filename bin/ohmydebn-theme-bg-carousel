#!/usr/bin/python3
#
# ohmydebn-theme-bg-carousel: full-screen carousel for browsing the current
# theme's own backgrounds, replacing "Next Background in Current Theme"'s
# blind single-step cycle in ohmydebn-theme-set-gui.
#
# Unlike ohmydebn-theme-carousel (the full theme picker), this one applies
# for real on every arrow tap rather than only on Enter -
# ohmydebn-theme-bg-next (the same script the old blind-cycle menu entry
# already called) is just a symlink swap plus one `gsettings set`, timed at
# ~60-80ms - cheap and safe enough to run live, unlike a full theme's
# ~15-sub-script, ~1s apply. That makes this the more literal "live cycle"
# of the two: what you see IS your desktop, updated as you go. Escape
# restores whatever was set when the carousel opened (captured up front);
# Enter just closes, since the current selection is already live.

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

import os
import subprocess
import sys

OHMYDEBN_BIN = "/usr/share/ohmydebn/bin"
THEME_NAME_FILE = os.path.expanduser("~/.config/ohmydebn/current/theme.name")
THEME_BACKGROUNDS_DIR = os.path.expanduser("~/.config/ohmydebn/current/theme/backgrounds")
CURRENT_BACKGROUND_LINK = os.path.expanduser("~/.config/ohmydebn/current/background")

CAPTION_H = 90


def current_theme_name():
    try:
        with open(THEME_NAME_FILE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def list_backgrounds():
    """Same two search dirs, same sort, as ohmydebn-theme-bg-next itself -
    keeping this in exact lockstep with that script's own enumeration is
    what lets 1-based --background N calls below always mean the same
    background here as they would if bg-next counted it itself."""
    theme_name = current_theme_name()
    user_dir = os.path.expanduser(f"~/.config/ohmydebn/backgrounds/{theme_name}")
    paths = []
    for base in (user_dir, THEME_BACKGROUNDS_DIR):
        if not os.path.isdir(base):
            continue
        for name in os.listdir(base):
            full = os.path.join(base, name)
            if os.path.isfile(full):
                paths.append(full)
    return sorted(paths)


def current_background_path():
    try:
        return os.readlink(CURRENT_BACKGROUND_LINK)
    except OSError:
        return None


def get_monitor_geometry():
    display = Gdk.Display.get_default()
    seat = display.get_default_seat()
    _screen, x, y = seat.get_pointer().get_position()
    monitor = display.get_monitor_at_point(x, y) or display.get_primary_monitor() or display.get_monitor(0)
    return monitor.get_geometry()


def load_cover_pixbuf(path, target_w, target_h):
    pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
    src_w, src_h = pixbuf.get_width(), pixbuf.get_height()
    scale = max(target_w / src_w, target_h / src_h)
    new_w, new_h = max(1, round(src_w * scale)), max(1, round(src_h * scale))
    scaled = pixbuf.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)
    x = min(max(0, (new_w - target_w) // 2), new_w - target_w)
    y = min(max(0, (new_h - target_h) // 2), new_h - target_h)
    return scaled.new_subpixbuf(x, y, min(target_w, new_w), min(target_h, new_h))


CSS = """
#bgcarousel-caption {
    background-color: rgba(0, 0, 0, 0.55);
}
#bgcarousel-title {
    color: #ffffff;
    font-size: 16pt;
    font-weight: bold;
}
#bgcarousel-hint {
    color: rgba(255, 255, 255, 0.75);
    font-size: 10.5pt;
}
"""


class BackgroundCarousel(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False)
        self.set_keep_above(True)
        self._closing = False

        self.backgrounds = list_backgrounds()
        current = current_background_path()
        self.start_index = self.backgrounds.index(current) if current in self.backgrounds else 0
        self.index = self.start_index

        geo = get_monitor_geometry()
        self.set_default_size(geo.width, geo.height)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        overlay = Gtk.Overlay()
        self.add(overlay)

        self.bg_image = Gtk.Image()
        overlay.add(self.bg_image)

        caption = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        caption.set_name("bgcarousel-caption")
        caption.set_valign(Gtk.Align.END)
        caption.set_halign(Gtk.Align.FILL)
        caption.set_border_width(16)
        self.title_label = Gtk.Label()
        self.title_label.set_name("bgcarousel-title")
        self.hint_label = Gtk.Label(label="← → to browse   ·   Enter to keep   ·   Esc to revert")
        self.hint_label.set_name("bgcarousel-hint")
        caption.pack_start(self.title_label, False, False, 0)
        caption.pack_start(self.hint_label, False, False, 0)
        overlay.add_overlay(caption)
        overlay.set_overlay_pass_through(caption, True)

        self.connect("key-press-event", self.on_key_press)
        self.connect("show", lambda w: GLib.idle_add(self.render))

    def apply_index(self, index):
        subprocess.run(
            [f"{OHMYDEBN_BIN}/ohmydebn-theme-bg-next", "--background", str(index + 1)],
            check=False,
        )

    def move(self, delta):
        if not self.backgrounds:
            return
        self.index = (self.index + delta) % len(self.backgrounds)
        self.apply_index(self.index)
        self.render()

    def render(self):
        if not self.backgrounds:
            self.title_label.set_text("No backgrounds found for the current theme")
            self.hint_label.set_text("Esc to close")
            return GLib.SOURCE_REMOVE
        geo = get_monitor_geometry()
        path = self.backgrounds[self.index]
        self.bg_image.set_from_pixbuf(load_cover_pixbuf(path, geo.width, geo.height))
        self.title_label.set_text(
            f"Background {self.index + 1} of {len(self.backgrounds)}   —   {os.path.basename(path)}"
        )
        return GLib.SOURCE_REMOVE

    def on_key_press(self, widget, event):
        keyval = event.keyval
        if keyval == Gdk.KEY_Escape:
            self.finish(revert=True)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.finish(revert=False)
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_Up):
            self.move(-1)
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_Down):
            self.move(1)
            return True
        return False

    def finish(self, revert):
        if self._closing:
            return
        self._closing = True
        if revert and self.backgrounds and self.index != self.start_index:
            self.apply_index(self.start_index)
        Gtk.main_quit()


if __name__ == "__main__":
    win = BackgroundCarousel()
    win.show_all()
    win.fullscreen()
    Gtk.main()
    sys.exit(0)
