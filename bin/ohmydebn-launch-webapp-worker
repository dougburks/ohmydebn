#!/bin/bash
#
# Internal helper for ohmydebn-launch-webapp - not a menu entry itself,
# no install check, nothing user-facing. Picks the installed default
# browser and opens $1 as a kiosk/app window in it, falling back to
# xdg-open for anything else. Pulled out into its own script so
# ohmydebn-launch-webapp can wrap this browser-picking logic with
# ohmydebn-launch-tiled without also tiling ohmydebn-launch-tiled's own
# active-window-capture step before the browser exists.

# Get the default browser
DEFAULT_BROWSER=$(xdg-settings get default-web-browser)

# Check if the default browser is Firefox, Chromium, or a Chromium-based
# fork - all of these can open a dedicated window with no tabs (--app= for
# the Chromium family, --kiosk for Firefox, which has no --app=), unlike a
# plain xdg-open which just opens a normal tab in whatever's already
# running. Each fork is still a separate binary though,
# so the desktop-id substring has to map to the right one rather than
# lumping every Chromium-family browser into a literal `chromium` call:
# Google Chrome's own .desktop file is "google-chrome.desktop" regardless
# of the "-stable" package/binary suffix, and Brave's two variants
# (brave-browser, brave-origin) are separate binaries too - both need
# checking before their broader substring cousins ("chrome" / "brave") to
# avoid matching the wrong one.
browser=""
if [[ $DEFAULT_BROWSER == *"firefox"* ]]; then
    browser=firefox; args=(--kiosk "$1")
elif [[ $DEFAULT_BROWSER == *"chromium"* ]]; then
    browser=chromium; args=(--app="$1")
elif [[ $DEFAULT_BROWSER == *"chrome"* ]]; then
    browser=google-chrome-stable; args=(--app="$1")
elif [[ $DEFAULT_BROWSER == *"brave-origin"* ]]; then
    browser=brave-origin; args=(--app="$1")
elif [[ $DEFAULT_BROWSER == *"brave"* ]]; then
    browser=brave-browser; args=(--app="$1")
elif [[ $DEFAULT_BROWSER == *"helium"* ]]; then
    browser=helium; args=(--app="$1")
fi

# xdg-open for an unsupported browser, and for a default that still names
# one that's since been removed, which would otherwise run a missing
# command and open nothing: xdg-open opens the URL in whatever handles it
# now.
if [[ -n $browser ]] && command -v "$browser" >/dev/null 2>&1; then
    "$browser" "${args[@]}"
else
    xdg-open "$1"
fi
