#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if [ "$SKIP_PROMPT" = false ]; then
  echo
  echo "Remote Desktop (XRDP) is not currently configured."
  echo
  echo "Continuing will install xrdp/xorgxrdp and allow RDP connections."
  echo "Use this only on trusted networks, a VPN, or your LAN."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."

  read -r
fi

sudo /usr/bin/apt update
sudo /usr/bin/apt -y install xrdp xorgxrdp

if getent group ssl-cert >/dev/null && id xrdp >/dev/null 2>&1; then
  sudo adduser xrdp ssl-cert
fi

cat >"$HOME/.xsession" <<'EOF'
#!/bin/sh
# OhMyDebn Cinnamon session for XRDP
unset DBUS_SESSION_BUS_ADDRESS
unset SESSION_MANAGER
export XDG_SESSION_TYPE=x11
export DESKTOP_SESSION=cinnamon
export XDG_CURRENT_DESKTOP=X-Cinnamon
exec dbus-run-session -- cinnamon-session-cinnamon
EOF
chmod 755 "$HOME/.xsession"

touch "$HOME/.xsessionrc"
python3 - "$HOME/.xsessionrc" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1]).expanduser()
content = path.read_text()
old_block = '''
# Update PATH to include OhMyDebn binaries
if ! [[ "$PATH" =~ "/usr/share/ohmydebn/bin:" ]]; then
  export PATH="/usr/share/ohmydebn/bin:$PATH"
fi
'''
for candidate in (old_block, old_block.lstrip('\n')):
    content = content.replace(candidate, '\n')
if '# Update PATH to include OhMyDebn binaries' not in content:
    content += '''
# Update PATH to include OhMyDebn binaries
case ":$PATH:" in
  *:/usr/share/ohmydebn/bin:*) ;;
  *) export PATH="/usr/share/ohmydebn/bin:$PATH" ;;
esac
'''
path.write_text(content)
PY

sudo systemctl enable --now xrdp
sudo systemctl restart xrdp xrdp-sesman

# OhMyDebn enables UFW with denied inbound connections. XRDP needs an
# explicit inbound rule when the firewall is active.
if command -v ufw >/dev/null 2>&1; then
  sudo ufw allow 3389/tcp comment 'OhMyDebn XRDP'
fi

IP=$(hostname -I | awk '{print $1}')
echo
echo "XRDP is ready. Connect with Remmina/RDP to:"
echo "  $IP:3389"
echo
echo "If this user is already logged into the local desktop, create or use a separate user for XRDP."
