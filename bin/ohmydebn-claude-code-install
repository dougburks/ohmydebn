#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "claude-code" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Claude Code is not currently installed."
    echo
    echo "Continuing will install it from:"
    echo "https://downloads.claude.ai"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  # The key is checked against the fingerprint Anthropic publishes before
  # apt trusts it, as in ohmydebn-claude-desktop-install (the same key
  # signs both repositories).
  KEY_URL=https://downloads.claude.ai/keys/claude-code.asc
  KEY_FILE=$(mktemp)
  trap 'rm -f "$KEY_FILE"' EXIT
  curl -fsSL "$KEY_URL" -o "$KEY_FILE"
  if [ "$(/usr/share/ohmydebn/bin/ohmydebn-pgp-fingerprint "$KEY_FILE" || true)" != 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE ]; then
    echo "The Claude Code signing key from $KEY_URL isn't the one Anthropic publishes, so it wasn't installed."
    exit 1
  fi
  sudo install -D -m 0644 "$KEY_FILE" /usr/share/keyrings/claude-code.asc
  echo "deb [signed-by=/usr/share/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" |
    sudo tee /etc/apt/sources.list.d/claude-code.list >/dev/null

  # Restricts this repo to the one package it's actually needed for
  # (confirmed via `apt-cache depends claude-code` - no same-repo
  # dependency like Brave's brave-keyring) - a bare signed-by trusts the
  # repo's key to sign anything, so without this a compromised or
  # malicious upstream could ship a package under some other name and have
  # apt prefer it on some later, completely unrelated `apt install`/
  # upgrade.
  printf 'Package: *\nPin: origin "downloads.claude.ai"\nPin-Priority: -1\n\nPackage: claude-code\nPin: origin "downloads.claude.ai"\nPin-Priority: 500\n' |
    sudo tee /etc/apt/preferences.d/claude-code.pref >/dev/null

  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install claude-code

  # Theme it with the current OhMyDebn theme now: the theme hook skips
  # Claude Code while it isn't installed, so otherwise its first start
  # would wait for the next theme switch. A theme that can't be applied
  # mustn't fail the install.
  /usr/share/ohmydebn/bin/ohmydebn-theme-set-claude --current || true

  # Installed onto a system that may already have a default AI assistant:
  # ask before changing it (defaults to no, and says nothing when this is
  # already the default - see ohmydebn-ai-set-default). A setting that
  # couldn't be saved mustn't abort the install.
  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-ai-set-default --ask claude-code || true
  fi
fi
