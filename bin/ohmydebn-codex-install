#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "ohmydebn-codex-cli" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Codex is not currently installed."
    echo
    echo "Continuing will install it, built from:"
    echo "https://github.com/openai/codex"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  # This runs standalone, on-demand (via ohmydebn-codex-run when Super+A's
  # default AI assistant is Codex and it isn't installed yet), independent
  # of install.sh/ohmydebn-update's own flow - see
  # ohmydebn-gestures-install's/ohmydebn-opencode-install's own comments
  # for why that means it needs its own `apt update` first.
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install ohmydebn-codex-cli

  # Installed onto a system that may already have a default AI assistant:
  # ask before changing it (defaults to no, and says nothing when this is
  # already the default - see ohmydebn-ai-set-default). A setting that
  # couldn't be saved mustn't abort the install.
  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-ai-set-default --ask codex || true
  fi
fi
