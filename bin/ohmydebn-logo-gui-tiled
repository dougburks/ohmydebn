#!/bin/bash
#
# The OhMyDebn logo (same content as ohmydebn-logo-gui) tiled to the
# upper-right quarter with gaps immediately after launch, via
# ohmydebn-terminal-tiled's own OHMYDEBN_TILE_GRID override - the same
# TileFocusedWindow grid ("2 2 1 0 1 1") as the "Tile with gaps 9 top
# right corner" keybinding (also the same grid ohmydebn-fastfetch-gui's
# own tile-rules.json entry uses). Bound to Ctrl+Shift+O in
# keybinding-custom.txt in place
# of the plain ohmydebn-logo-gui, so the logo opens somewhere useful
# instead of covering the whole screen.

set -euo pipefail

export OHMYDEBN_TILE_GRID="2 2 1 0 1 1"
exec /usr/share/ohmydebn/bin/ohmydebn-terminal-tiled \
  --title 'OhMyDebn' -e /usr/share/ohmydebn/bin/ohmydebn-logo
