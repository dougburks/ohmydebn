  *LibreOffice*) install "libreoffice" "libreoffice" ;;
  *Calligra*) install "calligra" "calligra" ;;
  *Gnumeric*) install "gnumeric" "gnumeric" ;;
  *AbiWord*) install "abiword" "abiword" ;;
  *) show_install_menu ;;
  esac
}

