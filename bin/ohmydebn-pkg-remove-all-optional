#!/bin/bash

set -euo pipefail

if [ "${1:-}" != "--skip-prompt" ]; then
  echo "Continuing will remove all optional packages."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r
fi

for PACKAGE in abiword brasero calligra cliamp deja-dup docker.io distrobox duplicity emacs "firefox*" gnome-boxes \
  gnome-calculator gnome-chess gnome-games gnumeric goldendict-ng hexchat hoichess \
  "libreoffice*" localsend ohmydebn-opencode-cli pidgin podman rclone remmina tcpdump thunderbird "transmission*" \
  tshark uxplay virt-manager wireshark x11vnc; do
  # dpkg -l (unlike dpkg -s) supports glob patterns like "firefox*", so it
  # works for both exact package names and the wildcard entries below.
  if dpkg -l "$PACKAGE" 2>/dev/null | grep -q '^ii'; then
    sudo /usr/bin/apt -y purge "$PACKAGE"
  fi
done

sudo /usr/bin/apt -y autoremove

# Apps with their own dedicated ohmydebn-<package>-remove script for
# repo/keyring/config cleanup beyond a plain apt purge.
for PACKAGE in antigravity brave-browser brave-origin chatgpt claude-code cloudflare-warp code \
  google-chrome-stable helium-bin powershell simplescreenrecorder tailscale; do
  if dpkg -s "$PACKAGE" >/dev/null 2>&1; then
    "/usr/share/ohmydebn/bin/ohmydebn-${PACKAGE}-remove" --auto
  fi
done
