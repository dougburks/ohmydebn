#!/bin/bash

set -euo pipefail

# Nothing to do when it's already installed.
if ! dpkg -s "touchegg" >/dev/null 2>&1; then
  echo
  echo "Touchegg (touchpad gestures) is not currently installed."
  echo
  echo "Continuing will install it, built from:"
  echo "https://github.com/JoseExposito/touchegg"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."

  read -r

  # Install touchegg and dependency. This runs standalone, on-demand
  # (Ctrl+Alt+G), independent of install.sh/ohmydebn-update's own flow, so
  # it can't rely on some other step having refreshed the apt index
  # recently - `apt update` first, not just before an install triggered as
  # part of that main flow.
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install touchegg libpugixml1v5
fi
