#!/bin/bash

FASTFETCH_CONFIG=~/.config/fastfetch
mkdir -p "$FASTFETCH_CONFIG"

# The config is OhMyDebn's link (every release has written it as one, to
# the theme's config.jsonc or the default below). Anything else there is
# the user's own config, or their own link to one, and is left alone: it
# used to be replaced on every update and theme switch.
FASTFETCH_LINK="$FASTFETCH_CONFIG/config.jsonc"
FASTFETCH_LINK_OURS=false
if [ ! -e "$FASTFETCH_LINK" ] && [ ! -L "$FASTFETCH_LINK" ]; then
  FASTFETCH_LINK_OURS=true
elif [ -L "$FASTFETCH_LINK" ]; then
  case "$(readlink "$FASTFETCH_LINK")" in
  "$HOME"/.config/ohmydebn/current/* | /usr/share/ohmydebn/*) FASTFETCH_LINK_OURS=true ;;
  esac
fi

if [ "$FASTFETCH_LINK_OURS" = false ]; then
  :
elif [ -f ~/.config/ohmydebn/current/theme/config.jsonc ]; then
  ln -snf ~/.config/ohmydebn/current/theme/config.jsonc "$FASTFETCH_LINK"
else
  # Older themes with no colors.toml never get a templated config.jsonc (same
  # gap eza/vscode/etc have on these themes) - fall back to a static, unthemed
  # default rather than losing the OhMyDebn Version/Theme/Website lines
  # entirely. Accent color won't match the theme, but the identity lines will
  # still show.
  ln -snf /usr/share/ohmydebn/config/fastfetch/config-default.jsonc "$FASTFETCH_LINK"
fi

# The logo: OhMyDebn's grin in the theme's colors, which both configs
# point fastfetch at, and the frames the system summary window animates it
# with. Written before the refresh signal below, so an open window redraws
# with the new ones.
/usr/share/ohmydebn/bin/ohmydebn-fastfetch-logo-generate || true

# Refresh an already-open fastfetch window (ohmydebn-fastfetch-gui) in
# place, rather than leaving it showing stale colors until closed and
# reopened. Signal the PID directly instead of pkill - see
# ohmydebn-fastfetch-pause for why, and for the matching SIGUSR2 trap. The
# /proc/*/cmdline check guards against a stale pidfile pointing at a PID
# that's since exited and been reused by an unrelated process.
FASTFETCH_PAUSE_PID_FILE=~/.cache/ohmydebn/fastfetch-pause.pid
if [ -f "$FASTFETCH_PAUSE_PID_FILE" ]; then
  FASTFETCH_PAUSE_PID=$(cat "$FASTFETCH_PAUSE_PID_FILE")
  if grep -aq "ohmydebn-fastfetch-pause" "/proc/$FASTFETCH_PAUSE_PID/cmdline" 2>/dev/null; then
    kill -SIGUSR2 "$FASTFETCH_PAUSE_PID" 2>/dev/null || true
  fi
fi
