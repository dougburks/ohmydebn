#!/bin/bash
#
# Opens a plain (untiled) terminal running nvim - gTile-OhMyDebn's own
# window-created auto-tile handler tiles this window itself, matching
# wmClass "Alacritty" + title "nvim" against
# /usr/share/ohmydebn/config/tile-rules.json.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'nvim' -e /usr/bin/nvim
