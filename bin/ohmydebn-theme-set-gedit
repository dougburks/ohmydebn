#!/bin/bash
#
# ohmydebn-theme-set-gedit: Set gedit theme configuration
# Usage: ohmydebn-theme-set-gedit
#

set -e

# gsettings keys can be renamed/removed between gedit versions (e.g.
# "theme-variant" doesn't exist before gedit 47, so it's absent on Mint's
# 46.2) - `|| true` keeps each line's exit status 0 so a missing key is
# silently skipped instead of aborting this script under its own `set -e`,
# which would in turn abort ohmydebn-theme-set (also `set -e`) and skip
# every theming step queued after gedit (starship, cava, fastfetch and the
# rest - see ohmydebn-theme-set). This runs on every theme switch, so a warning
# here would repeat every time - not worth it for a known, permanent version
# gate that isn't actionable.

# Flip theme-variant to another value and back, which makes a running gedit
# reload its colors. Back to the value it had, not always 'light':
# install/config/gedit.sh sets 'light' once, and a user who has since chosen
# 'system' or 'dark' keeps it. No value (no such key): nothing to do.
VARIANT=$(gsettings get org.gnome.gedit.preferences.ui theme-variant 2>/dev/null || true)
if [ -n "$VARIANT" ]; then
  OTHER="'dark'"
  [ "$VARIANT" = "'dark'" ] && OTHER="'light'"
  gsettings set org.gnome.gedit.preferences.ui theme-variant "$OTHER" || true
  gsettings set org.gnome.gedit.preferences.ui theme-variant "$VARIANT" || true
fi
