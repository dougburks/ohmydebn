#!/bin/bash
#
# Installs Crush, Charm's terminal coding agent, from Charm's signed apt
# repository, which apt then keeps up to date.

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

CHARM_HOST=repo.charm.sh
CHARM_KEYRING=/usr/share/keyrings/charm-crush.gpg
CHARM_SOURCES=/etc/apt/sources.list.d/charm-crush.sources
CHARM_PREF=/etc/apt/preferences.d/charm-crush.pref

if ! dpkg -s "crush" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Crush is not currently installed."
    echo
    echo "Continuing will install it from:"
    echo "https://$CHARM_HOST/apt/"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi

  # Charm's own instructions add its repository for all of its tools (gum,
  # glow...), as charm.list. If it's already set up, Crush comes from that,
  # left as it is: a second source for the same repository makes apt warn
  # on every refresh, and the pin below would hold back the other tools.
  if grep -rqs "$CHARM_HOST" /etc/apt/sources.list /etc/apt/sources.list.d; then
    echo "Charm's package repository is already configured on this system - using it."
  else
    # The key is checked before apt trusts it (see ohmydebn-pgp-fingerprint),
    # so a key swapped in transit or on the server is refused. Charm doesn't
    # print its fingerprint anywhere; this is the key that signs the
    # repository's InRelease, served by https://repo.charm.sh/apt/gpg.key and
    # on keyserver.ubuntu.com since its creation in 2022 (checked
    # 2026-10-28). It expires 2027-07-13: a renewal keeps the fingerprint.
    KEY_URL=https://$CHARM_HOST/apt/gpg.key
    KEY_FILE=$(mktemp)
    trap 'rm -f "$KEY_FILE"' EXIT
    curl -fsSL "$KEY_URL" -o "$KEY_FILE"
    if [ "$(/usr/share/ohmydebn/bin/ohmydebn-pgp-fingerprint "$KEY_FILE" || true)" != ED927B38BE981E53CA09153D03BBF595D4DFD35C ]; then
      echo "The Charm signing key from $KEY_URL isn't the one that signs Charm's repository, so it wasn't installed."
      exit 1
    fi

    # Restricts Charm's repo to crush, written before the repo is: a bare
    # signed-by trusts the repo's key to sign anything, and the repo carries
    # all of Charm's tools. crush is a single static binary with no
    # dependencies.
    printf 'Package: *\nPin: origin "%s"\nPin-Priority: -1\n\nPackage: crush\nPin: origin "%s"\nPin-Priority: 500\n' "$CHARM_HOST" "$CHARM_HOST" |
      sudo tee "$CHARM_PREF" >/dev/null
    sudo mkdir -p /usr/share/keyrings
    sudo gpg --dearmor --yes -o "$CHARM_KEYRING" "$KEY_FILE"
    printf 'Types: deb\nURIs: https://%s/apt/\nSuites: *\nComponents: *\nSigned-By: %s\n' "$CHARM_HOST" "$CHARM_KEYRING" |
      sudo tee "$CHARM_SOURCES" >/dev/null
  fi

  # A source apt can't refresh fails every later apt update, and with it
  # every ohmydebn-update, so OhMyDebn's is taken out again, as
  # ohmydebn-google-chrome-stable-install does.
  if ! sudo /usr/bin/apt update; then
    if [ -f "$CHARM_SOURCES" ]; then
      sudo rm -f "$CHARM_SOURCES" "$CHARM_PREF" "$CHARM_KEYRING"
      echo
      echo "Couldn't refresh the package lists, so Charm's package source was removed again."
    else
      echo
      echo "Couldn't refresh the package lists."
    fi
    echo "Check the apt output above, then try again."
    exit 1
  fi
  sudo /usr/bin/apt -y install crush

  # Installed onto a system that may already have a default AI assistant:
  # ask before changing it (defaults to no, and says nothing when this is
  # already the default - see ohmydebn-ai-set-default). A setting that
  # couldn't be saved mustn't abort the install.
  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-ai-set-default --ask crush || true
  fi
fi
