#!/bin/bash

set -euo pipefail

if ! dpkg -s "helium-bin" >/dev/null 2>&1; then
  echo
  echo "Helium browser is not currently installed."
  echo
  echo "Continuing will install it from:"
  echo "https://pkg.helium.computer"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r
  sudo mkdir -p /usr/share/keyrings
  curl -fsSL https://raw.githubusercontent.com/imputnet/helium-linux/main/pubkey.asc | sudo gpg --dearmor --yes -o /usr/share/keyrings/helium.gpg
  echo "deb [signed-by=/usr/share/keyrings/helium.gpg] https://pkg.helium.computer/deb stable main" | sudo tee /etc/apt/sources.list.d/helium.list >/dev/null

  # Restricts this repo to the one package it's actually needed for - a
  # bare signed-by trusts the repo's key to sign anything, so without this
  # a compromised or malicious upstream could ship a package under some
  # other name (colliding with a real Debian package, say) and have apt
  # prefer it on some later, completely unrelated `apt install`/upgrade.
  # Pin-Priority: -1 on the wildcard blocks every package from this origin
  # by default; the second stanza re-allows just helium-bin at the normal
  # priority apt would already give it unpinned.
  printf 'Package: *\nPin: origin "pkg.helium.computer"\nPin-Priority: -1\n\nPackage: helium-bin\nPin: origin "pkg.helium.computer"\nPin-Priority: 500\n' |
    sudo tee /etc/apt/preferences.d/helium.pref >/dev/null

  # Two separate commands, not `apt update && apt install`: a failed update
  # on the left of && doesn't stop the script under set -e, so the install
  # was skipped and the rest carried on as if it had worked. And a source
  # apt can't refresh fails every later update, OhMyDebn's too - so it's
  # taken out again, as ohmydebn-cloudflare-warp-install does.
  if ! sudo /usr/bin/apt update; then
    sudo rm -f /etc/apt/sources.list.d/helium.list /etc/apt/preferences.d/helium.pref /usr/share/keyrings/helium.gpg
    echo
    echo "Couldn't refresh the package lists, so Helium's package source was removed again."
    echo "Check the apt output above, then try again."
    exit 1
  fi
  sudo /usr/bin/apt -y install helium-bin

  # Seeded only into a profile that doesn't exist yet, as the Brave
  # installers do: a purge leaves ~/.config alone, so a reinstall used to
  # overwrite the user's own Helium preferences with OhMyDebn's defaults.
  if [ ! -d ~/.config/net.imput.helium ]; then
    cp -av /usr/share/ohmydebn/config/net.imput.helium ~/.config/
  fi

  # Installed onto a system that already has a default browser: ask before
  # taking it over (defaults to no - see ohmydebn-browser-set-default). A
  # setting that couldn't be applied is reported there and mustn't abort
  # the install.
  /usr/share/ohmydebn/bin/ohmydebn-browser-set-default --ask helium-bin || true
fi
