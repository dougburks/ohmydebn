#!/bin/bash

set -euo pipefail

if dpkg -s "podman" >/dev/null 2>&1; then
  echo
  echo "Podman is already installed."
else
  echo
  echo "Podman is not currently installed."
  echo
  echo "Continuing will install it from the standard Debian repos."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."

  read input

  # Install packages
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install podman

  # Output message to user
  cat <<EOF

================================================================================

Podman is now installed.

EOF
fi
