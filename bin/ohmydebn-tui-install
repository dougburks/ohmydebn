#!/bin/bash

# Usage: ohmydebn-tui-install <name> <exec-command> <icon-url>
# The older four-argument form, <name> <exec-command> <window-style>
# <icon-url>, still works: the window style (float/tile, from Omarchy) is
# ignored. It picked a TUI.float or TUI.tile window class that no tile
# rule ever used, so it never changed anything here.
if [ "$#" -eq 3 ] || [ "$#" -eq 4 ]; then
  APP_NAME="$1"
  APP_EXEC="$2"
  ICON_URL="${!#}"
else
  if ! command -v gum >/dev/null 2>&1; then
    echo "Usage: ohmydebn-tui-install <name> <exec-command> <icon-url>" >&2
    exit 1
  fi

  echo -e "\e[32mLet's create a TUI shortcut you can start with the app launcher.\n\e[0m"
  APP_NAME=$(gum input --prompt "Name> " --placeholder "My TUI")
  APP_EXEC=$(gum input --prompt "Launch Command> " --placeholder "lazydocker or bash -c 'dust; read -n 1 -s'")
  ICON_URL=$(gum input --prompt "Icon URL> " --placeholder "See https://dashboardicons.com (must use PNG!)")
fi

if [[ -z "$APP_NAME" || -z "$APP_EXEC" || -z "$ICON_URL" ]]; then
  echo "You must set app name, app command, and icon URL!"
  exit 1
fi

if [[ "$APP_NAME" == */* ]]; then
  echo "App name must not contain '/'."
  exit 1
fi

# The same guards as ohmydebn-webapp-install: the name and command are
# written into a desktop file, where a newline would let an extra key
# (a second Exec=) in, and the icon URL goes to curl, which would read a
# leading '-' as an option.
if [[ "$APP_NAME" == *$'\n'* || "$APP_NAME" == *$'\r'* || "$APP_EXEC" == *$'\n'* || "$APP_EXEC" == *$'\r'* ]]; then
  echo "App name and command must not contain newlines."
  exit 1
fi
if [[ "$ICON_URL" == -* || "$ICON_URL" == *$'\n'* || "$ICON_URL" == *$'\r'* ]]; then
  echo "Icon URL must not start with '-' or contain newlines."
  exit 1
fi

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

mkdir -p "$ICON_DIR"

# -f: an error page (a 404, say) is a failure, not an icon.
if ! curl -fsSL -o "$ICON_PATH" -- "$ICON_URL"; then
  echo "Error: Failed to download icon."
  exit 1
fi

# The title is one quoted Exec argument, escaped as the desktop entry spec
# says (see ohmydebn-webapp-install), so a " in the name can't end it
# early. The command is the user's own command line, which they may quote
# themselves, so it stays as typed - only the key file's backslash escaping
# and %% for a literal % (a lone % starts a field code) are applied.
desktop_exec_arg() {
  local arg="$1"
  arg=${arg//\\/\\\\}
  arg=${arg//\"/\\\"}
  arg=${arg//\`/\\\`}
  arg=${arg//\$/\\\$}
  arg=${arg//\\/\\\\}
  arg=${arg//%/%%}
  printf '"%s"' "$arg"
}
EXEC_COMMAND=${APP_EXEC//\\/\\\\}
EXEC_COMMAND=${EXEC_COMMAND//%/%%}

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=/usr/share/ohmydebn/bin/ohmydebn-terminal --class TUI --title $(desktop_exec_arg "$APP_NAME") -e $EXEC_COMMAND
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"

# Only when asked interactively, like ohmydebn-webapp-install: with the
# details given as arguments (3, or the older 4), the caller is a script.
if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + R)\n"
fi
