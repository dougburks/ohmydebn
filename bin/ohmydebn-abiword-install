#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "abiword" >/dev/null 2>&1; then
  # Not every supported distro has it (see ohmydebn-pkg-available).
  /usr/share/ohmydebn/bin/ohmydebn-pkg-available abiword "AbiWord" || exit 1

  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "AbiWord is not currently installed."
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install abiword
fi
