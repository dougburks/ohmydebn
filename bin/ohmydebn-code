#!/bin/bash

set -euo pipefail

if ! dpkg -s "code" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation /usr/share/ohmydebn/bin/ohmydebn-code-install
fi

if dpkg -s "code" >/dev/null 2>&1; then
  # "$@" lets ohmydebn-ai-cli pass a directory to open (e.g. $PWD) while
  # every other caller (menu picks, ohmydebn-ai) still runs with no args.
  /usr/bin/code "$@"
fi
