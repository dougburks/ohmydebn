#!/bin/bash

set -euo pipefail

if ! dpkg -s "simplescreenrecorder" >/dev/null 2>&1; then
  echo
  echo "simplescreenrecorder is not currently installed."
else
  if [ $# -eq 0 ]; then
    echo
    echo "Continuing will remove simplescreenrecorder."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y purge simplescreenrecorder
  sudo /usr/bin/apt -y autoremove
fi
