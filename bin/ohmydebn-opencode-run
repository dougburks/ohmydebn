#!/bin/bash
#
# The install-if-needed-then-run payload for OpenCode, meant to run
# inside an already-open terminal (via -e) rather than opening one of its
# own - see ohmydebn-opencode, which wraps this in a terminal instead of
# duplicating it.

set -euo pipefail

if ! dpkg -s "ohmydebn-opencode-cli" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-show-logo
  # A failed install would otherwise end the script here (set -e) and close
  # the terminal before its error could be read.
  if ! /usr/share/ohmydebn/bin/ohmydebn-opencode-install; then
    echo
    echo "The install didn't finish - see the messages above."
    /usr/share/ohmydebn/bin/ohmydebn-show-done
    exit 1
  fi
  /usr/share/ohmydebn/bin/ohmydebn-show-done
fi
if dpkg -s "ohmydebn-opencode-cli" >/dev/null 2>&1; then
  mkdir -p ~/opencode-sessions && cd "$(mktemp -d ~/opencode-sessions/session-XXXXXX)"
  # A starting prompt (from ohmydebn-ai: the AI button's Make a theme,
  # Make an app and Fix my desktop) opens the session with it as the
  # first message.
  if [ -n "${1:-}" ]; then
    exec /usr/bin/opencode-cli --prompt "$1"
  fi
  exec /usr/bin/opencode-cli
fi
