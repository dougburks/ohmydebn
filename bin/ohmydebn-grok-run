#!/bin/bash
#
# Runs Grok Build in a fresh ~/grok-sessions directory (like Codex's and
# Pi's runners), installing it first if needed. The package installs no
# /usr/bin symlink, only /usr/lib/ohmydebn-grok-build/grok. apt updates it,
# so its own self-updater is switched off.

set -euo pipefail

if ! dpkg -s "ohmydebn-grok-build" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-show-logo
  /usr/share/ohmydebn/bin/ohmydebn-grok-install
  /usr/share/ohmydebn/bin/ohmydebn-show-done
fi

if dpkg -s "ohmydebn-grok-build" >/dev/null 2>&1; then
  mkdir -p ~/grok-sessions && cd "$(mktemp -d ~/grok-sessions/session-XXXXXX)"
  export GROK_DISABLE_AUTOUPDATER=1
  exec /usr/lib/ohmydebn-grok-build/grok
fi
