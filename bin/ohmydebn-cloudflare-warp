#!/bin/bash

set -euo pipefail

# Without systemd its service never runs (see ohmydebn-require-systemd),
# so the installer's window opens to say why, even when it's installed,
# rather than an app that only says "Unable to connect".
SYSTEMD_DIR=/run/systemd/system
if [ ! -d "$SYSTEMD_DIR" ] || ! dpkg -s "cloudflare-warp" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Cloudflare WARP" /usr/share/ohmydebn/bin/ohmydebn-cloudflare-warp-install
fi

if [ -d "$SYSTEMD_DIR" ] && dpkg -s "cloudflare-warp" >/dev/null 2>&1; then
  /bin/warp-taskbar
fi
