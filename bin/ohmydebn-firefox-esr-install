#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

# firefox-esr is Debian's (and Kali's) Firefox - the one the base ISO
# ships and --power-user removes (bin/ohmydebn-pkg-remove-all-optional),
# so this is mostly "put it back". Ubuntu (a snap), Mint and Pop!_OS
# (their own debs) package Firefox as "firefox" instead, which this entry
# doesn't handle yet (see TODO.md), so there it says so and points to
# Install > Package rather than running apt into "Unable to locate
# package".
if ! dpkg -s "firefox-esr" >/dev/null 2>&1; then
  if ! /usr/share/ohmydebn/bin/ohmydebn-pkg-available firefox-esr "Firefox"; then
    echo
    echo "To install your distribution's own Firefox instead, choose Install > Package"
    echo "in the OhMyDebn menu and pick firefox."
    exit 1
  fi

  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Firefox is not currently installed."
    echo
    echo "Continuing will install it from your distribution's repositories."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install firefox-esr

  # Installed onto a system that already has a default browser: ask before
  # taking it over (defaults to no - see ohmydebn-browser-set-default). A
  # setting that couldn't be applied is reported there and mustn't abort
  # the install.
  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-browser-set-default --ask firefox-esr || true
  fi
fi
