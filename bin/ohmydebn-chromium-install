#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

# Ubuntu carries no "chromium" apt package at all (unlike Debian/Kali/Mint) -
# it only ships "chromium-browser", a transitional package whose postinst
# installs the real thing as a strictly-confined snap. install/config/
# chromium.sh (sourced below) accounts for the snap's different profile
# layout when seeding the bundled extension.
#
# Which one applies is asked of apt rather than guessed from the distro
# name, so Ubuntu derivatives get it right too: most have no "chromium"
# package either, but Mint (ID_LIKE=ubuntu) ships a real Chromium deb and
# blocks snapd, and some derivatives package their own.
CHROMIUM_PACKAGE=chromium
if ! apt-cache policy chromium 2>/dev/null | grep -qE '^[[:space:]]*Candidate: [^(]'; then
  CHROMIUM_PACKAGE=chromium-browser
fi

if ! dpkg -s "$CHROMIUM_PACKAGE" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Chromium is not currently installed."
    echo
    echo "Continuing will install it from your distribution's repositories."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  # --no-install-recommends, as when Chromium was part of the default
  # install (via ohmydebn-pkg-install-optional): its one Recommends,
  # chromium-sandbox, isn't needed on a kernel with user namespaces.
  sudo /usr/bin/apt -y --no-install-recommends install "$CHROMIUM_PACKAGE"

  # Installed by hand, from the menu, onto a system that already has a
  # default browser: ask before taking it over (defaults to no - see
  # ohmydebn-browser-set-default). A setting that couldn't be applied is
  # reported there and mustn't abort the rest of this install. Not under
  # --skip-prompt, where a new install's own default-browser step
  # (install/config/mimetypes.sh) has this covered.
  if [ "$SKIP_PROMPT" = false ]; then
    /usr/share/ohmydebn/bin/ohmydebn-browser-set-default --ask chromium || true
  fi
fi

# uBlock Origin Lite for a profile that doesn't exist yet - the same step
# the install layer applies (and a no-op for an existing profile).
source /usr/share/ohmydebn/install/config/chromium.sh
