#!/bin/bash
#
# Neovim tiled to the right half with gaps immediately after launch, via
# ohmydebn-terminal-tiled's own OHMYDEBN_TILE_GRID override - the same
# TileFocusedWindow grid ("2 2 1 0 1 2") as the "Tile with gaps 6 right
# half" keybinding. Bound to Super+N in keybinding-custom.txt in place of
# a bare ohmydebn-terminal call. Right half (not left) because the left
# half is reserved for the persistently-open terminal - see
# ohmydebn-terminal-left-tiled.

set -euo pipefail

export OHMYDEBN_TILE_GRID="2 2 1 0 1 2"
exec /usr/share/ohmydebn/bin/ohmydebn-terminal-tiled --title 'nvim' -e /usr/bin/nvim
