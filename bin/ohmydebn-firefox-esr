#!/bin/bash

set -euo pipefail

# Whichever Firefox is installed: Debian's firefox-esr, the distro's own
# "firefox" deb (Linux Mint, Pop!_OS), or Ubuntu's snap (installed by its
# "firefox" stub package, like Chromium's - see ohmydebn-chromium). With
# none, the installer runs, which picks the one this distro has. Which one
# is decided before Firefox runs, never from how Firefox exits: a Firefox
# that crashed used to read as "not installed" and opened the installer.
firefox_binary() {
  if dpkg -s "firefox-esr" >/dev/null 2>&1; then
    echo /usr/bin/firefox-esr
  elif snap list firefox >/dev/null 2>&1; then
    echo /snap/bin/firefox
  elif dpkg -s "firefox" >/dev/null 2>&1; then
    echo /usr/bin/firefox
  else
    return 1
  fi
}

if ! FIREFOX=$(firefox_binary); then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Firefox" /usr/share/ohmydebn/bin/ohmydebn-firefox-esr-install
  FIREFOX=$(firefox_binary) || exit 0
fi
exec "$FIREFOX"
