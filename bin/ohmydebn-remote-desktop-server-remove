#!/bin/bash

set -euo pipefail

# Same paths as ohmydebn-remote-desktop-server-install, variables for the tests.
SYSTEMD_DIR=/run/systemd/system
XSESSION_D=/etc/X11/Xsession.d

if ! dpkg -s "xrdp" >/dev/null 2>&1; then
  echo
  echo "Remote Desktop (XRDP) is not currently installed."
else
  if [ "${1:-}" != "--skip-prompt" ]; then
    echo
    echo "Continuing will remove XRDP and the session guard OhMyDebn installed for it."
    echo "Firewall rules you added for port 3389 are left as they are."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi

  sudo rm -f "$XSESSION_D/45ohmydebn-xrdp-session-guard"

  if [ -d "$SYSTEMD_DIR" ]; then
    sudo systemctl disable --now xrdp xrdp-sesman || true
  else
    sudo service xrdp stop || true
  fi
  sudo /usr/bin/apt -y purge xrdp xorgxrdp
  sudo /usr/bin/apt -y autoremove

  # The xrdp user (and with it its ssl-cert membership) went with the purge.
  if command -v ufw >/dev/null 2>&1; then
    echo
    echo "Any firewall rule you added for port 3389 is still in place - to remove it:"
    echo "  sudo ufw status numbered   (find the rule's number)"
    echo "  sudo ufw delete <number>"
  fi
fi
