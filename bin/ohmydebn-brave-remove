#!/bin/bash

set -euo pipefail

if ! dpkg -s "brave-browser" >/dev/null 2>&1; then
  echo
  echo "Brave browser is not currently installed."
else
  echo
  echo "Continuing will remove Brave browser and its repo."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read input
  sudo rm -f /usr/share/keyrings/brave-browser-archive-keyring.gpg
  sudo rm -f /etc/apt/sources.list.d/brave-browser-release.sources
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y purge brave-browser
  sudo /usr/bin/apt -y autoremove
fi
