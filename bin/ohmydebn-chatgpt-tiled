#!/bin/bash
#
# ChatGPT tiled to the right half with gaps immediately after launch,
# via the shared ohmydebn-launch-tiled helper - the same
# TileFocusedWindow grid ("2 2 1 0 1 2") as the "Tile with gaps 6 right
# half" keybinding. Bound to the AI submenu's ChatGPT entry in
# bin/ohmydebn-menu in place of a bare call to ohmydebn-chatgpt - there's
# no dedicated hotkey for ChatGPT specifically (only reachable through
# the menu, or via ohmydebn-ai-tiled/Super+A when it's the chosen
# default). Right half (not left) because the left half is reserved for
# the persistently-open terminal - see ohmydebn-terminal-left-tiled.
#
# Unlike cliamp/socrates/claude-code/opencode/pi, ohmydebn-chatgpt can't
# be collapsed into a single terminal window: it launches /usr/bin/chatgpt,
# a native GUI binary, as its second phase rather than running inside a
# terminal, so a cold install still shows a floating install-
# presentation terminal first, then a completely separate ChatGPT window
# once installation finishes - see ohmydebn-launch-tiled's own comment
# on OHMYDEBN_LAUNCH_TILED_WATCH_SECOND for why that second window needs
# this to get tiled too.

set -euo pipefail

export OHMYDEBN_LAUNCH_TILED_WATCH_SECOND=1
exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 1 0 1 2 -- /usr/share/ohmydebn/bin/ohmydebn-chatgpt
