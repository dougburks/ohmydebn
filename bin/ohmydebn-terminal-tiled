#!/bin/bash
#
# An Alacritty window tiled full-screen-with-gaps as it opens, through
# gTile's TileNextWindow (see ohmydebn-gtile-tile-next), so a fresh
# window already looks like you'd just re-tiled it that way yourself, and
# never shows at its untiled position first. Used by ohmydebn-demo-gui,
# and by ohmydebn-terminal-left (when gTile's tiling-mode is "rules");
# not folded into ohmydebn-terminal itself - that script is shared by
# every OTHER caller (menu-launched terminals, the floating-terminal
# wrappers), none of which want this. Most of the apps that used to come
# here through an OHMYDEBN_TILE_GRID wrapper (btop, fastfetch, cava, nvim,
# the logo, the update GUI) are placed by gTile's own rule-based tiling
# now instead (see config/tile-rules.json). "$@" passes straight through
# to alacritty, same contract as ohmydebn-terminal itself.
#
# OHMYDEBN_TILE_GRID overrides the default full-screen grid with any
# other gTile grid - e.g. ohmydebn-terminal-left sets it to the left-half
# grid instead.

set -euo pipefail

GRID="${OHMYDEBN_TILE_GRID:-2 2 0 0 2 2}"

# GRID is deliberately unquoted: it's 6 space-separated positional gTile
# args, not a single token.
# shellcheck disable=SC2086
/usr/share/ohmydebn/bin/ohmydebn-gtile-tile-next $GRID || true

# Waits for the terminal to close so callers can depend on completion,
# matching ohmydebn-terminal's own contract.
exec /usr/share/ohmydebn/bin/ohmydebn-alacritty "$@"
