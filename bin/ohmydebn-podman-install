#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if dpkg -s "podman" >/dev/null 2>&1; then
  echo
  echo "Podman is already installed."
else
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Podman is not currently installed."
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  # Install packages
  sudo /usr/bin/apt update
  # uidmap is only a Recommends of podman, but rootless podman can't set
  # up its user namespace without newuidmap/newgidmap - name it outright
  # so a system with recommends turned off still gets it.
  sudo /usr/bin/apt -y install podman uidmap

  # Output message to user
  cat <<EOF

================================================================================

Podman is now installed.

EOF
fi

# Installing podman doesn't give the user the subordinate UID/GID ranges
# rootless mode needs - Debian only writes those at account creation, and
# not always then (see the script). Runs on the already-installed path too
# since it's a no-op once the ranges exist.
/usr/share/ohmydebn/bin/ohmydebn-podman-subids-ensure
