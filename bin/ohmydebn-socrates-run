#!/bin/bash

mkdir -p ~/socrates-data
/usr/bin/podman run \
  --userns=keep-id \
  --user $(id -u):$(id -g) \
  -v ~/socrates-data:/data \
  -p 8000:8000 \
  ghcr.io/dougburks/so-crates@sha256:3e5f87a205e78481584ab0d3158529540e43b3bf1b05b8bf2012b86b559f2496

exit_code=$?
# exit_code 0 is a clean exit and 130 is the user pressing Ctrl-C
if [ $exit_code -ne 0 ] && [ $exit_code -ne 130 ]; then
  echo
  echo "Review the output above for errors."
  echo
  echo "Press Enter to close this window."
  read input
fi
