#!/bin/bash

set -euo pipefail

# Usage: ohmydebn-pkg-remove-all-optional [--skip-prompt] [--distro-apps-only] [--list]
#   --distro-apps-only  remove only apps a base distro ships (DISTRO_APPS
#                       below), never ones installed from the OhMyDebn menu
#   --list              print the installed apps it would remove, change nothing
#
# The power-user profile (install/packaging/power-user.sh) is the only
# caller. On a fresh `install.sh --power-user` nothing has been installed
# from the OhMyDebn menu yet, so the full removal only meets what the
# distro shipped. Run later (ohmydebn-power-user-install, on an existing
# install) the full removal also purged every AI tool, VPN, browser and
# editor the user had chosen from the menu - so that path uses
# --distro-apps-only, and lists what it will remove before asking.
SKIP_PROMPT=false
DISTRO_ONLY=false
LIST_ONLY=false
for ARG in "$@"; do
  case "$ARG" in
  --skip-prompt) SKIP_PROMPT=true ;;
  --distro-apps-only) DISTRO_ONLY=true ;;
  --list) LIST_ONLY=true ;;
  esac
done

if [ "$SKIP_PROMPT" = false ] && [ "$LIST_ONLY" = false ]; then
  echo "Continuing will remove all optional packages."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r
fi

# dpkg -l (unlike dpkg -s) supports glob patterns like "firefox*", so it
# works for both exact package names and the wildcard entries below.
# Output is captured into a variable rather than piped straight into
# grep -q: packages with many matches (libreoffice's dozens of sub-packages
# and locale variants) can make grep -q exit as soon as it finds a match;
# under `set -o pipefail` that early exit sends dpkg a SIGPIPE before it's
# finished writing, which pipefail then reports as the pipeline failing
# even though grep did find what it was looking for.
pkg_glob_installed() {
  local dpkg_list
  dpkg_list=$(dpkg -l "$1" 2>/dev/null || true)
  grep -q '^ii' <<<"$dpkg_list"
}

# Kali doesn't ship an alternative browser out of the box the way the
# Debian Cinnamon ISO does, and removing its Firefox (Kali's default and
# only preinstalled browser) leaves the desktop without one - so leave
# Firefox alone there. OHMYDEBN_TEST_OS_RELEASE lets tests point this at a
# fake os-release file instead of the real /etc/os-release.
KALI=false
OS_RELEASE="${OHMYDEBN_TEST_OS_RELEASE:-/etc/os-release}"
if [ -f "$OS_RELEASE" ]; then
  # shellcheck disable=SC1090
  . "$OS_RELEASE"
  [ "${ID:-}" = "kali" ] && KALI=true
fi

# Batch every purge into a single `apt purge` call instead of one per
# package/pattern - each individual `apt purge` pays dpkg's trigger-
# processing cost (mandb, icon caches, desktop/mime databases) on its own,
# and with Firefox/LibreOffice/etc. from the base Debian 13 Cinnamon ISO
# usually installed, that cost was being paid dozens of times over.
#
# DISTRO_APPS are apps a base distro ships (some of which the OhMyDebn menu
# also offers, like Firefox and LibreOffice). OHMYDEBN_APPS only ever come
# from the OhMyDebn menu, so they're skipped with --distro-apps-only.
# Neither list has Podman, rclone or Virtual Machine Manager: the power-user
# profile installs those right after this, and purging them first only
# deleted their system config for nothing.
DISTRO_APPS=(abiword brasero calligra deja-dup duplicity gnome-calculator gnome-chess gnome-games gnumeric
  goldendict-ng hexchat hoichess "libreoffice*" pidgin remmina tcpdump thunderbird "transmission*" tshark
  wireshark x11vnc)
OHMYDEBN_APPS=(cliamp distrobox docker.io emacs gnome-boxes localsend ohmydebn-opencode-cli uxplay velo)
CANDIDATES=("${DISTRO_APPS[@]}")
[ "$DISTRO_ONLY" = false ] && CANDIDATES+=("${OHMYDEBN_APPS[@]}")

TO_PURGE=()
for PACKAGE in "${CANDIDATES[@]}"; do
  if pkg_glob_installed "$PACKAGE"; then
    TO_PURGE+=("$PACKAGE")
  fi
done

if [ "$KALI" = false ] && pkg_glob_installed "firefox*"; then
  TO_PURGE+=("firefox*")
fi

# Apps with their own dedicated ohmydebn-<name>-remove script for
# repo/keyring/config cleanup beyond a plain apt purge, as "package
# script-name" pairs. All of them only ever come from the OhMyDebn menu.
# Not brave-origin: it's the default browser (install/packaging/browser.sh),
# not an optional app, so it stays for the same reason Chromium never
# appeared here when it was the default - and the power-user flow, which
# runs this first, would otherwise purge it only for its own
# ohmydebn-brave-origin-install to put it straight back a moment later.
DEDICATED=("antigravity antigravity" "brave-browser brave-browser" "chatgpt chatgpt"
  "claude-code claude-code" "claude-desktop claude-desktop" "cloudflare-warp cloudflare-warp" "code code"
  "google-chrome-stable google-chrome-stable" "helium-bin helium-bin" "powershell powershell"
  "simplescreenrecorder simplescreenrecorder" "tailscale tailscale"
  "ohmydebn-pi-coding-agent pi" "ohmydebn-codex-cli codex" "ohmydebn-t3code t3code"
  "ohmydebn-grok-build grok" "ohmydebn-oh-my-pi omp" "crush crush")
TO_REMOVE=()
if [ "$DISTRO_ONLY" = false ]; then
  for PAIR in "${DEDICATED[@]}"; do
    read -r PACKAGE NAME <<<"$PAIR"
    if dpkg -s "$PACKAGE" >/dev/null 2>&1; then
      TO_REMOVE+=("$NAME")
    fi
  done
fi

if [ "$LIST_ONLY" = true ]; then
  for PACKAGE in "${TO_PURGE[@]}"; do
    echo "${PACKAGE%\*}"
  done
  for NAME in "${TO_REMOVE[@]}"; do
    echo "$NAME"
  done
  exit 0
fi

if [[ ${#TO_PURGE[@]} -gt 0 ]] && ! sudo /usr/bin/apt -y purge "${TO_PURGE[@]}"; then
  # Something in the batch failed (e.g. a conflict between two packages);
  # fall back to purging one at a time so a single bad interaction doesn't
  # block the rest of the batch.
  for PACKAGE in "${TO_PURGE[@]}"; do
    if pkg_glob_installed "$PACKAGE"; then
      sudo /usr/bin/apt -y purge "$PACKAGE" || echo "ohmydebn: failed to purge '$PACKAGE', skipping." >&2
    fi
  done
fi

sudo /usr/bin/apt -y autoremove

for NAME in "${TO_REMOVE[@]}"; do
  "/usr/share/ohmydebn/bin/ohmydebn-${NAME}-remove" --skip-prompt
done
