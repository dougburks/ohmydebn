#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

# Debian packages the docker command apart from the daemon, as docker-cli,
# which docker.io only recommends: with recommends off (MX Linux) the
# daemon came alone, with no command to use it. Ubuntu's docker.io has the
# command itself, at the same path, and there's no docker-cli package. An
# install missing the command isn't done, so this finishes it.
if dpkg -s "docker.io" >/dev/null 2>&1 && [ -x /usr/bin/docker ]; then
  echo
  echo "Docker is already installed."
else
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    if dpkg -s "docker.io" >/dev/null 2>&1; then
      echo "Docker is installed, but without its docker command."
    else
      echo "Docker is not currently installed."
    fi
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  # Install packages
  sudo /usr/bin/apt update
  PACKAGES=(docker.io)
  if apt-cache show docker-cli >/dev/null 2>&1; then
    PACKAGES+=(docker-cli)
  fi
  sudo /usr/bin/apt -y install "${PACKAGES[@]}"

  # Output message to user
  cat <<EOF

================================================================================

Docker is now installed.

Your user has NOT been added to the docker group. Membership in that group is
effectively passwordless root: anything running as you (a rogue script, a
poisoned dependency) could run 'docker run -v /:/host' and rewrite the host
as root, with no password prompt. Use 'sudo docker ...' instead.

If you understand the risk and want the convenience of running docker without
sudo, add yourself to the group with:

  sudo usermod -aG docker "\$USER"

then log out and back in.

EOF
fi
