#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

# Check to see if new package is installed
NEWLY_INSTALLED=false
if ! dpkg -s "ohmydebn-opencode-cli" >/dev/null 2>&1; then
  NEWLY_INSTALLED=true
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "The ohmydebn-opencode-cli package is not currently installed."
    echo
    echo "Continuing will install this package which was built from:"
    echo "https://github.com/anomalyco/opencode"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
fi

# Set autoupdate to false
OPENCODE_CONFIG="$HOME/.config/opencode/opencode.json"
OPENCODE_CONFIG_BACKUP="$HOME/.config/opencode/opencode.json.before.disabling.autoupdate"
if [ -f "$OPENCODE_CONFIG" ] && [ ! -f "$OPENCODE_CONFIG_BACKUP" ] && command -v jq >/dev/null 2>&1; then
  cp "$OPENCODE_CONFIG" "$OPENCODE_CONFIG_BACKUP"
  jq '.autoupdate = false' "$OPENCODE_CONFIG" >"${OPENCODE_CONFIG}.tmp" && mv "${OPENCODE_CONFIG}.tmp" "$OPENCODE_CONFIG"
fi

# Install the package. This runs standalone, on-demand (via
# ohmydebn-opencode-run when Super+A's default AI assistant is opencode
# and it isn't installed yet), independent of install.sh/ohmydebn-update's
# own flow - a stale apt index here isn't hypothetical, it's a real
# reported failure ("apt install ohmydebn-opencode-cli" failing until a
# manual "apt update") on a box where this had gone a while since the last
# ohmydebn-update. See ohmydebn-gestures-install's own comment for the
# general reasoning.
sudo /usr/bin/apt update
sudo /usr/bin/apt -y install ohmydebn-opencode-cli

# Freshly installed onto a system that may already have a default AI
# assistant: ask before changing it (defaults to no, and says nothing when
# OpenCode is already the default - see ohmydebn-ai-set-default). A setting
# that couldn't be saved mustn't abort the install.
if [ "$NEWLY_INSTALLED" = true ] && [ "$SKIP_PROMPT" = false ]; then
  /usr/share/ohmydebn/bin/ohmydebn-ai-set-default --ask opencode || true
fi
