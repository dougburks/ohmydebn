#!/bin/bash

set -e

# Resets OhMyDebn's app config files to their defaults, keeping the current
# ones as backups. Only these files: it used to delete every OhMyDebn state
# marker and rerun the whole setup as a new install, which also replaced
# the panel layout, switched off other Cinnamon extensions, reset
# keybindings, theme, cursor and sounds, turned the firewall back on,
# rewrote git aliases, and changed the default browser and terminal - far
# more than "reset your config files to OhMyDebn defaults". Not Aether's:
# OhMyDebn has no default config for it, so a reset only moved the user's
# Aether folder (with their themes in progress) aside. ~/.oh-my-zsh holds
# the user's own Oh My Zsh plugins and themes (custom/); Oh My Zsh itself
# comes from the ohmydebn-ohmyzsh package, which a reset leaves alone (on
# installs from before 4.14.0 the folder also holds the old downloaded
# copy, which the reset clears away with it).
CONFIGS=(~/.config/alacritty ~/.config/bat ~/.config/btop ~/.config/cava ~/.config/nvim
  ~/.config/starship.toml ~/.oh-my-zsh ~/.zshrc)

# The state markers of the install steps that write those configs, cleared
# so the steps write them again: bat.sh and btop.sh copy their configs only
# once; zsh.sh writes .zshrc and then adds its own lines to it (grc, man
# colors, the AI tool aliases); nvim.sh adds its transparency file and its
# own settings files to a config once each; ohmydebn-theme-set-starship writes the Starship config once, when
# the theme is reapplied below (missing its marker here left Starship on
# its built-in prompt after a reset). Alacritty, cava and Neovim's base
# config are recreated whenever they're missing.
# tests/unit/test-reset-config.sh checks that every marker those steps and
# the theme hooks use is listed here.
CONFIG_MARKERS=(bat-20251110 btop-config-20250916 starship-20251109 starship-logo-20261018
  zshrc-20260116 grc color-man pi-alias codex-alias grok-alias omp-alias opencode-cli-alias claude-alias ai-cli-alias prompt-speed-20261018
  nvim-transparency-20260308 nvim-relativenumber-20260929 nvim-plugins-20260926
  nvim-lazyvim-json-20261027 nvim-scrolling-off-20261027 nvim-dashboard-statusline-20261027
  nvim-all-themes-20261027 nvim-theme-hotreload-20261027)

echo "WARNING!"
echo "Continuing will reset these config files to OhMyDebn defaults:"
echo "Alacritty, bat, btop, cava, Neovim, Starship, your own Oh My Zsh plugins and themes, and ~/.zshrc."
echo "Your current ones are kept as backups (renamed to <name>-backup-<date and time>)."
echo "Your desktop, panel, keybindings, theme and default apps are not changed."
echo
echo "Press Enter to continue or Ctrl-C to cancel."
read -r

# Backup existing config files
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
for i in "${CONFIGS[@]}"; do
  if [ -e "$i" ]; then
    echo "Renaming $i to $i-backup-$TIMESTAMP"
    mv "$i" "$i-backup-$TIMESTAMP"
  fi
done

for MARKER in "${CONFIG_MARKERS[@]}"; do
  rm -f ~/.local/state/ohmydebn-config/"$MARKER"
done

# Write new config files. Run the way install.sh runs it: with errexit (a
# failed step stops the reset rather than being skipped, leaving it half
# done) and with OhMyDebn's bin directory on PATH. Every other step finds
# its marker and changes nothing, as on an update - except the full system
# upgrade at the end, which an update does every time: OHMYDEBN_SKIP_UPGRADE
# leaves it out (install.sh --skip-upgrade's switch), since a reset of
# config files must not also upgrade the system, or fail when offline.
# OHMYDEBN_RESET makes the final steps say nothing about skipped upgrades,
# an "update complete" or a reboot an earlier update needed.
RESET_STATUS=0
OHMYDEBN_RESET=1 OHMYDEBN_SKIP_UPGRADE=1 PATH="/usr/share/ohmydebn/bin:$PATH" \
  bash -e /usr/share/ohmydebn/ohmydebn.sh || RESET_STATUS=$?

if [ "$RESET_STATUS" -ne 0 ]; then
  exit "$RESET_STATUS"
fi

# Reapply the current theme (keeping the background) so the files it
# generates - the Starship config, and the theme pieces of the others -
# are written for the fresh configs.
THEME_NAME=$(cat ~/.config/ohmydebn/current/theme.name 2>/dev/null || true)
if [ -n "$THEME_NAME" ]; then
  /usr/share/ohmydebn/bin/ohmydebn-theme-set --keep-background "$THEME_NAME"
fi

echo
/usr/share/ohmydebn/bin/ohmydebn-headline "OhMyDebn config reset complete"
