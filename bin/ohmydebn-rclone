#!/bin/bash

set -euo pipefail

if ! dpkg -s "rclone" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "rclone" /usr/share/ohmydebn/bin/ohmydebn-rclone-install
fi

if dpkg -s "rclone" >/dev/null 2>&1; then
  # rclone has no GUI, so "launching" it means opening a terminal already
  # running --help - a starting point for whatever remote/subcommand the
  # user actually needs - then dropping into an interactive shell in that
  # same window so they can act on it immediately instead of the terminal
  # just closing again.
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal "rclone" "rclone --help; exec bash"
fi
