#!/bin/bash

# Rootless podman can't unpack the image without subordinate UID/GID
# ranges for this user, and some installs (Devuan's, for one) leave them
# out - backfill before the pull rather than let it fail on /etc/gshadow.
/usr/share/ohmydebn/bin/ohmydebn-podman-subids-ensure

mkdir -p ~/socrates-data

IMAGE_REPO="ghcr.io/dougburks/so-crates"
DEFAULT_IMAGE="$IMAGE_REPO@sha256:008e9cb64985da47106072c8bf4eedaf1ec8f6c0746143fbfc7442cd791dab36"

if [[ -n "$1" ]]; then
  IMAGE="$IMAGE_REPO:$1"
else
  IMAGE="$DEFAULT_IMAGE"
fi

OHMYDEBN_CURRENT_DIR="$HOME/.config/ohmydebn/current"

PODMAN_ARGS=(
  run
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  -v ~/socrates-data:/data
  # This computer only: SO-CRATES shows the packet captures it's given, and
  # nothing else on the network needs to reach it, firewall or not.
  # Listening on 127.0.0.1 alone also keeps "localhost" working where it
  # resolves to ::1 first (most Debian-family systems): with nothing
  # listening on ::1 the browser is refused at once and falls back to
  # 127.0.0.1. With -p 8000:8000, pasta accepted on ::1 and the connection
  # hung, since the server listens only on IPv4 - which releases before
  # 4.9.0 worked around by setting pasta_options = ["-4"] in the user's
  # containers.conf, turning off IPv6 in every rootless container they
  # run. That line is no longer written; one already there is left alone.
  -p 127.0.0.1:8000:8000
)

# Best-effort: only mount if OhMyDebn has ever set a theme.
if [[ -d "$OHMYDEBN_CURRENT_DIR" ]]; then
  PODMAN_ARGS+=(
    -v "$OHMYDEBN_CURRENT_DIR:/run/ohmydebn/current:ro"
    -e OHMYDEBN_THEME_DIR=/run/ohmydebn
  )
fi

/usr/bin/podman "${PODMAN_ARGS[@]}" \
  "$IMAGE"

echo
/usr/share/ohmydebn/bin/ohmydebn-socrates-cleanup
echo
echo "Press Enter to close this window."
read -r
