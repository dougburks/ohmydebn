#!/bin/bash

set -euo pipefail

if ! dpkg -s "libreoffice" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "LibreOffice" /usr/share/ohmydebn/bin/ohmydebn-libreoffice-install
fi

if dpkg -s "libreoffice" >/dev/null 2>&1; then
  /usr/bin/libreoffice
fi
