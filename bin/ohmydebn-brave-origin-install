#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "brave-origin" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Brave Origin is not currently installed."
    echo
    echo "Continuing will install it from:"
    echo "https://brave-browser-apt-release.s3.brave.com"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo mkdir -p /usr/share/keyrings
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  sudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources

  # Restricts this repo to the packages it's actually needed for (both
  # brave variants share it - see ohmydebn-brave-browser-install, which
  # writes this same file) - a bare signed-by trusts the repo's key to
  # sign anything, so without this a compromised or malicious upstream
  # could ship a package under some other name (colliding with a real
  # Debian package, say) and have apt prefer it on some later, completely
  # unrelated `apt install`/upgrade. Pin-Priority: -1 on the wildcard
  # blocks every package from this origin by default; the second stanza
  # re-allows just these at the normal priority apt would already give
  # them unpinned. brave-keyring is a hard Depends of both
  # brave-browser and brave-origin (confirmed via `apt-cache depends` -
  # it's how Brave rotates its own repo signing key over time), so it has
  # to be allowed too or the pin would block a real dependency, not just
  # unexpected packages.
  printf 'Package: *\nPin: origin "brave-browser-apt-release.s3.brave.com"\nPin-Priority: -1\n\nPackage: brave-browser brave-origin brave-keyring\nPin: origin "brave-browser-apt-release.s3.brave.com"\nPin-Priority: 500\n' |
    sudo tee /etc/apt/preferences.d/brave-browser-release.pref >/dev/null

  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install brave-origin
  mkdir -p ~/.config/BraveSoftware
  cp -av /usr/share/ohmydebn/config/BraveSoftware/Brave-Origin ~/.config/BraveSoftware/
fi
