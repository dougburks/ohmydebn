#!/bin/bash
#
# Every webapp (Calendar, Gmail, Google, Hotkeys, X, the OhMyDebn
# website, every user-installed webapp from ohmydebn-webapp-install, and
# ohmydebn-menu's doc links) tiled to the right half with gaps
# as it opens, via the shared ohmydebn-launch-tiled helper - the same grid
# ("2 2 1 0 1 2") as the "Tile with gaps 6 right half" keybinding. Right
# half (not left) because the left half is reserved for the
# persistently-open terminal - see ohmydebn-terminal-left. The actual
# browser-picking logic lives in ohmydebn-launch-webapp-worker, which
# ohmydebn-launch-tiled runs as its command.

set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage: ohmydebn-launch-webapp <url>" >&2
  exit 1
fi

exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 1 0 1 2 -- /usr/share/ohmydebn/bin/ohmydebn-launch-webapp-worker "$1"
