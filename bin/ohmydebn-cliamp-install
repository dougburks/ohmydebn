#!/bin/bash

set -euo pipefail

if ! dpkg -s "cliamp" >/dev/null 2>&1; then
  echo
  echo "cliamp is not currently installed."
  echo
  echo "Continuing will install a package built from:"
  echo "https://github.com/bjarneo/cliamp"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read input

  # Install packages
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install cliamp

  # Output message to user
  cat <<EOF

================================================================================

cliamp is now installed.

You can start it from the command line or by pressing:

Ctrl + Alt + M

EOF
fi
