#!/bin/bash

set -euo pipefail

if dpkg -s "docker.io" >/dev/null 2>&1; then
  echo
  echo "Docker is already installed."
else
  echo
  echo "Docker is not currently installed."
  echo
  echo "Continuing will install it from the standard Debian repos."
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."

  read -r

  # Install packages
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install docker.io

  # Output message to user
  cat <<EOF

================================================================================

Docker is now installed.

Your user has NOT been added to the docker group. Membership in that group is
effectively passwordless root: anything running as you (a rogue script, a
poisoned dependency) could run 'docker run -v /:/host' and rewrite the host
as root, with no password prompt. Use 'sudo docker ...' instead.

If you understand the risk and want the convenience of running docker without
sudo, add yourself to the group with:

  sudo usermod -aG docker "\$USER"

then log out and back in.

EOF
fi
