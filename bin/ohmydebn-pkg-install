#!/bin/bash

fzf_args=(
  --multi
  --preview 'apt-cache show {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select, F11: maximize'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

# Standalone, on-demand, independent of install.sh/ohmydebn-update's own
# flow - see ohmydebn-gestures-install's own comment for the general
# reasoning. Matters even more here than for a single-package installer:
# a stale index means the fzf search results themselves are stale (wrong
# versions, missing brand-new packages) before the user has even picked
# one to install.
sudo /usr/bin/apt update

pkg_names=$(apt list | awk -F/ '{print $1}' | sort -u | fzf "${fzf_args[@]}")

if [[ -n "$pkg_names" ]]; then
  mapfile -t pkgs <<<"$pkg_names"
  # Say so when apt fails: the window used to end the same way either way,
  # with apt's error easy to miss above it.
  if ! sudo /usr/bin/apt -y install "${pkgs[@]}"; then
    echo
    echo "The install didn't finish - see the messages above."
  fi
  /usr/share/ohmydebn/bin/ohmydebn-show-done
fi
