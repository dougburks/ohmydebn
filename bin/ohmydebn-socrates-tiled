#!/bin/bash
#
# SO-CRATES tiled to the right half with gaps immediately after launch,
# via the shared ohmydebn-launch-tiled helper - the same
# TileFocusedWindow grid ("2 2 1 0 1 2") as the "Tile with gaps 6 right
# half" keybinding. Bound to Ctrl+Alt+S in keybinding-custom.txt in place
# of a bare call to ohmydebn-socrates. Right half (not left) because the
# left half is reserved for the persistently-open terminal - see
# ohmydebn-terminal-left-tiled. ohmydebn-socrates is a single terminal
# window for its whole lifecycle (install-if-needed, then run), so no
# OHMYDEBN_LAUNCH_TILED_WATCH_SECOND needed here - see that variable's
# own comment and ohmydebn-socrates's.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 1 0 1 2 -- /usr/share/ohmydebn/bin/ohmydebn-socrates
