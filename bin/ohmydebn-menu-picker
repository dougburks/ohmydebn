#!/usr/bin/python3
#
# ohmydebn-menu-picker: GTK popup for ohmydebn-menu's top-level "Go" menu,
# and (via --apps) the application launcher formerly provided by rofi's
# `-show drun` in ohmydebn-app-launcher.
#
# Menu mode shows the 12 real categories by default; once the user types,
# live-filters across every leaf action in the whole nested menu tree (rofi
# can't do this itself - its dmenu/script modes only ever filter one static
# list handed to them at launch, never re-query per keystroke). Prints the
# chosen row's label to stdout on selection - a bare category label, or a
# full "Category > Sub > Leaf" breadcrumb - and prints nothing on cancel,
# exactly matching ohmydebn-menu's existing menu() contract so every
# show_*_menu function's own case statement barely has to change (menu()
# handles all of this - see its own comment in ohmydebn-menu). Categories
# come as argv[1] - the current level's own items string, e.g.
# show_main_menu's go_items for the top level or Install's own items for
# that submenu; argv[2] is that same call's breadcrumb prefix in the tree
# (empty at the top level, e.g. "Install" one level down) used to scope and
# relabel search results. Leaves come from ohmydebn-menu-tree's
# menu_tree_flatten(), which parses ohmydebn-menu's own source - this script
# never duplicates that structure.
#
# Apps mode (argv[1] == "--apps") instead enumerates installed .desktop
# entries itself and launches the chosen one directly - unlike menu mode, it
# never prints to stdout, matching rofi's own drun behavior of doing the
# launch itself rather than handing a result back to its caller.
#
# Windows mode (argv[1] == "--windows") replicates rofi's `-show window`
# hold-Ctrl+Alt-tap-Tab-to-cycle-release-to-select gesture for
# ohmydebn-window-switcher, rather than the type-to-search pattern the
# other two modes use: Cinnamon's <Ctrl><Alt>Tab keybinding fires this
# script once on the initial press, and from then on it's this process
# (not Cinnamon) that must see every further Tab tap and the eventual
# Ctrl/Alt release directly - see grab_keyboard() and
# on_window_key_release() below for how.
#
# Theming is read fresh on every launch from whatever
# ohmydebn-theme-set-picker already generated
# (~/.config/ohmydebn/current/picker-colors' bg0/bg1/bg3/fg0), so there's
# no separate theme pipeline to keep in sync - if that generation ever
# changes, this picks it up automatically.

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango, Wnck

import configparser
import os
import re
import concurrent.futures
import hashlib
import shlex
import subprocess
import sys
import tempfile
import time

OHMYDEBN_BIN = "/usr/share/ohmydebn/bin"
MENU_FILE = f"{OHMYDEBN_BIN}/ohmydebn-menu"
MENU_TREE_LIB = f"{OHMYDEBN_BIN}/ohmydebn-menu-tree"

# Confirmed by actually measuring get_allocated_height(), not estimated
# from CSS values - see Picker.resize_to_content()'s own comment for what
# these are for.
ROW_HEIGHT_PX = 35
MIN_SCROLLER_ROWS = 3  # cosmetic floor only - a 1-result search shouldn't shrink to a sliver

DEFAULT_COLORS = {
    "bg0": "rgba(20, 20, 24, 0.95)",
    "bg1": "rgba(20, 20, 24, 1)",
    "bg3": "rgba(90, 90, 220, 0.95)",
    "fg0": "rgba(230, 230, 230, 1)",
}


def run_menu_tree(func_call):
    """Source ohmydebn-menu-tree and evaluate func_call, returning stdout lines.
    Warnings from a broken/edited ohmydebn-menu go to stderr and are ignored
    here, same tolerance the bash side already has - an empty result just
    means an empty menu, not a crash."""
    script = f'source "{MENU_TREE_LIB}"; {func_call}'
    result = subprocess.run(["bash", "-c", script], capture_output=True, text=True, check=False)
    return [line for line in result.stdout.split("\n") if line]


def load_categories(go_items):
    """go_items is ohmydebn-menu's own go_items string (icon  Label\\nicon
    Label...), passed in as argv[1] by show_main_menu - the same real,
    executed bash data menu_tree_flatten()/menu_tree_categories() parse for
    the flattened search and for tests/consistency.sh, so there's only ever
    one place this list is written down."""
    rows = []
    # bash never interprets the literal two-character "\n" inside this
    # double-quoted string as a real newline - same conversion
    # ohmydebn-menu-tree's _mt_item_labels() already does on the bash side.
    for item in go_items.replace("\\n", "\n").split("\n"):
        if not item:
            continue
        # Split on the first run of whitespace, not a literal two spaces -
        # icons are followed by either one space (wide glyphs like the
        # magnifying glass/music note/palette, which already read as full
        # width) or two (narrow Nerd Font PUA icons), matching the same
        # `\s+`-based split ohmydebn-menu-tree already uses on the bash
        # side. A literal "  " here silently produced an empty label for
        # every single-space item (e.g. "Cybersecurity"), which then never
        # matched its own case arm and fell through to that menu's "back to
        # parent" fallback instead - confirmed as the actual cause of a
        # real report ("Install > Cybersecurity doesn't show its submenu").
        # Keep the original separator (1 or 2 spaces) for display instead of
        # hardcoding two - forcing two after a wide glyph like the
        # magnifying glass left a visibly oversized gap before "Cybersecurity".
        # The icon itself is optional (\S*, not \S+) - a few items
        # (Cybersecurity, Editor, Virtualization, ...) have never carried
        # one, just the same leading separator every icon-bearing item
        # also has before its label. \S+ required at least one non-
        # whitespace character before that separator, so it flatly failed
        # to match any icon-less item at all (the string starts with
        # whitespace) - confirmed live: m was None, and m.group(1) below
        # crashed the whole persistent picker process with an
        # AttributeError the moment such an item's menu ever got shown
        # (e.g. entering "Apps", which has five of them).
        m = re.match(r"^(\S*)(\s+)(.*)$", item)
        icon, sep, label = m.group(1), m.group(2), m.group(3).strip()
        rows.append((f"{icon}{sep}{label}", label))
    return rows


def load_leaves(breadcrumb_prefix=""):
    """breadcrumb_prefix is the calling submenu's own position in the tree
    (e.g. "Install"), passed in as argv[2] by ohmydebn-menu's menu() - empty
    for the top-level Go menu, meaning no filtering (today's behavior,
    unchanged). When set, only that submenu's own descendants are
    searchable, and the display label has the redundant prefix stripped
    (e.g. "Media > GIMP image editor" instead of
    "Install > Media > GIMP image editor" when already inside Install) -
    but the returned *value* is always the full absolute breadcrumb, so
    menu()'s own prefix-stripping logic on the bash side always has a
    consistent absolute string to work with, no relative/absolute
    reconstruction needed anywhere.

    Other Apps' descendants are runtime-discovered .desktop entries, not
    static bash-literal items like every other branch of this tree - there's
    nothing for this bash-source-parsing walk to statically enumerate, so
    it's excluded here the same way "Apps" or "Office" or any other real
    submenu would be if it could somehow have live-scanned children -
    ohmydebn-menu-tree's own MT_DEFAULT_SKIP_LABELS already does this by
    default, so this call doesn't need to (and deliberately no longer
    does) set MT_SKIP_LABELS itself; see that default's own comment for
    why hand-repeating the literal here independently was the actual bug
    that let this exclusion silently stop working for a while. It's still
    searchable from wherever it's in scope (the root, or from within
    "Apps" - see Picker.on_search_changed()'s own comment), just via a
    different path: on_search_changed() merges in a live match against
    load_apps_metadata() directly (see _matching_app_rows()) rather than
    through this function.
    """
    rows = []
    match_prefix = f"{breadcrumb_prefix} > " if breadcrumb_prefix else ""
    for line in run_menu_tree(f'menu_tree_flatten "{MENU_FILE}"'):
        breadcrumb, _, _target = line.partition("\t")
        if match_prefix:
            if not breadcrumb.startswith(match_prefix):
                continue
            display = breadcrumb[len(match_prefix):]
        else:
            display = breadcrumb
        rows.append((display, breadcrumb))
    return rows


# Labels excluded from the static menu-tree walk (see
# MT_DEFAULT_SKIP_LABELS in ohmydebn-menu-tree) because their own content
# is runtime-discovered rather than a static bash-literal item list -
# "Other Apps" is the only one today. Excluded from menu_tree_flatten()
# means excluded from find_submenu_labels()'s own leaf-prefix check too
# (there's no "Other Apps > ..." leaf for it to ever match against), so
# without this override it never earned the right-edge ">" marker a real
# submenu gets - even though picking it leads to a further screen exactly
# like any other submenu (see show_other_apps_menu's own comment in
# ohmydebn-menu). Mirrors the bash-side constant by value rather than a
# live round trip on every reload() - tests/consistency.sh guards the two
# staying in sync, the same drift that let MT_SKIP_LABELS itself go stale
# for a long time being exactly the risk a second hand-copied literal
# reintroduces here.
ALWAYS_SUBMENU_LABELS = {"Other Apps"}


def find_submenu_labels(labels, leaf_displays):
    """Which of this level's category labels lead to a further submenu (and
    so get a right-edge ">" marker). Two sources: data the picker already
    loaded - menu_tree_flatten only ever emits leaves, so an intermediate
    node's name appears solely as a breadcrumb *prefix* of its descendants
    (e.g. "Browser > Brave Origin (minimal)"), never as its own row, and
    the trailing " > " in the check is what makes this prefix-safe (a
    plain startswith(label) would false-match "Media" against the leaf
    "Media Player > ...") - plus ALWAYS_SUBMENU_LABELS above, for the one
    real submenu that check can never see on its own."""
    from_leaves = {label for label in labels if any(d.startswith(f"{label} > ") for d in leaf_displays)}
    return from_leaves | (set(labels) & ALWAYS_SUBMENU_LABELS)


_EXEC_FIELD_CODES = {"%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%i", "%c", "%k", "%v", "%m"}


def _with_icons(rows):
    """Menu-mode rows come as (display, value) pairs; apps-mode rows are
    (display, value, icon_pixbuf) so the same populate()/on_search_changed()
    code can serve both without every menu-mode caller having to know
    icons exist."""
    return [(display, value, None) for display, value in rows]


def _desktop_dirs():
    dirs = [os.path.expanduser("~/.local/share/applications")]
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for d in data_dirs.split(":"):
        if d:
            dirs.append(os.path.join(d, "applications"))
    return dirs


def _strip_exec_field_codes(exec_line):
    tokens = shlex.split(exec_line)
    return [tok.replace("%%", "%") for tok in tokens if tok not in _EXEC_FIELD_CODES]


def _parse_desktop_file(path, current_desktop):
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        parser.read(path, encoding="utf-8")
    except (configparser.Error, OSError, UnicodeDecodeError):
        return None
    if "Desktop Entry" not in parser:
        return None
    section = parser["Desktop Entry"]
    if section.get("Type", "Application") != "Application":
        return None
    if section.getboolean("NoDisplay", fallback=False) or section.getboolean("Hidden", fallback=False):
        return None
    only_show_in = set(filter(None, section.get("OnlyShowIn", "").split(";")))
    not_show_in = set(filter(None, section.get("NotShowIn", "").split(";")))
    if only_show_in and not (only_show_in & current_desktop):
        return None
    if not_show_in and (not_show_in & current_desktop):
        return None

    name = section.get("Name", "")
    exec_line = section.get("Exec", "")
    if not name or not exec_line:
        return None
    try:
        exec_tokens = _strip_exec_field_codes(exec_line)
    except ValueError:
        return None
    if not exec_tokens:
        return None
    if section.getboolean("Terminal", fallback=False):
        exec_tokens = ["x-terminal-emulator", "-e"] + exec_tokens

    return name, exec_tokens, section.get("Icon", "")


def resolve_icon_path(icon_name, size=32):
    """Main-thread-only half of icon resolution: turns an Icon= value into
    a concrete file path via Gtk.IconTheme, which is what actually touches
    GTK's theme object and so can't safely run off the main thread.
    Confirmed by direct measurement to be nearly free either way - looking
    up all ~300 of a real system's app icons this way took under 10ms
    total. The other, much heavier half (decode_icon_pixbuf below) is kept
    separate on purpose so it can run in a thread pool instead.

    No Icon= key at all (e.g. texdoctk.desktop) still falls through to the
    generic icon below, rather than leaving that one row's rendering
    visibly different from every other app's.
    """
    if icon_name and os.path.isabs(icon_name) and os.path.exists(icon_name):
        return icon_name
    name = icon_name
    for ext in (".png", ".svg", ".xpm"):
        if name.endswith(ext):
            name = name[: -len(ext)]
            break
    theme = Gtk.IconTheme.get_default()
    for candidate in (name, "application-x-executable"):
        info = theme.lookup_icon(candidate, size, Gtk.IconLookupFlags.FORCE_SIZE)
        if info is not None:
            return info.get_filename()
    return None


ICON_CACHE_DIR = os.path.expanduser("~/.cache/ohmydebn/menu-picker-icons")


def _icon_cache_path(source_path, size):
    """Cache key is a hash of the source file's own path plus its current
    mtime plus the requested size - not just the icon name - so a theme
    switch or an app update that changes what resolve_icon_path() returns
    (or replaces the file at that same path) naturally misses the cache
    and re-decodes, with no separate invalidation logic needed: the old
    entry is simply never looked up again, just an orphaned file under
    ICON_CACHE_DIR from then on."""
    try:
        mtime = os.stat(source_path).st_mtime_ns
    except OSError:
        return None
    key = hashlib.sha1(f"{source_path}:{mtime}:{size}".encode("utf-8")).hexdigest()
    return os.path.join(ICON_CACHE_DIR, f"{key}.png")


def decode_icon_pixbuf(path, size=32):
    """Thread-pool-safe half of icon resolution: a plain GdkPixbuf file
    decode + scale, touching no GTK theme/widget state - safe to call off
    the main thread, unlike Gtk.IconTheme itself. Confirmed by direct
    benchmarking that this decode step (not the lookup in
    resolve_icon_path above) is nearly all of the real cost - full
    resolution of ~300 real app icons took ~4 real seconds on a single
    thread, and running the same work across a thread pool cut that to a
    few hundred ms (GdkPixbuf's own decoders release the GIL during the
    actual C-level image decoding, so this scales close to linearly with
    core count rather than serializing on the interpreter lock).

    On top of that, most of what's left is SVG rasterization (roughly 70%
    of a real system's app icons are .svg, not .png) - genuinely expensive
    per call, unlike loading an already-raster, already-the-right-size
    file. Caching the decoded, already-scaled 32x32 result as a small flat
    PNG under ICON_CACHE_DIR and reading *that* back on every launch after
    the first (still off the main thread, still via the same thread pool)
    confirmed by direct benchmarking to cut a full ~300-icon resolution
    from ~0.2-0.3s down to ~0.05-0.1s once warm - loading a tiny pre-scaled
    PNG is cheap in a way rendering a vector icon at that size never is,
    regardless of thread count. Same mktemp-then-replace pattern
    record_app_usage() already uses elsewhere in this file, via
    tempfile.mkstemp specifically (not a fixed name plus getpid()) because
    several desktop entries can share the same underlying icon file - two
    threads racing to cache the identical target path need genuinely
    distinct temp files, not just distinct per-process ones."""
    if not path:
        return None
    cache_path = _icon_cache_path(path, size)
    if cache_path and os.path.exists(cache_path):
        try:
            return GdkPixbuf.Pixbuf.new_from_file(cache_path)
        except GLib.Error:
            pass  # cache file corrupt/unreadable - fall through and re-decode/re-cache below
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
    except GLib.Error:
        return None
    if cache_path:
        try:
            os.makedirs(ICON_CACHE_DIR, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=ICON_CACHE_DIR, suffix=".png")
            os.close(fd)
            pixbuf.savev(tmp, "png", [], [])
            os.replace(tmp, cache_path)
        except (GLib.Error, OSError):
            pass
    return pixbuf


APP_USAGE_FILE = os.path.expanduser("~/.local/state/ohmydebn-config/app-launch-counts.tsv")


def load_app_usage():
    counts = {}
    try:
        with open(APP_USAGE_FILE, encoding="utf-8") as f:
            for line in f:
                desktop_id, _, count = line.rstrip("\n").partition("\t")
                if desktop_id and count.isdigit():
                    counts[desktop_id] = int(count)
    except OSError:
        pass
    return counts


def record_app_usage(desktop_id):
    if not desktop_id:
        return
    counts = load_app_usage()
    counts[desktop_id] = counts.get(desktop_id, 0) + 1
    # Same mktemp-then-replace pattern ohmydebn-menu-tree's cache write
    # uses, so a picker killed mid-write never leaves a half-written file
    # behind for the next launch to trip over.
    try:
        os.makedirs(os.path.dirname(APP_USAGE_FILE), exist_ok=True)
        tmp = f"{APP_USAGE_FILE}.tmp{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as f:
            for did, count in counts.items():
                f.write(f"{did}\t{count}\n")
        os.replace(tmp, APP_USAGE_FILE)
    except OSError:
        pass


def load_apps_metadata():
    """Enumerates installed .desktop entries the way rofi's `-show drun`
    did for ohmydebn-app-launcher - XDG_DATA_DIRS search order (user's
    ~/.local/share first) doubles as override precedence: once a desktop-id
    is seen, later duplicates of the same id from a lower-priority dir are
    skipped, same as the spec's own override rule.

    Frequently-launched apps bubble to the top, matching rofi drun's own
    usage-based sorting - ties (including "never launched", the common
    case for most entries) fall back to alphabetical.

    Deliberately stops short of resolving icons (see resolve_icon()) -
    confirmed by hand that on a system with a few hundred .desktop entries,
    the per-entry Gtk.IconTheme lookups there (not this parsing) are what
    stretched the launcher's time-to-first-frame to multiple seconds, since
    every entry used to get resolved here before Picker.__init__ ever
    called show_all(). Splitting parsing (this function, fast) from icon
    resolution (done afterward, once the window is already showing - see
    Picker._resolve_app_icons) is what fixes that without changing the
    eventual result."""
    current_desktop = set(filter(None, os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")))
    seen_ids = set()
    parsed = []
    for base in _desktop_dirs():
        if not os.path.isdir(base):
            continue
        for root, _dirs, files in os.walk(base):
            for fname in files:
                if not fname.endswith(".desktop"):
                    continue
                path = os.path.join(root, fname)
                desktop_id = os.path.relpath(path, base).replace(os.sep, "-")
                if desktop_id in seen_ids:
                    continue
                seen_ids.add(desktop_id)
                entry = _parse_desktop_file(path, current_desktop)
                if entry is not None:
                    name, exec_tokens, icon_name = entry
                    parsed.append((name, exec_tokens, icon_name, desktop_id))

    usage = load_app_usage()
    parsed.sort(key=lambda e: (-usage.get(e[3], 0), e[0].lower()))
    return parsed


def apps_rows(parsed, icons=None):
    """Builds populate()-ready rows from load_apps_metadata()'s output.
    icons (desktop_id -> pixbuf) is None on the first, icon-less pass
    (see Picker.__init__) and filled in on the second pass once
    _resolve_app_icons() has run - a plain dict.get() on an empty/partial
    dict already returns None for anything not resolved yet, which
    populate() already treats as "no icon for this row", so no separate
    icon-less code path is needed here."""
    icons = icons or {}
    return [
        (name, (exec_tokens, desktop_id), icons.get(desktop_id))
        for name, exec_tokens, icon_name, desktop_id in parsed
    ]


def get_monitor_geometry():
    # None of these tools ever passed rofi an explicit -monitor, so they
    # all rode on rofi's own default: "-5, the monitor that shows the
    # mouse pointer" (confirmed in `man rofi`) - not the primary monitor.
    # On a multi-monitor setup, always using the primary monitor here
    # instead pinned every popup to the left screen regardless of which
    # monitor the user was actually working on.
    display = Gdk.Display.get_default()
    seat = display.get_default_seat()
    _screen, x, y = seat.get_pointer().get_position()
    monitor = display.get_monitor_at_point(x, y) or display.get_primary_monitor() or display.get_monitor(0)
    return monitor.get_geometry()


def launch_app(exec_tokens):
    try:
        subprocess.Popen(
            exec_tokens,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


_SWITCHABLE_WINDOW_TYPES = (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG, Wnck.WindowType.UTILITY)


def load_windows():
    """Enumerates open windows the way rofi's `-show window` did for
    ohmydebn-window-switcher - Wnck (already installed; Cinnamon
    itself depends on it) gives window listing/activation/icons directly,
    no wmctrl/xdotool parsing needed.

    get_windows_stacked() is bottom-to-top; reversing it approximates a
    most-recently-used order for free (raising a window moves it to the
    top of the stack) without any persistent state - this script is a
    fresh process on every Ctrl+Alt+Tab press, so there's no daemon around
    to track real focus history across invocations. is_skip_tasklist()
    also excludes this picker's own window itself, since
    Picker.__init__ sets that hint before the window is ever mapped."""
    screen = Wnck.Screen.get_default()
    screen.force_update()
    rows = []
    for win in reversed(screen.get_windows_stacked()):
        if win.is_skip_tasklist() or win.get_window_type() not in _SWITCHABLE_WINDOW_TYPES:
            continue
        icon = win.get_icon()
        if icon is not None:
            icon = icon.scale_simple(32, 32, GdkPixbuf.InterpType.BILINEAR)
        rows.append((win.get_name(), win, icon))
    return rows


def activate_window(win):
    try:
        win.activate(Gtk.get_current_event_time())
    except GLib.Error:
        pass


def hex_to_rgba(hex_value):
    hex_value = hex_value.lstrip("#")
    r = int(hex_value[0:2], 16)
    g = int(hex_value[2:4], 16)
    b = int(hex_value[4:6], 16)
    a = int(hex_value[6:8], 16) / 255 if len(hex_value) >= 8 else 1.0
    return f"rgba({r}, {g}, {b}, {a:.3f})"


def load_theme_colors():
    """Reads the small plain key=value file ohmydebn-theme-set-picker
    writes fresh on every theme change, so this picker always matches
    whatever theme is active - no separate palette to keep in sync."""
    colors = dict(DEFAULT_COLORS)
    config_path = os.path.expanduser("~/.config/ohmydebn/current/picker-colors")
    try:
        with open(config_path, encoding="utf-8") as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                if key and value:
                    colors[key] = hex_to_rgba(value)
    except OSError:
        pass
    return colors


CSS_TEMPLATE = """
#picker-window {{
    background-color: {bg0};
    border: 2px solid {bg3};
}}
#picker-entry, #picker-entry entry {{
    background-color: {bg1};
    color: {fg0};
    border: 2px solid {bg3};
    border-radius: 0;
    padding: 8px 16px;
}}
#picker-list {{
    background-color: transparent;
}}
#picker-list row {{
    padding: 8px 16px;
    color: {fg0};
}}
#picker-list row:selected {{
    background-color: {bg3};
    color: {bg1};
}}
* {{
    font-family: "CaskaydiaMono Nerd Font";
    font-size: 12pt;
}}
"""


class Picker(Gtk.Window):
    def __init__(self, go_items="", breadcrumb_prefix="", mode="menu", on_result=None):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False)
        # NORMAL, not DIALOG: confirmed live (xprop on the mapped window)
        # that Muffin only honors _NET_WM_STATE_SKIP_TASKBAR for a DIALOG
        # when it has a transient parent - this window has none, so with
        # DIALOG it silently ignored skip_taskbar_hint below and showed up
        # in the panel's window list anyway. UTILITY does get skip-taskbar
        # honored, but Muffin then also declines to give it real X input
        # focus on map (confirmed live: _NET_WM_STATE_DEMANDS_ATTENTION
        # instead of _NET_WM_STATE_FOCUSED, and xdotool getactivewindow
        # pointing at whatever was behind it) - so arrow keys/typing landed
        # on the window underneath instead of this picker. NORMAL is the
        # only type hint of the three that gets both: skip-taskbar honored
        # *and* real focus on map.
        self.set_type_hint(Gdk.WindowTypeHint.NORMAL)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_name("picker-window")
        if mode == "menu":
            self.set_title(breadcrumb_prefix or "OhMyDebn Menu")

        self.mode = mode
        # None (the default) is today's one-shot behavior, entirely
        # unchanged: finish() prints the result and quits. A callable here
        # is --serve mode's hook (menu mode only - see reload()): finish()
        # hands it the result instead of quitting, so this same window and
        # process can be reused for the next request rather than a fresh
        # process paying GTK/PyGObject's import cost again.
        self.on_result = on_result
        # All four always initialized regardless of mode, not just when
        # mode == "apps" at construction time: --serve mode always starts
        # in mode="menu" and only reaches apps content later - either via
        # reload() switching self.mode to "apps" ("Other Apps"), or while
        # still in mode="menu" via a top-level search merge (see
        # _matching_app_rows()) - so this same cache/in-flight state needs
        # to exist from the start regardless of which mode this window
        # opens in. See _ensure_apps_scanned()/_start_icon_loading() for
        # how each is used.
        self._apps_parsed = None
        self._resolved_icons = {}
        self._icon_loading_active = False
        self._icon_pool = None
        if mode == "apps":
            self._load_apps_rows()
        elif mode == "windows":
            self.categories = self.leaves = load_windows()
        else:
            self.categories = _with_icons(load_categories(go_items))
            self.leaves = _with_icons(load_leaves(breadcrumb_prefix))
        # Only menu mode has submenus to mark. apps/windows values aren't
        # even hashable (apps' value is (exec_tokens_list, desktop_id), a
        # tuple containing a list) - the populate() membership check below
        # is guarded on self.mode == "menu" specifically because `in` on a
        # set has to hash its operand before it can find out the set is
        # empty, so an unguarded check crashes with "unhashable type:
        # list" in apps mode rather than just failing to match (confirmed
        # live: it crashed Picker(mode="apps") - i.e. the whole app
        # launcher - before this guard existed).
        self.submenu_labels = (
            find_submenu_labels(
                [value for _display, value, _icon in self.categories],
                [display for display, _value, _icon in self.leaves],
            )
            if mode == "menu"
            else set()
        )
        self._closing = False
        # --serve mode only: id of a pending deferred-close timeout (see
        # _schedule_close()/reload()), or None when nothing's scheduled.
        self._pending_close_id = None
        self.breadcrumb_prefix = breadcrumb_prefix
        # Remembers, per breadcrumb level, which submenu row was last
        # activated to descend from it - restored on reload() (see there)
        # so pressing Escape back up to a level highlights the item that
        # was previously selected, rather than always resetting to the
        # first row. Lives only as long as this --serve process does,
        # which is the right scope: a brand new picker session (after the
        # idle-close timeout, or the one-shot fallback path) should start
        # clean, not resurrect a stale position from hours ago.
        self._return_selection = {}

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.set_border_width(12)
        self.add(outer)

        self.entry = Gtk.SearchEntry()
        self.entry.set_name("picker-entry")
        placeholder = {"apps": "Launch…", "windows": "Switch to…"}.get(mode, "Search")
        self.entry.set_placeholder_text(placeholder)
        self.entry.connect("search-changed", self.on_search_changed)
        outer.pack_start(self.entry, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        # propagate_natural_height sizes the scroller to the real row count
        # correctly on this window's first-ever layout, before it's shown.
        # It stops being enough the moment content changes *after* that
        # first layout (every reload() to a new screen, every search
        # keystroke): plain resize() is silently ignored by Cinnamon/
        # Muffin on this undecorated DIALOG-hint window once mapped
        # (confirmed by hand - tried directly, and after clearing
        # set_size_request() first, neither budged it), and --serve mode's
        # window is *always* mapped with zero rows before reload() ever
        # populates real content, so every "menu" mode screen depends on
        # the fix below, not just this initial layout. See
        # resize_to_content(), called from the end of populate() (every
        # path that changes what's visible goes through there, including
        # the unconditional self.populate(self.categories) a few lines
        # below - so min_content_height doesn't need setting here too,
        # only max/propagate: whatever this constructor's initial content
        # actually is, resize_to_content() sets the real min for it before
        # this window is ever shown).
        # max_height: used to be a fixed 630px (~18 rows, matching rofi's
        # own `listview { lines: 18; }` convention), but that forced a
        # scrollbar for lists that would have comfortably fit on screen
        # (e.g. an open-windows list of a dozen or so) - basing it on the
        # actual monitor height instead avoids the scrollbar whenever the
        # list genuinely fits, while still capping (and necessarily still
        # scrolling) a long one like the ~100-entry Apps list that could
        # never fit regardless.
        self.max_scroller_height = max(300, int(get_monitor_geometry().height * 0.7))
        scroller.set_max_content_height(self.max_scroller_height)
        scroller.set_propagate_natural_height(True)
        outer.pack_start(scroller, True, True, 0)
        self.scroller = scroller

        self.listbox = Gtk.ListBox()
        self.listbox.set_name("picker-list")
        self.listbox.set_selection_mode(Gtk.SelectionMode.BROWSE)
        self.listbox.set_can_focus(True)
        self.listbox.connect("row-activated", self.on_row_activated)
        scroller.add(self.listbox)

        self.populate(self.categories)
        if mode == "windows" and len(self.categories) > 1:
            # Classic alt-tab convention: a single tap-and-release should
            # land on the *previous* window, not the one already focused
            # (which sorts first via the reversed-stacking approximation in
            # load_windows()).
            second_row = self.listbox.get_row_at_index(1)
            if second_row:
                self.listbox.select_row(second_row)

        # The entry keeps real keyboard focus at all times - normal typing
        # is handled entirely by GTK's own GtkEntry input (including IBus/
        # input-method integration), never touched by this code. Only
        # navigation keys are intercepted here and used to move the
        # ListBox's selection manually. An earlier version of this did the
        # opposite (focus on the ListBox, forwarding keystrokes into the
        # entry via GtkSearchEntry.handle_event()) and that dropped
        # characters under IBus in practice - confirmed by a real report of
        # "cloud" not matching "Cloudflare Warp". Forwarded/synthetic events
        # bypassing the actually-focused widget is exactly what input
        # methods don't expect.
        self.entry.connect("key-press-event", self.on_entry_key)
        self.connect("key-release-event", self.on_window_key_release)
        self.connect("focus-out-event", self.on_focus_out)

        # Raw logical-pixel widths, unscaled - GTK already scales
        # set_default_size() by the monitor's own scale factor
        # automatically (confirmed by hand: identical set_default_size()
        # calls produced a real 480x200 X11 window at GDK_SCALE=1 and a
        # real 960x400 one at GDK_SCALE=2, with no extra code involved).
        # An earlier version pre-multiplied by that same scale factor
        # itself, via a small now-deleted scale-lookup helper script - a
        # leftover from rofi's very different DPI/theme-unit model, which
        # doesn't get GTK's automatic handling - doubling up like that
        # would have quadrupled the window's on-screen area on a 2x
        # display.
        width_by_mode = {"apps": 500, "windows": 800}
        self.set_default_size(width_by_mode.get(mode, 480), -1)
        # Positioned here, before this window is ever shown, not from the
        # "show" signal as before - confirmed live that get_size() already
        # reports the real width right after set_default_size() above, with
        # no realize/map needed first, and position_window()'s own math
        # only ever depends on that fixed width plus monitor geometry
        # (never on content height - resize_to_content() only ever changes
        # height, this window's width is set once here and never
        # revisited). Moving a not-yet-shown window sets GTK/X11's
        # initial-position hint, which the WM honors on map instead of
        # doing its own default/smart placement - so the very first frame
        # already lands centered instead of visibly appearing at whatever
        # the WM would have otherwise picked (confirmed by hand: the old
        # show-signal-triggered, idle_add-deferred call left a real,
        # visible one-frame flash at the WM's default spot before jumping
        # to center).
        self.position_window()

        self.apply_theme()
        self.connect("show", self.on_show)
        if mode == "windows":
            self.connect("map-event", self.on_map_grab_keyboard)
            # The old rofi config for this tool also carried
            # `-timeout-delay 1 -timeout-action kb-accept-entry`, which
            # looked like a 1-second safety net for a missed
            # modifier-release. Confirmed by checking `rofi -help` against
            # the actual installed version (1.7.5) that neither flag is a
            # real rofi option at all - it silently did nothing, so real
            # usage of this tool has only ever relied on the release-based
            # accept below, with no time limit. A literal 1-second version
            # of that dead flag was tried here first and confirmed (by
            # direct instrumentation) to cut real hold-and-tap sessions off
            # mid-gesture, well before a human finishes cycling. Kept as a
            # much longer, genuinely-defensive fallback instead - only
            # meant to catch a truly stuck grab, not to fire in normal use.
            GLib.timeout_add(30000, self.on_timeout_accept)
        elif mode == "apps":
            # G_PRIORITY_DEFAULT_IDLE (idle_add's own default) runs after
            # GTK's higher-priority redraw idle source, so this fires only
            # once the window has actually been drawn on screen - the whole
            # point being that resolving icons (the slow part - see
            # load_apps_metadata()'s comment) no longer happens before the
            # user ever sees the launcher appear.
            self._start_icon_loading()

    def reload(self, go_items, breadcrumb_prefix, mode="menu"):
        """--serve mode only (self.on_result is set): repopulates this same
        already-open window for a new screen, instead of a fresh process
        paying GTK/PyGObject's import cost again (profiled at ~90-140ms) for
        every single menu level. Mirrors exactly the subset of __init__
        that's about *content* (categories/leaves/submenu labels, the
        listbox, the search entry) - everything about the window/widget tree
        itself (CSS, size, event handlers) was already built once and stays
        as-is. Windows mode is still always one-shot (no chain of levels to
        amortize a respawn over) and never reaches this; mode is either
        "menu" (the ordinary nested Go-menu tree, the default and today's
        only caller) or "apps" (Other Apps shown as a real level of that
        same tree instead of a separate ohmydebn-app-launcher process - see
        show_other_apps_menu() in ohmydebn-menu and _load_apps_rows()/
        _start_icon_loading() below). Sets the (otherwise-unused, since this
        window is undecorated and skip-taskbar) window title to the new
        breadcrumb - harmless, and lets external tooling (a test, xdotool)
        observe when a reload has actually landed without touching the
        real request/response protocol. Also cancels a pending deferred
        close (see _schedule_close()) before it can fire - a reload() this
        soon after a pick means this session isn't over after all, so
        self.show() below is a no-op on a window that was visible the
        whole time rather than an actual re-show. (If the close already
        fired, this process has already quit and reload() can't be called
        on it at all - get_picker_result on the bash side would have
        already noticed via kill -0 and fallen back to a fresh one-shot
        spawn instead.)"""
        if self._pending_close_id is not None:
            GLib.source_remove(self._pending_close_id)
            self._pending_close_id = None
        self.show()
        self.set_title(breadcrumb_prefix or "OhMyDebn Menu")
        self.breadcrumb_prefix = breadcrumb_prefix
        self.mode = mode
        if mode == "apps":
            self._load_apps_rows()
            self._start_icon_loading()
            self.submenu_labels = set()
        else:
            self.categories = _with_icons(load_categories(go_items))
            self.leaves = _with_icons(load_leaves(breadcrumb_prefix))
            self.submenu_labels = find_submenu_labels(
                [value for _display, value, _icon in self.categories],
                [display for display, _value, _icon in self.leaves],
            )
        self.entry.set_text("")
        self._closing = False
        self.populate(self.categories)
        return_value = self._return_selection.get(breadcrumb_prefix)
        if return_value is not None:
            for row in self.listbox.get_children():
                if row.value == return_value:
                    self.listbox.select_row(row)
                    break
        self.entry.grab_focus()

    def _ensure_apps_scanned(self):
        """Lazily parses installed .desktop entries once per persistent-
        picker session and caches them on self - not eagerly on every
        reload() to the top-level Go menu, since most Go-menu visits never
        type a search or open "Other Apps" at all. Both _load_apps_rows()
        (a real visit to "Other Apps") and _matching_app_rows() (every
        top-level search keystroke - see on_search_changed()) go through
        this same cache: re-walking every .desktop file per keystroke would
        be far too slow, and there's no correctness reason for "Other
        Apps"'s own list to differ from what a search just showed a moment
        earlier in the same session. A brand new ohmydebn-menu invocation
        gets a fresh --serve process (see its own start_persistent_picker())
        and so a fresh scan too - an app installed mid-session simply won't
        show up until the next one, the same staleness window every other
        per-session cache in this file already accepts (e.g.
        _return_selection)."""
        if self._apps_parsed is None:
            self._apps_parsed = load_apps_metadata()

    def _load_apps_rows(self):
        """Builds this window's full apps-mode content (the real "Other
        Apps" view, not a search merge - see _matching_app_rows() for
        that)."""
        self._ensure_apps_scanned()
        self.categories = self.leaves = apps_rows(self._apps_parsed, self._resolved_icons)

    def _matching_app_rows(self, needle):
        """Other Apps' own entries, merged into a live search from
        wherever it's actually in scope (the true root, or from within
        "Apps" itself - see on_search_changed()'s own comment on why both).
        Filters self._apps_parsed directly by name first, then only builds
        display rows (and looks up icons) for what actually matched,
        rather than materializing every installed app's row on every
        keystroke just to throw most of them away."""
        self._ensure_apps_scanned()
        self._start_icon_loading()
        matched = [entry for entry in self._apps_parsed if needle in entry[0].lower()]
        return apps_rows(matched, self._resolved_icons)

    def _start_icon_loading(self):
        """Starts background icon-decode batches for whatever in
        self._apps_parsed isn't already in self._resolved_icons - a no-op
        if a run is already active (self._icon_loading_active) or nothing's
        left unresolved, so calling this from every _matching_app_rows()
        keystroke and from _load_apps_rows() never restarts or duplicates
        work already in flight or already done. Unlike an earlier version
        of this, there's no still-running pool to shut down and no session
        counter to guard a scheduled batch against going stale: since
        self._apps_parsed is now a stable, cached list (see
        _ensure_apps_scanned()) rather than re-scanned fresh on every
        visit, an in-flight batch is always still working toward the one
        real target set, whatever happens to self.mode in the meantime -
        the only thing that still needs checking, in
        _resolve_app_icons_batch() itself, is whether it's still safe to
        touch self.categories/self.leaves once done."""
        if self._icon_loading_active:
            return
        unresolved = [entry for entry in self._apps_parsed if entry[3] not in self._resolved_icons]
        if not unresolved:
            return
        self._icon_loading_active = True
        self._icon_queue = unresolved
        # 12 workers, not one-per-icon or unbounded: confirmed by direct
        # benchmarking to be past the knee of the curve on real hardware (8
        # workers: ~0.38s for a full ~300-icon set; 12: ~0.19s; 16-24: no
        # further real improvement, just more idle threads) - this is a
        # foreground GUI action, not a place to grab arbitrarily many cores
        # for shrinking returns. Created once and reused across every batch
        # in _resolve_app_icons_batch rather than per-batch.
        self._icon_pool = concurrent.futures.ThreadPoolExecutor(max_workers=12, thread_name_prefix="icon-decode")
        GLib.idle_add(self._resolve_app_icons_batch)

    def apply_theme(self):
        colors = load_theme_colors()
        css = CSS_TEMPLATE.format(**colors).encode("utf-8")
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def populate(self, rows):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        for display, value, icon in rows:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            if icon is not None:
                box.pack_start(Gtk.Image.new_from_pixbuf(icon), False, False, 0)
            row_label = Gtk.Label(label=display, xalign=0)
            # A search result's display text is a full breadcrumb (e.g.
            # "Install > Virtualization > Virtual Machine Manager
            # (Advanced)") with no length limit, but this window's width is
            # fixed - without ellipsizing, a long one just silently runs
            # past the edge of the window with no visual indication
            # anything's missing (confirmed by hand: text same length
            # either way, just invisible past the cutoff). set_line_wrap
            # isn't a fix here - GtkListBoxRow doesn't reflow other rows to
            # accommodate the height that would take, only the label's own
            # single-line height, so it just clips vertically instead of
            # horizontally.
            row_label.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(row_label, True, True, 0)
            # Submenu rows get a right-edge ">" affordance. pack_end plus
            # the expanding, end-ellipsizing main label above keeps the
            # arrow pinned to the window's right edge no matter how long
            # the label is. Display-only: row.value stays the bare label,
            # so the string printed back to ohmydebn-menu (and every case
            # arm matching on it) is exactly what it was before markers
            # existed. Search results are all leaves, so they never carry
            # one. isinstance guards this from ever even trying `in` on a
            # merged-in app row's value - see on_search_changed()'s own
            # comment - which is an (exec_tokens, desktop_id) tuple
            # containing a list, and so unhashable.
            if self.mode == "menu" and isinstance(value, str) and value in self.submenu_labels:
                box.pack_end(Gtk.Label(label=">", xalign=1), False, False, 0)
            row.value = value
            row.add(box)
            self.listbox.add(row)
        self.listbox.show_all()
        first = self.listbox.get_row_at_index(0)
        if first:
            self.listbox.select_row(first)
        self.resize_to_content(len(rows))

    def resize_to_content(self, row_count):
        """Keeps this window sized to what's actually visible, called from
        the end of populate() - every path that changes the row count
        (reload() to a new screen, a search keystroke, the very first
        populate() at construction) goes through there. Needed because
        propagate_natural_height (see the scroller's own setup comment)
        only sizes correctly on this window's first-ever layout; once
        mapped, Cinnamon/Muffin ignores plain resize() outright, but
        forcing it through actual WM size hints - pinning min and max size
        to the same value via set_geometry_hints(), then resize() - does
        work (confirmed by hand). Before the first show, this window isn't
        mapped yet (get_mapped() is False) - just updating the scroller's
        min so propagate_natural_height's own first-layout sizing (already
        correct on its own) picks it up, without forcing anything through
        the WM-hint path this early.
        """
        target_rows = max(MIN_SCROLLER_ROWS, row_count)
        target_scroller_h = min(target_rows * ROW_HEIGHT_PX, self.max_scroller_height)
        self.scroller.set_min_content_height(target_scroller_h)
        if not self.get_mapped():
            return
        width = self.get_size()[0]
        _min_h, natural_h = self.get_preferred_height()
        geom = Gdk.Geometry()
        geom.min_width = width
        geom.max_width = width
        geom.min_height = natural_h
        geom.max_height = natural_h
        self.set_geometry_hints(None, geom, Gdk.WindowHints.MIN_SIZE | Gdk.WindowHints.MAX_SIZE)
        self.resize(width, natural_h)

    def on_search_changed(self, entry):
        text = entry.get_text().strip()
        if not text:
            self.populate(self.categories)
            return
        needle = text.lower()
        # Apps/windows modes have no separate breadcrumb string to match
        # against - the display name (an app's Name=, a window's title) is
        # the only searchable text, unlike menu mode's value/breadcrumb.
        if self.mode in ("apps", "windows"):
            matches = [(d, v, i) for d, v, i in self.leaves if needle in d.lower()]
        else:
            matches = [(d, v, i) for d, v, i in self.leaves if needle in v.lower()]
            # Other Apps merged in whenever it's actually in scope: it
            # lives at "Apps > Other Apps", so it's a reachable descendant
            # both from the true root (breadcrumb_prefix == "", where
            # load_leaves() itself already has an empty match_prefix and
            # so searches the *whole* static tree, not just direct
            # children) and from within "Apps" itself - but not from
            # inside an unrelated sibling submenu like Media, matching
            # load_leaves()'s own per-level scoping. Excluded from the
            # static menu-tree walk entirely (see load_leaves()'s own
            # comment) since its entries are runtime-discovered, not
            # something that walk can parse - this is the live
            # equivalent, computed directly instead.
            if self.mode == "menu" and self.breadcrumb_prefix in ("", "Apps"):
                matches = matches + self._matching_app_rows(needle)
        self.populate(matches)

    # 60: confirmed by direct instrumentation that each GLib.idle_add
    # round trip between batches carries real fixed overhead (~100-150ms
    # on this machine, independent of batch size) - so fewer, larger
    # batches finish the whole set faster even though the per-icon decode
    # cost is unchanged. 60 was picked as the point past which that's
    # still true without a single batch's own decode work (the part that
    # actually can stall the main loop) getting large enough to be
    # perceptible: a cold cache's worst observed single batch at this size
    # was ~140ms of real decode time across self._icon_pool's workers;
    # bigger sizes tried (100) pushed a single cold batch to ~220ms, which
    # starts being felt as a hitch rather than smooth. Warm-cache batches
    # (see decode_icon_pixbuf's own comment) are far cheaper still, so
    # this ceiling is sized for the worst case, not the common one.
    _ICON_BATCH_SIZE = 60

    def _resolve_app_icons_batch(self):
        """The deferred second half of apps loading (see
        load_apps_metadata()'s comment) - runs in small batches across many
        idle callbacks, after the window is already showing, rather than
        resolving every unresolved icon in one uninterrupted call. Each
        batch does its own icon lookups (resolve_icon_path -
        main-thread-only, but confirmed near-free) and then hands the
        actual decoding (decode_icon_pixbuf - confirmed to be nearly all of
        the real cost) to self._icon_pool, so this one batch's icons decode
        in parallel across several cores instead of serially on this
        callback. Combined with chunking itself, this took a real
        ~4-second, completely-frozen single-threaded resolve (see the
        pre-threading version of this method in git history/backups) down
        to well under a second total, spread thin enough per batch that the
        window never visibly stalls. Returning SOURCE_CONTINUE instead of
        doing the whole list hands control back to GLib after every batch,
        so pending input/redraw sources get a chance to run before the
        next chunk starts.

        _start_icon_loading() guarantees only one of these chains ever
        runs at a time and that self._apps_parsed never changes underneath
        it (see its own comment), so there's no staleness to guard against
        here - only whether it's still safe to touch self.categories/
        self.leaves once the whole queue drains: this pool may have been
        started for "Other Apps" itself (self.mode == "apps", where
        categories/leaves ARE the apps list) or for a top-level search
        merge (self.mode == "menu" - see _matching_app_rows(), whose own
        return value is what actually needs the freshly resolved icons,
        computed fresh on every call rather than cached on self). Either
        way, on_search_changed() is what needs to run once new icons land -
        for "Other Apps" that means re-filtering the just-updated
        self.leaves; for a menu-mode search it means recomputing the merged
        app matches, picking up icons that weren't ready a moment ago.
        Calling it unconditionally is safe even if the user has since
        cleared the search or moved to yet another submenu - it always
        just reflects whatever's actually in the entry right now.
        populate() (called from inside on_search_changed()) always
        reselects row 0, which would yank the selection back to the top
        out from under anyone who already arrow-keyed away during the
        icon-loading pause; restoring the previously-selected value here
        (falling through to row 0 only if it's gone, e.g. filtered out by
        a search typed in the meantime) avoids that."""
        batch, self._icon_queue = self._icon_queue[: self._ICON_BATCH_SIZE], self._icon_queue[self._ICON_BATCH_SIZE :]
        paths = [resolve_icon_path(icon_name) for _name, _exec_tokens, icon_name, _desktop_id in batch]
        pixbufs = self._icon_pool.map(decode_icon_pixbuf, paths)
        for (_name, _exec_tokens, _icon_name, desktop_id), pixbuf in zip(batch, pixbufs):
            self._resolved_icons[desktop_id] = pixbuf
        if self._icon_queue:
            return GLib.SOURCE_CONTINUE

        self._icon_pool.shutdown(wait=False)
        self._icon_loading_active = False
        if self.mode == "apps":
            self.categories = self.leaves = apps_rows(self._apps_parsed, self._resolved_icons)
        selected = self.listbox.get_selected_row()
        selected_value = selected.value if selected is not None else None
        self.on_search_changed(self.entry)
        if selected_value is not None:
            for row in self.listbox.get_children():
                if row.value == selected_value:
                    self.listbox.select_row(row)
                    break
        return GLib.SOURCE_REMOVE

    def _remember_descent(self, value):
        """Records that `value` (a submenu row) was activated from the
        current breadcrumb level, for reload() to restore on the way back
        - see _return_selection's own comment in __init__. No-op for a
        leaf pick (nothing to remember there; picking a leaf ends this
        menu entirely rather than returning to it), in apps/windows mode,
        or for an Other-Apps row merged into a top-level menu-mode search
        (see _matching_app_rows()). The isinstance check must come first,
        not just rely on submenu_labels being empty for those: an app row's
        value is (exec_tokens_list, desktop_id), a tuple containing a list,
        and `in` on a set has to hash its operand before it can find out
        the set is empty - the same unhashable-list crash populate()
        already guards against the same way, confirmed live to otherwise
        take down every Enter/click in the app launcher before it ever
        reaches finish()."""
        if self.mode == "menu" and isinstance(value, str) and value in self.submenu_labels:
            self._return_selection[self.breadcrumb_prefix] = value

    def on_row_activated(self, listbox, row):
        self._remember_descent(row.value)
        self.finish(row.value)

    def on_entry_key(self, widget, event):
        keyval = event.keyval
        if keyval == Gdk.KEY_Escape:
            # A non-empty query clears first and stays open, rather than
            # discarding the whole search on one stray Escape - the
            # existing back-a-level/close behavior (finish(None), below)
            # only fires once the query is already empty, so it's
            # unchanged for that case.
            if self.entry.get_text():
                self.entry.set_text("")
                self.on_search_changed(self.entry)
                return True
            self.finish(None)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_Right):
            row = self.listbox.get_selected_row()
            if row is not None:
                self._remember_descent(row.value)
                self.finish(row.value)
            return True
        if keyval == Gdk.KEY_Left:
            # Mirrors Right-as-accept above: a direct "back a level"
            # binding, not folded into Escape's clear-search-first nuance -
            # same finish(None) either way reaches bash's own
            # go-back-to-parent fallback (every show_*_menu's `*) show_..
            # ;;` case arm on an empty result).
            self.finish(None)
            return True
        if keyval in (
            Gdk.KEY_Up, Gdk.KEY_Down, Gdk.KEY_Home, Gdk.KEY_End,
            Gdk.KEY_Page_Up, Gdk.KEY_Page_Down,
        ):
            self.move_selection(keyval)
            return True
        if self.mode == "windows" and keyval == Gdk.KEY_Tab:
            # Matches rofi's `-kb-row-down "Ctrl-Alt-Tab,Ctrl-Alt-Down"` -
            # each further Tab tap while Ctrl+Alt stays held cycles down.
            # Otherwise GTK's own default binding would use Tab to move
            # focus to the next widget instead.
            self.move_selection(Gdk.KEY_Down)
            return True
        if self.mode == "windows" and keyval == Gdk.KEY_ISO_Left_Tab:
            # X11 delivers Shift+Tab as this separate keyval, not Tab with
            # a shift-modifier bit - matches rofi's own
            # "Ctrl-Alt-ISO_Left_Tab" row-up binding.
            self.move_selection(Gdk.KEY_Up)
            return True
        return False  # let the entry's own default handling process it

    def on_window_key_release(self, widget, event):
        if self.mode != "windows" or event.keyval not in (
            Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
        ):
            return False
        # The whole point of "!Ctrl-Alt-Tab" in the old rofi config: Tab
        # itself is released after every single cycling tap while Ctrl+Alt
        # stay down, so it's specifically releasing one of *these* two
        # modifiers that ends the gesture and commits the highlighted row.
        row = self.listbox.get_selected_row()
        self.finish(row.value if row is not None else None)
        return True

    def on_timeout_accept(self):
        if not self._closing:
            row = self.listbox.get_selected_row()
            self.finish(row.value if row is not None else None)
        return GLib.SOURCE_REMOVE

    def page_size(self):
        """How many rows Page Up/Down should jump - a full screenful, not a
        fixed count. The scroller's viewport height varies with monitor
        size and list length (see the propagate_natural_height comment
        above), so 8 was right for some lists and wrong for others -
        measuring the real row height against the real viewport height is
        the only way to match a full page for any given picker."""
        rows = self.listbox.get_children()
        row_height = rows[0].get_allocated_height() if rows else 0
        viewport_height = self.scroller.get_allocated_height()
        if row_height <= 0 or viewport_height <= 0:
            return 8
        return max(1, viewport_height // row_height)

    def move_selection(self, keyval):
        rows = self.listbox.get_children()
        if not rows:
            return
        current = self.listbox.get_selected_row()
        index = current.get_index() if current is not None else -1
        last = len(rows) - 1
        if keyval == Gdk.KEY_Down:
            # Wrap top<->bottom, matching rofi's default behavior.
            index = 0 if index == last else index + 1
        elif keyval == Gdk.KEY_Up:
            index = last if index <= 0 else index - 1
        elif keyval == Gdk.KEY_Home:
            index = 0
        elif keyval == Gdk.KEY_End:
            index = last
        elif keyval == Gdk.KEY_Page_Down:
            index = min(index + self.page_size(), last)
        elif keyval == Gdk.KEY_Page_Up:
            index = max(index - self.page_size(), 0)

        new_row = self.listbox.get_row_at_index(index)
        if new_row is None:
            return
        self.listbox.select_row(new_row)
        # Momentarily grabbing the row's focus is what makes the
        # surrounding ScrolledWindow auto-scroll it into view - GTK has no
        # "scroll to this row" call independent of focus. Both grabs happen
        # synchronously within this one handler, before the next redraw, so
        # focus visibly stays on the entry and typing is never interrupted.
        new_row.grab_focus()
        self.entry.grab_focus()

    def on_focus_out(self, widget, event):
        # Clicking away closes the picker, matching rofi's default
        # click-away-to-cancel behavior.
        self.finish(None)
        return False

    def on_show(self, widget):
        self.entry.grab_focus()

    def on_map_grab_keyboard(self, widget, event):
        # Without this, Cinnamon's own <Ctrl><Alt>Tab global keybinding -
        # not this already-open window - would receive every further Tab
        # tap while the modifiers stay held, spawning a fresh duplicate
        # picker on each one instead of cycling this one. rofi grabs the
        # keyboard for the same reason while any of its modes are open.
        #
        # Must happen on "map-event", not the earlier "show" signal (via
        # idle_add) - confirmed by direct testing that grabbing that early
        # returns GDK_GRAB_NOT_VIEWABLE and silently fails, since the X
        # server hasn't actually mapped the window yet at that point. A
        # failed grab is exactly what let Cinnamon's own shortcut keep
        # firing on every tap instead of this window ever seeing them -
        # each tap looked like a fresh, independent launch (always
        # resetting to the same default selection) rather than a cycle.
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(self.get_window(), Gdk.SeatCapabilities.KEYBOARD, False, None, None, None, None)
        return False

    def position_window(self):
        geo = get_monitor_geometry()
        win_width, win_height = self.get_size()
        x = geo.x + (geo.width - win_width) // 2
        y = geo.y + int(geo.height * 0.25) - 176
        self.move(x, max(y, geo.y))
        return GLib.SOURCE_REMOVE

    def finish(self, value):
        if self._closing:
            return
        self._closing = True
        if self.mode == "windows":
            Gdk.Display.get_default().get_default_seat().ungrab()
        if value:
            if isinstance(value, tuple):
                # An app value - either real apps mode (standalone or
                # "Other Apps" embedded in --serve) or a row picked
                # straight out of a top-level menu-mode search merge (see
                # _matching_app_rows()/on_search_changed()) - checked by
                # the value's own shape rather than self.mode, since the
                # latter is "menu" in that last case. Ordinary menu-mode
                # values are always plain breadcrumb strings and
                # windows-mode values are Wnck.Window objects, so neither
                # can ever hit this branch by mistake.
                exec_tokens, desktop_id = value
                launch_app(exec_tokens)
                record_app_usage(desktop_id)
                if self.on_result is not None:
                    # Other Apps embedded in --serve mode (see
                    # show_other_apps_menu() in ohmydebn-menu): a real pick here
                    # is a leaf action exactly like any other menu-mode
                    # leaf, so it goes through the same deferred-close/
                    # on_result round trip instead of falling through to
                    # the unconditional Gtk.main_quit() below, which is
                    # only correct for the standalone one-shot launcher
                    # (on_result is None there). desktop_id is sent back
                    # only as a non-empty marker - bash's case arm only
                    # ever checks it against "" (cancelled) - the actual
                    # launch already happened above.
                    self._schedule_close()
                    self.on_result(desktop_id)
                    return
            elif self.mode == "windows":
                activate_window(value)
            elif self.on_result is not None:
                # Doesn't quit outright here, in case reload() brings this
                # window back for whatever screen comes next - but if
                # nothing does, this process has no reason to keep running
                # at all: bin/ohmydebn-menu never loops back to show_main_menu,
                # so a pick with no reload() following it means the whole
                # script is headed for its natural end (and its EXIT trap)
                # anyway, whether or not what it just launched (About,
                # Demo, ...) is still open - see _schedule_close() for why
                # this is deferred instead of decided immediately (the
                # picker can't tell "submenu" from "leaf" from the picked
                # label alone; only bash's own case statement, which runs
                # after this call already returned, knows that).
                self._schedule_close()
                self.on_result(value)
                return  # stay open - reload() handles the next request
            else:
                print(value)
        elif self.on_result is not None:
            # Escape/click-away within one --serve request still needs a
            # response, or the driver's blocking read on the other end of
            # this request's response pipe would hang forever. Many
            # case-statement fallback arms in bin/ohmydebn-menu re-open the
            # same or parent menu on an empty result, so this can be just
            # as fast a round-trip as a real pick - same deferred close.
            self._schedule_close()
            self.on_result("")
            return
        Gtk.main_quit()

    # --serve mode only. Called at pick time, when the picker itself has no
    # way to know yet whether the bash side is about to call reload() again
    # (drilling into/back out to another submenu - the common case, and
    # fast: no process spawn, no external command, just local pipe I/O) or
    # run some real synchronous command first, with this session's picker
    # never needed again (the case this exists for). Deferring the close
    # behind a short timeout and having reload() cancel it (below) means
    # the common case never even hides, let alone quits - populate() just
    # swaps the visible content in place - while the process for a real
    # leaf pick actually exits, rather than lingering hidden until
    # whatever it launched eventually closes and the whole ohmydebn-menu
    # script's EXIT trap finally reaps it. 120ms: comfortably past every
    # observed local round-trip (FIFO write + bash's read/case dispatch +
    # FIFO write back, all local pipe I/O - no process spawn on this path),
    # while still short enough that a genuine external launch never reads
    # as "stuck open".
    CLOSE_DELAY_MS = 120

    def _schedule_close(self):
        if self._pending_close_id is None:
            self._pending_close_id = GLib.timeout_add(self.CLOSE_DELAY_MS, self._deferred_close)

    def _deferred_close(self):
        self._pending_close_id = None
        # No self.hide() first - Gtk.main_quit() unwinds run_serve_mode's
        # Gtk.main() call, which closes both FIFOs and lets the process
        # exit, taking the window down with it. Exactly what the original,
        # pre-persistent-picker one-shot finish() already did on a real
        # pick (fall through to this same Gtk.main_quit() with no hide()
        # of its own) - that was never the source of the "stays visible"
        # report; only --serve mode's finish() returning early to stay
        # alive, unconditionally, was.
        Gtk.main_quit()
        return GLib.SOURCE_REMOVE


def run_serve_mode(request_fifo_path, response_fifo_path):
    """The persistent-picker mechanism bin/ohmydebn-menu's menu() talks to
    (see the profiling that motivated this: ~90-140ms of every menu-level
    transition was GTK/PyGObject import cost alone, paid fresh by every
    single ohmydebn-menu-picker process spawn): one process, one window,
    reused across requests via reload() instead of a fresh process+import
    per menu level.

    Protocol, both FIFOs newline-delimited text: a request line is
    "breadcrumb_prefix<TAB>go_items<TAB>mode" (go_items already carries
    literal "\\n" two-character sequences the same way menu()'s own options
    string always has - never real newline bytes - so one line is
    unambiguous); mode is "apps" for show_other_apps_menu()'s
    Other-Apps-as-a-submenu requests, or omitted (an ordinary two-field
    line, from every
    other, unmodified show_*_menu call through menu()) for the default
    "menu"; a response line is the picked label, or empty for cancel; the
    literal request line "QUIT" ends the session. The response FIFO is
    opened for writing before the request FIFO is opened for reading, since
    opening a FIFO for reading blocks until a writer exists on the other
    end.
    """
    response_fifo = open(response_fifo_path, "w", buffering=1)

    def send_response(value):
        response_fifo.write((value or "") + "\n")
        response_fifo.flush()

    win = Picker(mode="menu", on_result=send_response)

    def on_request_ready(fileobj, _condition):
        line = fileobj.readline()
        if not line or line.rstrip("\n") == "QUIT":
            Gtk.main_quit()
            return GLib.SOURCE_REMOVE
        breadcrumb_prefix, _, remainder = line.rstrip("\n").partition("\t")
        go_items, _, mode = remainder.partition("\t")
        mode = mode or "menu"
        t0 = time.monotonic()
        win.reload(go_items, breadcrumb_prefix, mode)
        print(f"[timing] reload({breadcrumb_prefix!r}) took {(time.monotonic() - t0) * 1000:.1f}ms", file=sys.stderr, flush=True)
        return GLib.SOURCE_CONTINUE

    request_fifo = open(request_fifo_path, "r")
    GLib.io_add_watch(request_fifo, GLib.IO_IN, on_request_ready)

    win.show_all()
    Gtk.main()
    # Defensive, not load-bearing in the common case (every real pick/
    # cancel already goes through _start_icon_loading()'s own shutdown or
    # this batch's own once its queue drains): only actually matters if the
    # whole session ends (QUIT, or this process killed outright) while
    # "Other Apps" is still mid-icon-load, which would otherwise leave an
    # un-shut-down pool for the interpreter's own atexit handling to block
    # on joining.
    if win._icon_pool is not None:
        win._icon_pool.shutdown(wait=False)
    response_fifo.close()
    request_fifo.close()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--apps":
        win = Picker(mode="apps")
    elif len(sys.argv) > 1 and sys.argv[1] == "--windows":
        win = Picker(mode="windows")
    elif len(sys.argv) > 1 and sys.argv[1] == "--serve":
        run_serve_mode(sys.argv[2], sys.argv[3])
        sys.exit(0)
    else:
        go_items_arg = sys.argv[1] if len(sys.argv) > 1 else ""
        breadcrumb_prefix_arg = sys.argv[2] if len(sys.argv) > 2 else ""
        win = Picker(go_items_arg, breadcrumb_prefix_arg)
    win.show_all()
    Gtk.main()
    sys.exit(0)
