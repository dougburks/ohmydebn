#!/bin/bash

set -euo pipefail

# Without systemd its service never runs (see ohmydebn-require-systemd),
# so the installer's window opens to say why, even when it's installed,
# rather than a tray icon that can't connect.
SYSTEMD_DIR=/run/systemd/system
if [ ! -d "$SYSTEMD_DIR" ] || ! dpkg -s "tailscale" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Tailscale" /usr/share/ohmydebn/bin/ohmydebn-tailscale-install
fi

if [ -d "$SYSTEMD_DIR" ] && dpkg -s "tailscale" >/dev/null 2>&1; then
  /usr/bin/tailscale systray
fi
