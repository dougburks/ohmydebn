#!/usr/bin/env bash

set -euo pipefail

/usr/bin/alacritty "$@" &
PID=$!

# Sleeping for 0.2s works on some systems but other systems need 0.4s
/usr/bin/sleep 0.4

/usr/bin/xdotool windowactivate $(/usr/bin/xdotool search --pid $PID | tail -n 1)

# Wait for the terminal to close so callers can depend on completion
wait $PID
