#!/bin/bash
set -euo pipefail

# ohmydebn-theme-set: Set a theme, specified by its name.
# Usage: ohmydebn-theme-set [--background <arg>] <theme-name>
#   <arg> can be "random" or a number (1-based index)

BG_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
  --background)
    if [[ $# -lt 2 ]]; then
      echo "Usage: ohmydebn-theme-set [--background <arg>] <theme-name>" >&2
      exit 1
    fi
    BG_ARG="$2"
    shift 2
    ;;
  *) break ;;
  esac
done

if [[ -z "${1:-}" ]]; then
  echo "Usage: ohmydebn-theme-set [--background <arg>] <theme-name>" >&2
  exit 1
fi

# Remove all old symlinks from themes dir except aether
THEMES_DIR="$HOME/.config/ohmydebn/themes"
find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type l ! -name aether -print0 | while read -r -d '' LINK; do
  rm -f "$LINK"
done

# Now that the old theme config has been cleaned up, proceed with setting new theme
CURRENT_THEME_PATH="$HOME/.config/ohmydebn/current/theme"
NEXT_THEME_PATH="$HOME/.config/ohmydebn/current/next-theme"
USER_THEMES_PATH="$HOME/.config/ohmydebn/themes"
OHMYDEBN_THEMES_PATH="/usr/share/ohmydebn-themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ -d "$USER_THEMES_PATH/$THEME_NAME" ]]; then
  THEME_PATH="$USER_THEMES_PATH/$THEME_NAME"
elif [[ -d "$OHMYDEBN_THEMES_PATH/$THEME_NAME" ]]; then
  THEME_PATH="$OHMYDEBN_THEMES_PATH/$THEME_NAME"
else
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

if [[ ! -f "$THEME_PATH/colors.toml" && ! -f "$THEME_PATH/alacritty.toml" ]]; then
  echo "Theme '$THEME_NAME' does not have colors.toml or alacritty.toml"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy static configs
find -L "$THEME_PATH" -mindepth 1 -maxdepth 1 -exec cp -r {} "$NEXT_THEME_PATH/" \; 2>/dev/null || true

# Resolve theme colors now (handles legacy colors.toml, Omarchy 4+ semantic
# colors.toml, and alacritty.toml-derived themes) so templates below and
# every downstream theming script see the same, normalized set of keys.
COLORS_SOURCE=$(/usr/share/ohmydebn/bin/ohmydebn-theme-set-colors "$THEME_PATH")
if [[ -n "$COLORS_SOURCE" && "$COLORS_SOURCE" != "$NEXT_THEME_PATH/colors.toml" ]]; then
  cp "$COLORS_SOURCE" "$NEXT_THEME_PATH/colors.toml"
fi

# Generate dynamic configs
/usr/share/ohmydebn/bin/ohmydebn-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/ohmydebn/current/theme.name"

# Determine light or dark mode. Omarchy 4+ themes signal this with a `mode`
# key in colors.toml; older themes use a light.mode marker file instead.
IS_LIGHT_MODE="false"
CURRENT_COLORS_TOML="$HOME/.config/ohmydebn/current/theme/colors.toml"
if [[ -f "$CURRENT_COLORS_TOML" ]] && grep -qE '^\s*mode\s*=\s*"light"' "$CURRENT_COLORS_TOML"; then
  IS_LIGHT_MODE="true"
elif [ -f "$HOME/.config/ohmydebn/current/theme/light.mode" ]; then
  IS_LIGHT_MODE="true"
fi

if [[ "$IS_LIGHT_MODE" == "true" ]]; then
  gsettings set org.x.apps.portal color-scheme "prefer-light"
else
  gsettings set org.x.apps.portal color-scheme "prefer-dark"
fi

# Set new background
if [[ -n "$BG_ARG" ]]; then
  /usr/share/ohmydebn/bin/ohmydebn-theme-bg-next --background "$BG_ARG"
else
  /usr/share/ohmydebn/bin/ohmydebn-theme-bg-next
fi

# Use COLORS_SOURCE to update cinnamon and gtk themes
/usr/share/ohmydebn/bin/ohmydebn-theme-set-cinnamon "$THEME_NAME" "$COLORS_SOURCE" "$IS_LIGHT_MODE"

# Use COLORS_SOURCE to update the GTK pickers' own color file
/usr/share/ohmydebn/bin/ohmydebn-theme-set-picker "$COLORS_SOURCE"

# Use COLORS_SOURCE to update the Claude Code theme
/usr/share/ohmydebn/bin/ohmydebn-theme-set-claude "$THEME_NAME" "$COLORS_SOURCE" "$IS_LIGHT_MODE"

# If COLORS_SOURCE was dynamically generated, delete it
/usr/share/ohmydebn/bin/ohmydebn-theme-set-colors-delete "$COLORS_SOURCE"

# Set all remaining themes
/usr/share/ohmydebn/bin/ohmydebn-theme-set-icon
/usr/share/ohmydebn/bin/ohmydebn-theme-set-terminal "$IS_LIGHT_MODE"
/usr/share/ohmydebn/bin/ohmydebn-theme-set-btop
/usr/share/ohmydebn/bin/ohmydebn-theme-set-gedit
/usr/share/ohmydebn/bin/ohmydebn-theme-set-starship
/usr/share/ohmydebn/bin/ohmydebn-theme-set-antigravity
/usr/share/ohmydebn/bin/ohmydebn-theme-set-cava
/usr/share/ohmydebn/bin/ohmydebn-theme-set-eza
/usr/share/ohmydebn/bin/ohmydebn-theme-set-fastfetch
/usr/share/ohmydebn/bin/ohmydebn-theme-set-opencode
/usr/share/ohmydebn/bin/ohmydebn-theme-set-vscode
