#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

# Repository handling lives in ohmydebn-brave-repo (shared with the other
# Brave variant): it adds Brave's apt source only when no source for it
# exists yet, so a distro that already ships Brave from Brave's own
# repository (LCOS, via its brave.list) never gets a duplicate source.
if ! dpkg -s "brave-browser" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Brave Browser is not currently installed."
    echo
    echo "Continuing will install it from:"
    echo "https://brave-browser-apt-release.s3.brave.com"
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  /usr/share/ohmydebn/bin/ohmydebn-brave-repo ensure
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install brave-browser
elif ! /usr/share/ohmydebn/bin/ohmydebn-brave-repo is-configured; then
  # Installed, but from a bare .deb with no repository behind it - add
  # Brave's so it actually receives updates.
  /usr/share/ohmydebn/bin/ohmydebn-brave-repo ensure
fi

# OhMyDebn's profile seed (follow the system light/dark theme, no
# content-setting exceptions), whichever way the package arrived - but only
# for a user who has never run it: an existing profile is theirs and is
# never overwritten. Used to be gated on the package being absent instead,
# which skipped it entirely on a distro that ships Brave Browser.
if dpkg -s "brave-browser" >/dev/null 2>&1 && [ ! -d ~/.config/BraveSoftware/Brave-Browser ]; then
  mkdir -p ~/.config/BraveSoftware
  cp -av /usr/share/ohmydebn/config/BraveSoftware/Brave-Browser ~/.config/BraveSoftware/
fi
