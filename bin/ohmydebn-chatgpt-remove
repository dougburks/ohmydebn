#!/bin/bash

set -euo pipefail

if ! dpkg -s "chatgpt" >/dev/null 2>&1; then
  echo
  echo "ChatGPT is not currently installed."
else
  if [ "${1:-}" != "--skip-prompt" ]; then
    echo
    echo "Continuing will remove ChatGPT and its repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo /usr/bin/apt update
  # The purge runs ChatGPT's own postrm, which removes the repo it added
  # (chatgpt.sources) and its keyring; the pin is OhMyDebn's to remove.
  sudo /usr/bin/apt -y purge chatgpt
  sudo /usr/bin/apt -y autoremove
  sudo rm -f /etc/apt/preferences.d/chatgpt.pref
fi
