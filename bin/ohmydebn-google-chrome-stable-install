#!/bin/bash

set -euo pipefail

if ! dpkg -s "google-chrome-stable" >/dev/null 2>&1; then
  ARCH=$(uname -m)
  if [ "$ARCH" != "x86_64" ]; then
    echo
    echo "Sorry, Google does not provide a Chrome package for your architecture!"
    exit 1
  fi

  echo
  echo "Google Chrome is not currently installed."
  echo
  echo "Continuing will install it from:"
  echo "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r

  TEMP=$(mktemp)
  echo "Downloading Google Chrome..."
  curl -fSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o "$TEMP"
  sudo /usr/bin/dpkg -i "$TEMP"
  rm -f "$TEMP"

  # Google Chrome's own postinst self-registers dl.google.com as an apt
  # source (see /etc/apt/sources.list.d/google-chrome.sources) - same
  # reasoning/pattern as ohmydebn-code-install's own pin: ohmydebn never
  # creates that source file itself, so restricting it has to happen
  # here instead. Confirmed via `apt-cache depends google-chrome-stable` -
  # no same-repo dependency, just ordinary system libraries.
  printf 'Package: *\nPin: origin "dl.google.com"\nPin-Priority: -1\n\nPackage: google-chrome-stable\nPin: origin "dl.google.com"\nPin-Priority: 500\n' |
    sudo tee /etc/apt/preferences.d/google-chrome.pref >/dev/null

  # Installed onto a system that already has a default browser: ask before
  # taking it over (defaults to no - see ohmydebn-browser-set-default). A
  # setting that couldn't be applied is reported there and mustn't abort
  # the install.
  /usr/share/ohmydebn/bin/ohmydebn-browser-set-default --ask google-chrome-stable || true
fi
