#!/bin/bash

# Tolerate the old 2-arg calling convention (processor, text) as well as
# the current 1-arg form (text): an apt upgrade can replace this file
# mid-update while an old, not-yet-upgraded caller script is still running,
# so a straight $1-only read would print the old processor argument ("cat")
# instead of the real message if that old/new mismatch happens.
if [[ $# -ge 2 ]]; then
  TEXT="$2"
else
  TEXT="$1"
fi

# A timestamp line inside the banner, so an update log answers "which
# stage took the time" at a glance: wall clock, plus elapsed since the run
# started when the caller exported OHMYDEBN_RUN_START (install.sh and
# ohmydebn-update do; a headline printed on its own just shows the clock).
# It goes BETWEEN the title and the closing fence on purpose:
# ohmydebn-update-gui's stage parser takes the line immediately after a
# fence as the stage title and ignores what follows until the next fence,
# so the title stays clean and the stamp is never mistaken for a stage.
STAMP=$(date '+%H:%M:%S')
if [[ "${OHMYDEBN_RUN_START:-}" =~ ^[0-9]+$ ]]; then
  ELAPSED=$((EPOCHSECONDS - OHMYDEBN_RUN_START))
  ((ELAPSED < 0)) && ELAPSED=0
  STAMP=$(printf '%s  +%02d:%02d' "$STAMP" $((ELAPSED / 60)) $((ELAPSED % 60)))
fi

echo
cat <<EOF2
####################################################################
$TEXT
$STAMP
####################################################################
EOF2
echo
