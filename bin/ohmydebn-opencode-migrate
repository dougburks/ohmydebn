#!/bin/bash

set -euo pipefail

# If old package is installed, then remove it and install the new one
if dpkg -s "open-code" >/dev/null 2>&1; then
  echo
  echo "Removing old open-code package."
  echo
  sudo apt purge -y open-code
  echo
  echo "Installing new ohmydebn-opencode-cli package."
  echo
  /usr/share/ohmydebn/bin/ohmydebn-opencode-install --skip-prompt
fi
