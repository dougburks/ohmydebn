#!/bin/bash
#
# fastfetch composites its logo and info panel with relative cursor-movement
# escape codes, not padded text, so resizing the window mid-render leaves the
# terminal's own reflow fighting those fixed column offsets - the info panel
# visibly tears. Re-clearing and re-running on every size change is the fix
# (same technique Omarchy's own about-screen script uses for this).
#
# Also re-renders on SIGUSR2, so ohmydebn-theme-set-fastfetch can refresh an
# already-open window in place after a theme change, instead of leaving it
# showing stale colors until closed and reopened - same hot-reload
# convention as btop/cava/opencode-cli's own ohmydebn-theme-set-* scripts.
# PID_FILE lets that script target this exact process with `kill` rather
# than `pkill`: pkill's plain name match can't reach a 25-char script name
# (comm is truncated to 15 chars), and `pkill -f` cmdline matching would
# also hit the parent alacritty process, since its own argv includes this
# script's path as the -e target.

PID_FILE=~/.cache/ohmydebn/fastfetch-pause.pid
mkdir -p "$(dirname "$PID_FILE")"
echo $$ >"$PID_FILE"
# Only while it's still ours: with two windows open the second writes its
# own PID here, and the first closing used to delete it, so a theme change
# no longer refreshed the window still open.
trap '[ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ] && rm -f "$PID_FILE"' EXIT
# Exit through a trap on the signals that close the window. Without one,
# bash 5.2 sometimes drops a SIGTERM that lands during the timed read
# below and keeps looping (seen as test-fastfetch-pause.sh hanging about
# one run in five).
trap 'exit 0' TERM HUP INT

render() {
  clear
  /usr/share/ohmydebn/bin/ohmydebn-fastfetch
}

trap 'SIZE=$(stty size); render' USR2

SIZE=$(stty size)
render

# A read that fails for any reason other than its timeout or a signal
# (status > 128) is end-of-file - no terminal any more - and ends the loop
# instead of spinning on it, as ohmydebn-logo's does.
while :; do
  read -t 0.5 -n 1 -s && break
  [ $? -gt 128 ] || break
  CURRENT_SIZE=$(stty size)
  if [[ "$CURRENT_SIZE" != "$SIZE" ]]; then
    SIZE="$CURRENT_SIZE"
    render
  fi
done
