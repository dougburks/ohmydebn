#!/bin/bash

set -euo pipefail

export PATH="/usr/share/ohmydebn/bin:$PATH"

source /usr/share/ohmydebn/bin/ohmydebn-menu-tree

# Set to true when going directly to a submenu, so we can exit directly
DIRECT_ACCESS=false

# Segments queued up by menu() when a search inside one submenu resolves to
# a descendant reached through further submenus - see menu()'s comment. A
# FILE rather than a shell variable/array - originally because every
# show_*_menu called menu() inside `case $(menu ...) in`, a command
# substitution subshell whose changes to a shell variable (even a global,
# non-local one) never propagate back out once it exits, confirmed
# empirically at the time (a trivial
# `QUEUE=(x); f() { QUEUE=(y); }; $(f); echo "${QUEUE[*]}"` still printed
# the pre-call value). menu() itself is a plain call now (see its own
# comment on why), so that specific reason no longer applies - kept as a
# file anyway, since it already works and changing it isn't part of what
# that change was for. One queued segment per line; cleaned up on exit
# since it's specific to this single invocation of ohmydebn-menu.
MENU_JUMP_QUEUE_FILE=$(mktemp)

# --- Persistent picker: started once, here, eagerly - not lazily from
# inside menu()/get_picker_result. Originally this was required: menu()
# used to run inside a `$(menu ...)` subshell (every show_*_menu called it
# that way, same as MENU_JUMP_QUEUE_FILE above needing to be a file rather
# than a variable for exactly this reason), and a file descriptor opened
# via `exec {FD}<>...` *inside* that subshell would vanish the moment the
# subshell exited, so a lazy first-use start from in there could never be
# seen by any later menu() call. menu() is a plain call now (see its own
# comment on why), so that specific reason no longer applies - kept eager
# anyway, since it already works and changing it isn't part of what that
# change was for.
#
# One picker per ohmydebn-menu invocation, not a system-wide daemon -
# reuses one already-warm process/window across every menu() call in this
# session instead of ohmydebn-menu-picker's GTK/PyGObject import cost
# (profiled at ~90-140ms) being paid fresh by a brand-new process on every
# single menu level. Validated directly: two real transitions (Install,
# then Install > AI) cost ~220ms combined spawning fresh each time, ~45ms
# reusing one process via ohmydebn-menu-picker --serve.
PICKER_PID=""
PICKER_REQ_FD=""
PICKER_RESP_FD=""
PICKER_TMP_DIR=""

start_persistent_picker() {
  local dir req_fifo resp_fifo pid
  dir=$(mktemp -d) || return 1
  req_fifo="$dir/req"
  resp_fifo="$dir/resp"
  mkfifo "$req_fifo" "$resp_fifo" || {
    rm -rf "$dir"
    return 1
  }

  /usr/share/ohmydebn/bin/ohmydebn-menu-picker --serve "$req_fifo" "$resp_fifo" &
  pid=$!

  # Response side first, matching ohmydebn-menu-picker's own
  # run_serve_mode(), which opens its response-FIFO write end before its
  # request-FIFO read end: opening a FIFO end blocks until the other end
  # opens too, so opening these out of order on either side deadlocks
  # both. Any failure past this point kills the just-spawned process
  # explicitly - PICKER_PID is only ever set once everything it depends on
  # (both fds) is confirmed open, so a partial failure can't leave this
  # session thinking a picker is ready when its fds never actually came up.
  #
  # Opening the response FIFO for read blocks until a writer opens it -
  # normally that's the picker itself, almost immediately (real GTK
  # startup profiled at ~90-140ms). If the picker fails before ever
  # getting there (crashes, missing dependency, bad args), nothing would
  # ever open the write end and this would hang forever - confirmed the
  # hard way, in this exact spot, before this watchdog existed. It gives
  # the picker 3 real seconds; only if the process has already exited by
  # then does it open-and-immediately-close the write end itself, which is
  # just enough to unblock the read-open below with nothing real behind
  # it, so it comes back with an fd whose very next read is empty/EOF
  # instead of a hang. (Not used again below for the request FIFO: by the
  # time the response FIFO is confirmed open, the picker has necessarily
  # moved on to opening its own read end of the request FIFO next - see
  # run_serve_mode - so that open has nothing comparable to hang on.)
  (
    sleep 3
    kill -0 "$pid" 2>/dev/null || : >"$resp_fifo"
  ) &
  local watchdog_pid=$!

  exec {PICKER_RESP_FD}<"$resp_fifo"
  local resp_open_status=$?
  kill "$watchdog_pid" 2>/dev/null
  wait "$watchdog_pid" 2>/dev/null

  if [[ $resp_open_status -ne 0 ]] || ! kill -0 "$pid" 2>/dev/null; then
    exec {PICKER_RESP_FD}<&- 2>/dev/null
    kill -9 "$pid" 2>/dev/null
    rm -rf "$dir"
    return 1
  fi

  exec {PICKER_REQ_FD}>"$req_fifo" || {
    kill -9 "$pid" 2>/dev/null
    exec {PICKER_RESP_FD}<&- 2>/dev/null
    rm -rf "$dir"
    return 1
  }

  PICKER_PID=$pid
  PICKER_TMP_DIR="$dir"
}

# Closes this session's picker down: tells it to quit (if it's still
# alive), releases the held-open fds, and removes the per-session temp
# dir. Safe to call even when no picker ever successfully started (e.g.
# start_persistent_picker failed at script startup) - every step is
# individually guarded rather than relying on this whole function's own
# success/failure, since it also runs from the EXIT trap, where a failing
# cleanup step must never stop the rest of cleanup from running.
stop_persistent_picker() {
  if [[ -n "$PICKER_PID" ]] && kill -0 "$PICKER_PID" 2>/dev/null; then
    printf 'QUIT\n' >&"$PICKER_REQ_FD" || true
  fi
  [[ -n "${PICKER_REQ_FD:-}" ]] && {
    exec {PICKER_REQ_FD}>&- 2>/dev/null || true
  }
  [[ -n "${PICKER_RESP_FD:-}" ]] && {
    exec {PICKER_RESP_FD}<&- 2>/dev/null || true
  }
  [[ -n "$PICKER_TMP_DIR" ]] && rm -rf "$PICKER_TMP_DIR" 2>/dev/null
  PICKER_PID=""
}

# Captured once, here, before the picker (persistent or any later one-shot
# fallback) ever appears - this is the window that will transiently
# regain focus the moment the picker closes (its own close is deferred,
# see ohmydebn-menu-picker's CLOSE_DELAY_MS comment), before whatever a
# leaf pick actually launches has opened its own window. If a case arm
# below launches one of the *-tiled scripts, that script's own
# ohmydebn-launch-tiled call needs to know this ID so it doesn't mistake
# the picker closing and this window transiently regaining focus for the
# launched app appearing - see ohmydebn-launch-tiled's own comment on
# OHMYDEBN_LAUNCH_TILED_EXCLUDE_WIN. Note this is NOT the picker's own
# window - that's already excluded for free, since it's what
# ohmydebn-launch-tiled's own PREV_WIN capture sees moments later while
# the picker is still up.
export OHMYDEBN_LAUNCH_TILED_EXCLUDE_WIN
OHMYDEBN_LAUNCH_TILED_EXCLUDE_WIN=$(/usr/bin/xdotool getactivewindow 2>/dev/null) || true

start_persistent_picker || true # non-fatal: get_picker_result below falls back to a one-shot spawn for the whole session if this didn't work

trap 'rm -f "$MENU_JUMP_QUEUE_FILE"; stop_persistent_picker' EXIT

# Belt-and-suspenders, not the primary fix: menu()/get_picker_result no
# longer wrap the long "wait for the picker's response" block in `$(...)`
# (see menu()'s own comment for why - that was the actual bug: an
# external signal to this top-level PID would kill this process while a
# `$(menu ...)` subshell, still blocked on the picker mid-request, lived
# on as an orphan holding the picker's fds open, so the picker never saw
# the EOF it needed to notice its session was over). What's left after
# that fix is only ever short-lived - the brief `$(...)` calls for the
# breadcrumb lookup and the backgrounded-read's own result file, nothing
# that blocks on a human decision - but `kill -- -$$` (the whole process
# group, not just this PID) costs nothing to keep as a safety net for
# whatever that narrow a window still leaves. It also only works if this
# process is its own process group leader, which isn't guaranteed by every
# way this script can be launched - so the picker is also killed directly
# by its tracked PID, which doesn't depend on that.
trap '[[ -n "$PICKER_PID" ]] && kill -9 "$PICKER_PID" 2>/dev/null; kill -- -$$ 2>/dev/null; exit 143' TERM INT

# Talks to the persistent picker for one request if it's running and
# responsive, falling back to a direct one-shot spawn - today's original
# mechanism, entirely unchanged - for just this pick otherwise (never
# started, has since died, or stopped answering). Deliberately does not
# try to restart the persistent picker here - once gone, a picker stays
# gone for the rest of this session, which only costs the speed benefit
# for whatever's left of it, never correctness. Neither this function nor
# menu() runs inside a subshell (see menu()'s own comment on why that
# matters for signal handling), so restarting here would actually work
# now, unlike in an earlier version of this - left out anyway, on purpose,
# to keep this change's scope to the signal-handling fix it was for.
#
# 300s on the response read is deliberately generous: sized so that no
# real human decision - which can legitimately take minutes - is ever
# mistaken for a wedged picker; only one that's genuinely stopped
# responding falls through to the fallback in practice.
get_picker_result() {
  local options="$1" breadcrumb_prefix="$2"

  if [[ -z "$PICKER_PID" ]] || ! kill -0 "$PICKER_PID" 2>/dev/null; then
    MENU_PICKER_RESULT=$(/usr/share/ohmydebn/bin/ohmydebn-menu-picker "$options" "$breadcrumb_prefix")
    return
  fi

  if ! printf '%s\t%s\n' "$breadcrumb_prefix" "$options" >&"$PICKER_REQ_FD"; then
    MENU_PICKER_RESULT=$(/usr/share/ohmydebn/bin/ohmydebn-menu-picker "$options" "$breadcrumb_prefix")
    return
  fi

  # The actual wait for the picker's answer happens via the `wait` builtin
  # on a backgrounded read, not a bare `read -t 300 -u "$PICKER_RESP_FD"`
  # here directly - confirmed by hand (see the TERM/INT trap's own
  # comment) that only the former lets a trapped signal interrupt it
  # promptly; bash defers trap processing for as long as it's blocked
  # waiting on a command-substitution subshell, however that subshell
  # spends its own time, and this whole call is now itself a plain
  # statement (see menu()'s comment for why), not one - so a bare
  # long-blocking `read` right here would just move the exact same
  # problem down one level rather than fixing it.
  #
  # A backgrounded job can't hand a variable back directly (it's a
  # separate process) - the read result goes through a temp file, and
  # since an empty pick (cancel/Escape) is a legitimate, different outcome
  # than a timed-out/dead picker, the job exits with read's own status
  # (captured before anything else, so `set -e` here can't discard it)
  # rather than the caller trying to infer success from the file's
  # contents alone.
  local result_file
  result_file=$(mktemp)
  (
    local line status=0
    read -r -t 300 -u "$PICKER_RESP_FD" line || status=$?
    printf '%s' "$line" >"$result_file"
    exit "$status"
  ) &
  local read_pid=$!
  # `|| read_status=$?`, not a bare `wait` + `$?` afterward: this file runs
  # under `set -e`, and a bare `wait` returning nonzero (the crash/timeout
  # case this is here to handle) would abort the whole script right here
  # instead of falling through to the one-shot fallback below.
  local read_status=0
  wait "$read_pid" || read_status=$?

  if [[ $read_status -eq 0 ]]; then
    MENU_PICKER_RESULT=$(<"$result_file")
    rm -f "$result_file"
  else
    rm -f "$result_file"
    MENU_PICKER_RESULT=$(/usr/share/ohmydebn/bin/ohmydebn-menu-picker "$options" "$breadcrumb_prefix")
  fi
}

# show_other_apps_menu()'s own talk-to-the-persistent-picker call,
# deliberately not folded into get_picker_result() above even though most
# of its body is a copy of it: this asks the SAME running picker to show
# "Other Apps" as a real level of the menu tree (mode=apps over the
# 3-field request line ohmydebn-menu-picker's run_serve_mode() understands
# - see its own docstring) instead of spawning ohmydebn-app-launcher as a
# wholly separate one-shot process the way this used to work. That's what
# makes Left-arrow/Escape-back-to-Apps possible from inside Other Apps:
# cancelling out just replies empty, exactly like backing out of any other
# submenu does, and show_other_apps_menu() below re-opens show_apps_menu
# on that same empty result. A real app pick launches directly from
# inside the picker itself (see ohmydebn-menu-picker's finish()) - the
# non-empty desktop_id it replies with here is never inspected for
# content, only for not-being-"" (see show_other_apps_menu()).
#
# Falls back to the original standalone launcher when the persistent
# picker isn't running/responsive, matching every other call site's
# one-shot-fallback convention - but that fallback can't distinguish "user
# picked an app" from "user cancelled" (ohmydebn-app-launcher reports
# neither back), so it's always treated as a non-empty/terminal result:
# this whole ohmydebn-menu script ends afterward either way, exactly
# matching this feature's pre-existing behavior before Other Apps became a
# real submenu.
get_apps_picker_result() {
  if [[ -z "$PICKER_PID" ]] || ! kill -0 "$PICKER_PID" 2>/dev/null; then
    /usr/share/ohmydebn/bin/ohmydebn-app-launcher
    MENU_PICKER_RESULT="launched"
    return
  fi

  if ! printf '%s\t%s\t%s\n' "Apps > Other Apps" "" "apps" >&"$PICKER_REQ_FD"; then
    /usr/share/ohmydebn/bin/ohmydebn-app-launcher
    MENU_PICKER_RESULT="launched"
    return
  fi

  # Same backgrounded-read approach as get_picker_result() - see its own
  # comment for why this can't just be a bare blocking `read` here.
  local result_file
  result_file=$(mktemp)
  (
    local line status=0
    read -r -t 300 -u "$PICKER_RESP_FD" line || status=$?
    printf '%s' "$line" >"$result_file"
    exit "$status"
  ) &
  local read_pid=$!
  local read_status=0
  wait "$read_pid" || read_status=$?

  if [[ $read_status -eq 0 ]]; then
    MENU_PICKER_RESULT=$(<"$result_file")
    rm -f "$result_file"
  else
    rm -f "$result_file"
    /usr/share/ohmydebn/bin/ohmydebn-app-launcher
    MENU_PICKER_RESULT="launched"
  fi
}

back_to() {
  local parent_menu="$1"

  # Must never call menu() itself, directly or indirectly - menu() finds
  # its caller via ${FUNCNAME[1]}, and back_to() calling "$parent_menu" as
  # a plain function call (confirmed, not eval, not through a subshell)
  # is exactly what keeps that name correct. A wrapper between a
  # show_*_menu function and its own menu() call would break that lookup.
  if [[ "$DIRECT_ACCESS" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

# menu() is a plain statement now (`menu "Title" "items"`, result read back
# from $MENU_RESULT afterward), not `case $(menu ...) in` - that changed
# for one reason: `$(...)` command substitution makes bash wait for the
# substituted call to finish before it will process a pending trapped
# signal (TERM/INT above), confirmed by hand with a minimal reproduction
# (a trapped TERM sent to a script blocked in `x=$(sleep 30)` never ran
# the trap at all; the same script blocked in `sleep 30 & wait $!` ran it
# within about a second). Since resolving one menu() call can mean
# blocking for as long as a human takes to decide - the whole reason
# get_picker_result waits via `wait` on a backgrounded read rather than a
# bare blocking read, see its own comment - $(...) here would have handed
# right back the exact orphaned-picker problem that comment describes,
# just one layer further out. Every one of this file's ~21 call sites
# changed together with this function for that reason.
#
# menu() is the one place that resolves a search into a descendant several
# levels down, so every show_*_menu function's own case statement (matching
# a label from $MENU_RESULT against a target - see show_learn_menu below
# for the plainest example) never has to change - it only ever receives a
# bare, same-level label back, whether that came from a direct pick or
# from unwinding a queued multi-hop search.
#
# If the queue file is non-empty, a previous call already resolved a
# search and queued the remaining path segments - pop the next line and
# return it immediately, with no picker shown at all. That's what makes a
# multi-level jump feel instant: each intermediate show_*_menu's own
# unmodified case arm fires as a completely normal function call (not
# inside a subshell), so the real target only ever actually runs once
# everything has unwound naturally back to the deepest level.
#
# (Note: eval'ing the target directly here and exit-ing was the first
# design and it's broken - confirmed empirically, back when every
# show_*_menu called menu() inside `case $(menu ...) in`: `exit` inside
# menu() only killed that subshell, so the calling case statement's
# `*) ...` fallback arm still fired afterward, popping an unwanted extra
# menu on top of whatever the eval'd command already did.)
#
# Otherwise, look up the calling function's breadcrumb prefix (empty if
# not found, e.g. show_main_menu - which is the "top of tree, no
# filtering" case) and show the picker scoped to it. A result containing
# " > " is always the full absolute breadcrumb of a searched descendant
# (ohmydebn-menu-picker's contract) - strip the prefix, split on " > ",
# set $MENU_RESULT to the first segment now and queue the rest. A plain
# result (no " > ") is an ordinary same-level pick, set unchanged exactly
# like before this feature existed.
menu() {
  # prompt ($1) is accepted but unused - kept so all ~21 existing
  # `menu "Title" "items"` call sites don't need editing further, even
  # though ohmydebn-menu-picker doesn't currently show a title anywhere
  # (no titlebar; the window is undecorated).
  # shellcheck disable=SC2034
  local prompt="$1"
  local options="$2"

  if [[ -s "$MENU_JUMP_QUEUE_FILE" ]]; then
    local head rest_file
    head=$(head -n1 "$MENU_JUMP_QUEUE_FILE")
    rest_file=$(mktemp)
    tail -n +2 "$MENU_JUMP_QUEUE_FILE" >"$rest_file"
    mv "$rest_file" "$MENU_JUMP_QUEUE_FILE"
    MENU_RESULT="$head"
    return
  fi

  local caller="${FUNCNAME[1]:-}"
  local breadcrumb_prefix=""
  if [[ -n "$caller" ]]; then
    breadcrumb_prefix=$(menu_tree_paths "${BASH_SOURCE[0]}" | awk -F'\t' -v f="$caller" '$1==f{print $2; exit}')
  fi

  get_picker_result "$options" "$breadcrumb_prefix"
  local result="$MENU_PICKER_RESULT"

  if [[ "$result" == *" > "* ]]; then
    # A searched descendant. ohmydebn-menu-picker always returns the full
    # absolute breadcrumb, so strip this call's own prefix off the front
    # when there is one (a nested submenu); at the top level
    # breadcrumb_prefix is empty and the whole result is already the
    # remainder to walk.
    local remainder="$result"
    if [[ -n "$breadcrumb_prefix" ]]; then
      remainder="${result#"$breadcrumb_prefix"" > "}"
    fi
    local first="${remainder%%" > "*}"
    local rest="${remainder#*" > "}"
    if [[ "$rest" != "$remainder" ]]; then
      # More than one segment left after "first" - one per line, so each
      # further menu() call (queue already empty at this point, checked
      # above) pops exactly one on its next call.
      printf '%s\n' "${rest//" > "/$'\n'}" >"$MENU_JUMP_QUEUE_FILE"
    fi
    MENU_RESULT="$first"
    return
  fi

  MENU_RESULT="$result"
}

terminal() {
  local title="$1"
  shift
  /usr/share/ohmydebn/bin/ohmydebn-terminal --class OhMyDebn --title "$title" -e "$@"
}

present_terminal() {
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "$1" "$2"
}

install() {
  local label pkg
  printf -v label '%q' "Installing $1..."
  printf -v pkg '%q' "$2"
  present_terminal "$1" "echo $label; sudo /usr/bin/apt -y install $pkg"
}

install_and_launch() {
  local label pkg launch
  printf -v label '%q' "Installing $1..."
  printf -v pkg '%q' "$2"
  printf -v launch '%q' "$3"
  present_terminal "$1" "echo $label; sudo /usr/bin/apt -y install $pkg && setsid gtk-launch $launch"
}

show_learn_menu() {
  menu "Learn" "  Keybindings\n  OhMyDebn\n  Cinnamon\n  Debian\n  Neovim\n󱆃  Bash"
  case "$MENU_RESULT" in
  *Keybindings*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://ohmydebn.org/hotkeys/" ;;
  *OhMyDebn*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://ohmydebn.org" ;;
  *Cinnamon*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://github.com/linuxmint/cinnamon" ;;
  *Debian*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://wiki.debian.org/" ;;
  *Bash*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  menu "Trigger" "  Capture\n󰓄  Speed Test"
  case "$MENU_RESULT" in
  *Capture*) show_capture_menu ;;
  *Speed*) show_speed_test_menu ;;
  *) show_main_menu ;;
  esac
}

show_speed_test_menu() {
  menu "Speed Test" "󰓄  Network Speed Test\n  Disk Speed Test"
  case "$MENU_RESULT" in
  *Network*) /usr/share/ohmydebn/bin/ohmydebn-network-speedtest-gui ;;
  *Disk*) /usr/share/ohmydebn/bin/ohmydebn-disk-speedtest-gui ;;
  *) show_trigger_menu ;;
  esac
}

show_capture_menu() {
  menu "Capture" "  Screenshot\n  Screenrecord\n󰃉  Color"
  case "$MENU_RESULT" in
  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Color*) /usr/bin/gcolor3 ;;
  *) show_trigger_menu ;;
  esac
}

show_screenshot_menu() {
  menu "Screenshot" "  Region\n  Window\n  Display"
  case "$MENU_RESULT" in
  *Region*) /usr/bin/xdotool key Shift+Print ;;
  *Window*) /usr/bin/xdotool key Alt+Print ;;
  *Display*) /usr/bin/xdotool key Print ;;
  *) show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  menu "Screenrecord" "  Cinnamon Recorder Start/Stop\n  SimpleScreenRecorder"
  case "$MENU_RESULT" in
  *Start*) /usr/bin/xdotool key Shift+Ctrl+Alt+R ;;
  *Simple*) /usr/share/ohmydebn/bin/ohmydebn-simplescreenrecorder ;;
  *) show_capture_menu ;;
  esac
}

show_install_menu() {
  menu "Install" "  Package\n  Web App\n  TUI"
  case "$MENU_RESULT" in
  *Package*) terminal "Install Package" /usr/share/ohmydebn/bin/ohmydebn-pkg-install ;;
  *Web*) present_terminal "Install Web App" /usr/share/ohmydebn/bin/ohmydebn-webapp-install ;;
  *TUI*) present_terminal "Install TUI App" /usr/share/ohmydebn/bin/ohmydebn-tui-install ;;
  *) show_main_menu ;;
  esac
}

show_office_menu() {
  menu "Office" "  LibreOffice Suite\n  Calligra Suite\n  Gnumeric\n  AbiWord"
  case "$MENU_RESULT" in
  *LibreOffice*) /usr/share/ohmydebn/bin/ohmydebn-libreoffice ;;
  *Calligra*) /usr/share/ohmydebn/bin/ohmydebn-calligra ;;
  *Gnumeric*) /usr/share/ohmydebn/bin/ohmydebn-gnumeric ;;
  *AbiWord*) /usr/share/ohmydebn/bin/ohmydebn-abiword ;;
  *) show_apps_menu ;;
  esac
}

show_cybersecurity_menu() {
  menu "Cybersecurity" "  SO-CRATES\n  tcpdump\n  tshark\n  wireshark"
  case "$MENU_RESULT" in
  *SO-CRATES*) /usr/share/ohmydebn/bin/ohmydebn-socrates ;;
  *tcpdump*) /usr/share/ohmydebn/bin/ohmydebn-tcpdump ;;
  *tshark*) /usr/share/ohmydebn/bin/ohmydebn-tshark ;;
  *wireshark*) /usr/share/ohmydebn/bin/ohmydebn-wireshark ;;
  *) show_apps_menu ;;
  esac
}

show_utility_menu() {
  menu "Utility" "󰞍  Deskflow keyboard and mouse sharing\n↔  LocalSend\n↔  rclone\n󰍉  Screen Magnifier\n󰒒  SSH Server"
  case "$MENU_RESULT" in
  *Deskflow*) /usr/share/ohmydebn/bin/ohmydebn-deskflow ;;
  *LocalSend*) /usr/share/ohmydebn/bin/ohmydebn-localsend ;;
  *rclone*) /usr/share/ohmydebn/bin/ohmydebn-rclone ;;
  *Magnifier*) present_terminal "Screen Magnifier" /usr/share/ohmydebn/bin/ohmydebn-magnifier-enable ;;
  *SSH*) /usr/share/ohmydebn/bin/ohmydebn-ssh-server ;;
  *) show_apps_menu ;;
  esac
}

show_terminals_menu() {
  menu "Terminals" "  herdr\n  PowerShell\n  tmux\n  zsh"
  case "$MENU_RESULT" in
  *herdr*) /usr/share/ohmydebn/bin/ohmydebn-herdr ;;
  *PowerShell*) /usr/share/ohmydebn/bin/ohmydebn-powershell ;;
  *tmux*) /usr/share/ohmydebn/bin/ohmydebn-tmux ;;
  *zsh*) /usr/share/ohmydebn/bin/ohmydebn-terminal ;;
  *) show_apps_menu ;;
  esac
}

