  menu "Media" "  Cava audio visualizer\n  cliamp terminal music player\n  UxPlay AirPlay receiver"
  case "$MENU_RESULT" in
  *Cava*) /usr/share/ohmydebn/bin/ohmydebn-cava ;;
  *cliamp*) /usr/share/ohmydebn/bin/ohmydebn-cliamp ;;
  *UxPlay*) /usr/share/ohmydebn/bin/ohmydebn-uxplay ;;
  *) show_apps_menu ;;
