#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "openssh-server" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "SSH Server (openssh-server) is not currently installed."
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install openssh-server
fi

# Debian's postinst starts and enables the service, but OhMyDebn's firewall
# (inbound denied) keeps it unreachable until the user allows port 22 -
# OhMyDebn never opens a port itself; see ohmydebn-firewall-hint.
echo
/usr/share/ohmydebn/bin/ohmydebn-firewall-hint 22 "SSH Server"
