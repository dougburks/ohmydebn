#!/bin/bash
#
# ohmydebn-ai: launches the user's default AI assistant. Bound to Super+A
# (see install/keybinding/keybinding-custom.txt). The default is set by
# ohmydebn-ai-set-default - from each AI installer's "make it your
# default?" question, or OhMyDebn Menu > Setup > Defaults > Agent. Falls
# back to OpenCode - Super+A's original, hardcoded target - when nothing's
# been picked yet or the stored value isn't one of the known names, so
# upgraders' muscle memory doesn't change until they deliberately pick
# something else.

set -euo pipefail

DEFAULT_AI_FILE="$HOME/.config/ohmydebn/current/default-ai"

name="opencode"
if [[ -f "$DEFAULT_AI_FILE" ]]; then
  stored=$(<"$DEFAULT_AI_FILE")
  case "$stored" in
  opencode | claude-code | chatgpt | codex | grok | pi | t3code | vscode | antigravity) name="$stored" ;;
  esac
fi

case "$name" in
opencode) exec /usr/share/ohmydebn/bin/ohmydebn-opencode ;;
claude-code) exec /usr/share/ohmydebn/bin/ohmydebn-claude-code ;;
chatgpt) exec /usr/share/ohmydebn/bin/ohmydebn-chatgpt ;;
codex) exec /usr/share/ohmydebn/bin/ohmydebn-codex ;;
grok) exec /usr/share/ohmydebn/bin/ohmydebn-grok ;;
pi) exec /usr/share/ohmydebn/bin/ohmydebn-pi ;;
t3code) exec /usr/share/ohmydebn/bin/ohmydebn-t3code ;;
vscode) exec /usr/share/ohmydebn/bin/ohmydebn-code ;;
antigravity) exec /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
esac
