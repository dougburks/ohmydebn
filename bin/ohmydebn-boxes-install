#!/bin/bash

set -euo pipefail

# If running on Proxmox, output error message and exit
if [ -f /etc/apt/sources.list.d/proxmox.sources ]; then
  echo "This is not supported on Proxmox since Proxmox already provides virtualization."
  exit 0
fi

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "gnome-boxes" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Boxes virtualization support is not currently installed."
    echo
    echo "Continuing will install it from the standard Debian repos."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  # Install gnome-boxes packages
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install gnome-boxes

  # Output message to user
  cat <<EOF

================================================================================

Boxes virtualization support is now installed.

You can start Boxes from the menu or by pressing:

Ctrl + Alt + B

EOF
fi
