#!/bin/bash

set -euo pipefail

WARP_KEYRING=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg
WARP_LIST=/etc/apt/sources.list.d/cloudflare-client.list
WARP_PREF=/etc/apt/preferences.d/cloudflare-client.pref

# Cloudflare's repo has Debian and Ubuntu release names only (trixie,
# noble, resolute...), not derivatives' own: `lsb_release -cs` gave
# kali-rolling, excalibur, gigi or zena, which it doesn't serve, and apt
# update then failed on every run - including every ohmydebn-update. Use
# the Ubuntu base where there is one (Ubuntu, Mint, Pop - UBUNTU_CODENAME,
# or VERSION_CODENAME on Ubuntu itself), and otherwise trixie, the one
# Debian release OhMyDebn supports (Debian, MX, LMDE, Kali, Devuan, LCOS).
#
# Cloudflare also publishes a new Ubuntu release's repo some time after the
# release itself (26.10 "stonking" had none on release day), so an Ubuntu
# codename it answers 404 for falls back to the newest Ubuntu LTS OhMyDebn
# supports. Only a 404 does: on a network error the user's own codename is
# kept, and the apt update below fails and cleans up as it would anyway.
WARP_UBUNTU_FALLBACK=resolute

warp_codename() {
  local os_release="${OHMYDEBN_TEST_OS_RELEASE:-/etc/os-release}" codename status
  codename=$(
    ID="" ID_LIKE="" VERSION_CODENAME="" UBUNTU_CODENAME=""
    # shellcheck disable=SC1090
    . "$os_release"
    if [ -n "$UBUNTU_CODENAME" ]; then
      echo "$UBUNTU_CODENAME"
    elif [ "$ID" = ubuntu ] || [[ " $ID_LIKE " == *" ubuntu "* ]]; then
      echo "$VERSION_CODENAME"
    else
      echo trixie
    fi
  )
  if [ "$codename" != trixie ] && [ "$codename" != "$WARP_UBUNTU_FALLBACK" ]; then
    status=$(curl -sIL --max-time 15 -o /dev/null -w '%{http_code}' \
      "https://pkg.cloudflareclient.com/dists/$codename/Release" 2>/dev/null || true)
    [ "$status" = 404 ] && codename=$WARP_UBUNTU_FALLBACK
  fi
  echo "$codename"
}

if ! dpkg -s "cloudflare-warp" >/dev/null 2>&1; then
  echo
  echo "Cloudflare WARP is not currently installed."
  echo
  echo "Continuing will install it from:"
  echo "https://pkg.cloudflareclient.com/"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r

  # The key is checked against its fingerprint before apt trusts it (see
  # ohmydebn-pgp-fingerprint), so a key swapped in transit or on the server
  # is refused. Cloudflare's install page names it for RPM as
  # gpg-pubkey(4fa1c3ba-61abda35): this key's ID ends 4FA1C3BA and it was
  # created at 0x61abda35 (checked 2026-10-27). If Cloudflare replaces the
  # key, installs refuse the new one until the fingerprint here is updated.
  KEY_URL=https://pkg.cloudflareclient.com/pubkey.gpg
  KEY_FILE=$(mktemp)
  trap 'rm -f "$KEY_FILE"' EXIT
  curl -fsSL "$KEY_URL" -o "$KEY_FILE"
  if [ "$(/usr/share/ohmydebn/bin/ohmydebn-pgp-fingerprint "$KEY_FILE" || true)" != C068A2B5771775193CBE1F2F6E2DD2174FA1C3BA ]; then
    echo "The signing key from $KEY_URL isn't the one Cloudflare publishes, so it wasn't installed."
    exit 1
  fi
  sudo mkdir -p /usr/share/keyrings
  sudo gpg --yes --dearmor --output "$WARP_KEYRING" "$KEY_FILE"

  echo "deb [signed-by=$WARP_KEYRING] https://pkg.cloudflareclient.com/ $(warp_codename) main" |
    sudo tee "$WARP_LIST" >/dev/null

  # Restricts this repo to the one package it's actually needed for
  # (confirmed via `apt-cache depends cloudflare-warp` - no same-repo
  # dependency like Brave's brave-keyring) - a bare signed-by trusts the
  # repo's key to sign anything, so without this a compromised or
  # malicious upstream could ship a package under some other name and have
  # apt prefer it on some later, completely unrelated `apt install`/
  # upgrade.
  printf 'Package: *\nPin: origin "pkg.cloudflareclient.com"\nPin-Priority: -1\n\nPackage: cloudflare-warp\nPin: origin "pkg.cloudflareclient.com"\nPin-Priority: 500\n' |
    sudo tee "$WARP_PREF" >/dev/null

  # A source apt can't refresh fails every later apt update, and with it
  # every ohmydebn-update, until it's removed - so if this one can't be
  # refreshed, take it back out rather than leave it behind.
  if ! sudo /usr/bin/apt update; then
    sudo rm -f "$WARP_LIST" "$WARP_PREF" "$WARP_KEYRING"
    echo
    echo "Couldn't refresh the package lists, so Cloudflare WARP's package source was removed again."
    echo "Check the apt output above, then try again."
    exit 1
  fi
  sudo /usr/bin/apt -y install cloudflare-warp
fi
