#!/bin/bash

if [ "$#" -ne 3 ]; then
  if ! command -v gum >/dev/null 2>&1; then
    echo "Usage: ohmydebn-webapp-install <name> <url> <icon-url>" >&2
    exit 1
  fi

  echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"
  APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
  APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
  ICON_URL=$(gum input --prompt "Icon URL> " --placeholder "See https://dashboardicons.com (must use PNG!)")
else
  APP_NAME="$1"
  APP_URL="$2"
  ICON_URL="$3"
fi

if [[ -z "$APP_NAME" || -z "$APP_URL" || -z "$ICON_URL" ]]; then
  echo "You must set app name, app URL, and icon URL!"
  exit 1
fi

if [[ "$APP_NAME" == */* ]]; then
  echo "App name must not contain '/'."
  exit 1
fi

# APP_NAME and APP_URL are written verbatim into the desktop file below, and
# a .desktop file's key=value parser takes the last occurrence of a
# duplicate key - so a newline embedded in either would let an attacker
# inject their own Exec= (or any other key) that silently wins over the
# real one, and would run next time this "app" is launched.
if [[ "$APP_NAME" == *$'\n'* || "$APP_NAME" == *$'\r'* || "$APP_URL" == *$'\n'* || "$APP_URL" == *$'\r'* ]]; then
  echo "App name and URL must not contain newlines."
  exit 1
fi

# Exec=ohmydebn-launch-webapp $APP_URL only ever forwards this string on to
# a browser as an app URL, so require an actual URI scheme rather than
# accepting anything - same check omarchy's web app installer uses.
if [[ ! "$APP_URL" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
  echo "App URL must include a scheme (e.g. https://)."
  exit 1
fi

# ICON_URL reaches curl as a bare positional argument below; a leading '-'
# would make curl read it as an option instead of a URL (same class of
# argument injection ohmydebn-theme-install already guards against for git).
if [[ "$ICON_URL" == -* || "$ICON_URL" == *$'\n'* || "$ICON_URL" == *$'\r'* ]]; then
  echo "Icon URL must not start with '-' or contain newlines."
  exit 1
fi

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

mkdir -p "$ICON_DIR"

# -f: an error page (a 404, say) is a failure, not an icon.
if ! curl -fsSL -o "$ICON_PATH" -- "$ICON_URL"; then
  echo "Error: Failed to download icon."
  exit 1
fi

# One argument of a desktop file's Exec line, quoted the way the desktop
# entry spec says: inside double quotes, \ " ` and $ are backslash-escaped;
# every backslash is then doubled again for the key file's own string
# escaping; and a literal % is %% (a lone % starts a field code). The URL
# used to go in bare, so one with %20 in it gave a broken launcher.
desktop_exec_arg() {
  local arg="$1"
  arg=${arg//\\/\\\\}
  arg=${arg//\"/\\\"}
  arg=${arg//\`/\\\`}
  arg=${arg//\$/\\\$}
  arg=${arg//\\/\\\\}
  arg=${arg//%/%%}
  printf '"%s"' "$arg"
}

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=/usr/share/ohmydebn/bin/ohmydebn-launch-webapp $(desktop_exec_arg "$APP_URL")
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"

if [ "$#" -ne 3 ]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + R)\n"
fi
