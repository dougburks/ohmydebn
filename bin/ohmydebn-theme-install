#!/bin/bash

# ohmydebn-theme-install: Install a new theme from a git repo
# Usage: ohmydebn-theme-install <git-repo-url>

if [ -z "$1" ]; then
  if ! command -v gum >/dev/null 2>&1; then
    echo "Usage: ohmydebn-theme-install <git-repo-url>" >&2
    exit 1
  fi

  echo -e "\e[32mSee https://learn.omacom.io/2/the-omarchy-manual/90/extra-themes\n\e[0m"
  REPO_URL=$(gum input --placeholder="Git repo URL for theme" --header="")
else
  REPO_URL="$1"
fi

if [ -z "$REPO_URL" ]; then
  exit 1
fi

/usr/share/ohmydebn/bin/ohmydebn-git-url-check "$REPO_URL" || exit 1

THEMES_DIR="$HOME/.config/ohmydebn/themes"

# Strip user@host: prefix from scp-style SSH URLs so basename sees just the path
REPO_PATH="$REPO_URL"
[[ "$REPO_PATH" != *"://"* && "$REPO_PATH" == *:*/* ]] && REPO_PATH="${REPO_PATH#*:}"
THEME_NAME=$(basename -- "$REPO_PATH" .git | sed -E 's/^omarchy-//; s/-theme$//' | tr '[:upper:]' '[:lower:]')

# Reject names that could escape THEMES_DIR (same check as ohmydebn-theme-remove) -
# basename() passes "..", "." and embedded "/" segments through unchanged, so a
# crafted REPO_URL (e.g. one ending in "/..") would otherwise point THEME_PATH
# at an ancestor of THEMES_DIR and the rm -rf below would delete it.
if [[ -z "$THEME_NAME" || "$THEME_NAME" == .* || "$THEME_NAME" == */* ]]; then
  echo "Error: invalid theme name derived from '$REPO_URL'." >&2
  exit 1
fi

THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Cloned into a temporary directory beside themes/ first (not inside it,
# where theme lists would see it), and only swapped in for an existing copy
# once the clone has worked: removing the installed theme before cloning
# lost it whenever the clone failed (no network, a mistyped URL).
mkdir -p "$THEMES_DIR"
CLONE_DIR=$(mktemp -d "$THEMES_DIR/../.theme-install-XXXXXX")
if ! git clone -- "$REPO_URL" "$CLONE_DIR/$THEME_NAME"; then
  rm -rf "$CLONE_DIR"
  echo "Error: Failed to clone theme repo."
  exit 1
fi
rm -rf "$THEME_PATH"
mv "$CLONE_DIR/$THEME_NAME" "$THEME_PATH"
rm -rf "$CLONE_DIR"

# Apply the new theme with ohmydebn-theme-set, which stages only the files a
# theme installed from a git repo is allowed to contribute and names anything
# it dropped
/usr/share/ohmydebn/bin/ohmydebn-theme-set "$THEME_NAME"
