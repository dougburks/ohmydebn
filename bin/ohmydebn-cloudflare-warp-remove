#!/bin/bash

set -euo pipefail

if ! dpkg -s "cloudflare-warp" >/dev/null 2>&1; then
  echo
  echo "Cloudflare Warp is not currently installed."
else
  if [[ $# -eq 0 ]]; then
    echo
    echo "Continuing will remove Cloudflare Warp and its repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."
    read -r
  fi
  sudo rm -f /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg
  sudo rm -f /etc/apt/sources.list.d/cloudflare-client.list
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y purge cloudflare-warp
  sudo /usr/bin/apt -y autoremove
fi
