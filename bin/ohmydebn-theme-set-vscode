#!/bin/bash

# Note: We cannot use `jq` to update settings.json because it’s JSONC (allows comments),
# which jq doesn’t support.

# Parameters: EDITOR_CMD SETTINGS_PATH SKIP_FLAG EDITOR_NAME
EDITOR_CMD="${1:-code}"
SETTINGS_PATH="${2:-$HOME/.config/Code/User/settings.json}"
SKIP_FLAG="${3:-$HOME/.local/state/ohmydebn/toggles/skip-vscode-theme-changes}"
VS_CODE_THEME="$HOME/.config/ohmydebn/current/theme/vscode.json"

if /usr/share/ohmydebn/bin/ohmydebn-cmd-present "$EDITOR_CMD" && [[ ! -f "$SKIP_FLAG" ]] && command -v jq >/dev/null 2>&1; then
  if [[ -f "$VS_CODE_THEME" ]]; then
    theme_name=$(jq -r '.name' "$VS_CODE_THEME")
    extension=$(jq -r '.extension' "$VS_CODE_THEME")

    # Install theme extension
    if [[ -n "$extension" ]] && ! "$EDITOR_CMD" --list-extensions | grep -Fxq "$extension"; then
      "$EDITOR_CMD" --install-extension "$extension" >/dev/null
    fi

    # Create config file if there isn't already one
    mkdir -p "$(dirname "$SETTINGS_PATH")"
    if [[ ! -f "$SETTINGS_PATH" ]]; then
      printf '{\n}\n' >"$SETTINGS_PATH"
    fi

    # Create a `workbench.colorTheme` entry in settings.
    if ! grep -q '"workbench.colorTheme"' "$SETTINGS_PATH"; then
      # Insert `"workbench.colorTheme": ""` immediately after the first `{`.
      # Use sed's first-match range (0,/{/) to only replace the first `{`.
      # Only append a trailing comma if the object already has other content -
      # an empty object (e.g. the `{\n}\n` stub created above, or a genuinely
      # empty pre-existing settings.json) would otherwise end up as
      # `{ "workbench.colorTheme": "", }`, which is invalid JSON.
      if [[ "$(tr -d '[:space:]' <"$SETTINGS_PATH")" == '{}' ]]; then
        sed -i --follow-symlinks -E '0,/\{/{s/\{/{\ "workbench.colorTheme": ""/}' "$SETTINGS_PATH"
      else
        sed -i --follow-symlinks -E '0,/\{/{s/\{/{\ "workbench.colorTheme": "",/}' "$SETTINGS_PATH"
      fi
    fi

    # Update theme. theme_name comes straight from the theme's own
    # vscode.json, so it must be escaped for two different contexts before
    # being spliced into the sed replacement below: first as JSON string
    # content (a literal " would otherwise terminate the JSON string early
    # and let a crafted theme inject arbitrary extra settings.json keys; a
    # literal newline would terminate the single-line sed script early and
    # let the rest be parsed as a separate sed command), then re-escaped so
    # those JSON escapes survive GNU sed's own backslash processing of the
    # replacement text (which collapses \\ -> \) alongside the existing
    # \/ and \& escapes for sed's own special replacement chars.
    theme_name_escaped="$theme_name"
    theme_name_escaped="${theme_name_escaped//\\/\\\\}"
    theme_name_escaped="${theme_name_escaped//\"/\\\"}"
    theme_name_escaped="${theme_name_escaped//$'\n'/\\n}"
    theme_name_escaped="${theme_name_escaped//\\/\\\\}"
    theme_name_escaped="${theme_name_escaped//&/\\&}"
    theme_name_escaped="${theme_name_escaped//\//\\/}"
    sed -i --follow-symlinks -E \
      "s/(\"workbench.colorTheme\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1$theme_name_escaped\2/" \
      "$SETTINGS_PATH"
  else
    # Remove theme from settings.json when the theme doesn't have editor support
    if [[ -f "$SETTINGS_PATH" ]]; then
      sed -i --follow-symlinks -E 's/\"workbench\.colorTheme\"[[:space:]]*:[^,}]*,?//' "$SETTINGS_PATH"
    fi
  fi
fi
