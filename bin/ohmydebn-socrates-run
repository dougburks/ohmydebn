#!/bin/bash

mkdir -p ~/socrates-data
/usr/bin/podman run \
  --userns=keep-id \
  --user $(id -u):$(id -g) \
  -v ~/socrates-data:/data \
  -p 8000:8000 \
  ghcr.io/dougburks/so-crates@sha256:115554af51c97422b0e166096162770731d65bee3c1bcb66a54f1c6a5f886556

echo
/usr/share/ohmydebn/bin/ohmydebn-socrates-cleanup
echo
echo "Press Enter to close this window."
read input
