#!/bin/bash

# ohmydebn-terminal-tiled (the only thing that ever launches this, inside
# the alacritty session it starts) has gTile tile that window as it
# opens: gTile resizes it just after its first frame, so this already
# runs at the window's small untiled size. Without waiting that out
# first, the very first ttfx launch below queries `tput lines` while the
# window is still at that size and locks the wrong canvas height in for
# its whole first animation, only self-correcting once this outer loop
# rotates to the next ttfx invocation and re-queries the (by then
# correct) size - confirmed live as exactly the reported bug: small at
# first, correct only after the first rotation. 0.6s: comfortably past
# gTile's placement (a fraction of a second), an empirically picked
# margin rather than a synchronized one.
sleep 0.6

while true; do
  /usr/bin/ttfx -i ~/.config/ohmydebn/branding/logo.txt \
    --frame-rate 240 --canvas-width 0 --canvas-height $(($(tput lines) - 2)) \
    --anchor-canvas c --anchor-text c \
    --random-effect &
  TTFX_PID=$!

  # Only this demo's own ttfx, by its PID: `pkill -x ttfx` also stopped the
  # animation in an open logo window (and `pgrep -x ttfx` waited on it).
  # A key ends the demo, and its terminal window closes with this script.
  while kill -0 "$TTFX_PID" 2>/dev/null; do
    if read -r -n 1 -t 0.01; then
      kill "$TTFX_PID" 2>/dev/null
      exit 0
    fi
  done
done
