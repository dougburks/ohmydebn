echo
echo "== Summary =="
echo "  $OK ok, $FAILED failed, $SKIPPED skipped"
if [ "$FAILED" -gt 0 ]; then
  echo "  failed:"
  for f in "${FAILURES[@]}"; do echo "    - $f"; done
fi
