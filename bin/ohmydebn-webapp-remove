#!/bin/bash

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

if [ "$#" -eq 0 ]; then
  # Find all web apps. ohmydebn-webapp-install didn't always guard against
  # '/' in the app name, so a launcher from before that guard existed could
  # be nested (e.g. "foo/bar.desktop") - record the path relative to
  # DESKTOP_DIR, not just the basename, so a legacy nested launcher can
  # still be matched up and removed correctly below instead of silently
  # resolving to the wrong (nonexistent) top-level path.
  while IFS= read -r -d '' file; do
    if grep -q '^Exec=.*ohmydebn-launch-webapp.*' "$file"; then
      REL_PATH="${file#"$DESKTOP_DIR"/}"
      WEB_APPS+=("${REL_PATH%.desktop}")
    fi
  done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0)

  if ((${#WEB_APPS[@]})); then
    if ! command -v gum >/dev/null 2>&1; then
      echo "Usage: ohmydebn-webapp-remove <app-name> [app-name...]" >&2
      exit 1
    fi

    mapfile -t SORTED_WEB_APPS < <(sort <<<"${WEB_APPS[*]}")
    APP_NAMES_STRING=$(gum choose --no-limit --header "Select web app to remove..." --selected-prefix="✗ " "${SORTED_WEB_APPS[@]}")
    # Convert newline-separated string to array
    APP_NAMES=()
    while IFS= read -r line; do
      [[ -n "$line" ]] && APP_NAMES+=("$line")
    done <<<"$APP_NAMES_STRING"
  else
    echo "No web apps to remove."
    exit 1
  fi
else
  # Use array to preserve spaces in app names
  APP_NAMES=("$@")
fi

if [[ ${#APP_NAMES[@]} -eq 0 ]]; then
  echo "You must provide web app names."
  exit 1
fi

for APP_NAME in "${APP_NAMES[@]}"; do
  # A name picked from the scan above may legitimately contain '/' (a
  # legacy nested launcher predating this guard) - only reject '/' in names
  # typed directly on the command line, the untrusted-input case.
  if [[ "$#" -ne 0 && "$APP_NAME" == */* ]]; then
    echo "Skipping '$APP_NAME': app name must not contain '/'."
    continue
  fi
  rm -f "$DESKTOP_DIR/$APP_NAME.desktop"
  rm -f "$ICON_DIR/$APP_NAME.png"
  echo "Removed $APP_NAME"
done
