#!/bin/bash

set -euo pipefail

# Nothing to do when it's already installed.
if ! dpkg -s "localsend" >/dev/null 2>&1; then
  echo
  echo "LocalSend is not currently installed."
  echo
  echo "Continuing will install it, built from:"
  echo "https://github.com/localsend/localsend"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."

  read -r

  # Install package and its dependencies. This runs standalone, on-demand
  # (Ctrl+Super+L), independent of install.sh/ohmydebn-update's own flow -
  # see ohmydebn-gestures-install's own comment on why that means it needs
  # its own `apt update` first.
  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install localsend gir1.2-ayatanaappindicator3-0.1 libayatana-appindicator3-1 libayatana-ido3-0.4-0 libayatana-indicator3-7
fi
