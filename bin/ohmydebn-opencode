#!/bin/bash
#
# Opens a plain (untiled) terminal running ohmydebn-opencode-run - see
# ohmydebn-cliamp's own comment on why the payload lives in a separate
# script instead of here.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-terminal --title 'OpenCode' -e /usr/share/ohmydebn/bin/ohmydebn-opencode-run
