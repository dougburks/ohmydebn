#!/bin/bash

export PATH="/usr/share/ohmydebn/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$DIRECT_ACCESS" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi
  fi

  DPI=$(/usr/share/ohmydebn/bin/ohmydebn-rofi-dpi)
  WIDTH=$(/usr/share/ohmydebn/bin/ohmydebn-rofi-width 410)
  echo -e "$options" | /usr/bin/rofi -dpi $DPI -theme-str "window {width: $WIDTH;}" \
    -dmenu -i -p "$prompt…" "${args[@]}"
}

terminal() {
  /usr/share/ohmydebn/bin/ohmydebn-terminal --class OhMyDebn -e "$@"
}

present_terminal() {
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation $1
}

install() {
  present_terminal "echo 'Installing $1...'; sudo /usr/bin/apt -y install $2"
}

install_from_url() {
  TEMP=$(mktemp)
  present_terminal "echo 'Installing $1...'; curl -L \"$2\" -o $TEMP && sudo dpkg -i $TEMP && rm -f $TEMP"
}

install_chrome() {
  if dpkg -s google-chrome-stable >/dev/null 2>&1; then
    present_terminal "echo 'The google-chrome-stable package is already installed.'"
  else
    ARCH=$(uname -m)
    if [ "$ARCH" == "x86_64" ]; then
      install_from_url "Google Chrome" "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
    else
      present_terminal "echo 'Sorry, Google does not provide a Chrome package for your architecture!'"
    fi
  fi
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; sudo /usr/bin/apt -y install $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  OhMyDebn\n  Cinnamon\n  Debian\n  Neovim\n󱆃  Bash") in
  *Keybindings*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://ohmydebn.org/hotkeys/" ;;
  *OhMyDebn*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://ohmydebn.org" ;;
  *Cinnamon*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://github.com/linuxmint/cinnamon" ;;
  *Debian*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://wiki.debian.org/" ;;
  *Bash*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) /usr/share/ohmydebn/bin/ohmydebn-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n  Background") in
  *Theme*) /usr/share/ohmydebn/bin/ohmydebn-theme-set-gui ;;
  *Background*) /usr/share/ohmydebn/bin/ohmydebn-theme-bg-next ;;
  *) show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰃉  Color") in
  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Color*) /usr/bin/gcolor3 ;;
  *) show_main_menu ;;
  esac
}

show_screenshot_menu() {
  case $(menu "Screenshot" "  Region\n  Window\n  Display") in
  *Region*) /usr/bin/xdotool key Shift+Print ;;
  *Window*) /usr/bin/xdotool key Alt+Print ;;
  *Display*) /usr/bin/xdotool key Print ;;
  *) show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  case $(menu "Screenrecord" "  Cinnamon Recorder Start/Stop\n  SimpleScreenRecorder") in
  *Start*) /usr/bin/xdotool key Shift+Ctrl+Alt+R ;;
  *Simple*) /usr/share/ohmydebn/bin/ohmydebn-simplescreenrecorder ;;
  *) show_capture_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "  Package\n󰖟  Browser\n  Web App\n  TUI\n  Style\n󱚤  AI\n  Editor\n🔍︎ Cybersecurity\n♫  Media\n  Virtualization\n  Containerization\n  Office Apps") in
  *Package*) terminal /usr/share/ohmydebn/bin/ohmydebn-pkg-install ;;
  *Browser*) show_install_browser_menu ;;
  *Web*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-webapp-install ;;
  *TUI*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-tui-install ;;
  *Style*) show_install_style_menu ;;
  *AI*) show_install_ai_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Cybersecurity*) show_install_cybersecurity_menu ;;
  *Utility*) show_install_utility_menu ;;
  *Media*) show_install_media_menu ;;
  *Virtualization*) show_install_virtualization_menu ;;
  *Containerization*) show_install_containerization_menu ;;
  *Office*) show_install_office_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_office_menu() {
  case $(menu "Install" "  LibreOffice Suite\n  Calligra Suite\n  Gnumeric\n  AbiWord") in
  *LibreOffice*) install "libreoffice" "libreoffice" ;;
  *Calligra*) install "calligra" "calligra" ;;
  *Gnumeric*) install "gnumeric" "gnumeric" ;;
  *AbiWord*) install "abiword" "abiword" ;;
  *) show_install_menu ;;
  esac
}

show_install_cybersecurity_menu() {
  case $(menu "Install" "🔍︎ SO-CRATES\n🔍︎ tcpdump\n🔍︎ tshark\n🔍︎ wireshark") in
  *SO-CRATES*) /usr/share/ohmydebn/bin/ohmydebn-socrates ;;
  *tcpdump*) install "tcpdump" "tcpdump" ;;
  *tshark*) install "tshark" "tshark" ;;
  *wireshark*) install "wireshark" "wireshark" ;;
  *) show_install_menu ;;
  esac
}

show_install_utility_menu() {
  case $(menu "Install" "󰞍  Deskflow keyboard and mouse sharing\n↔  LocalSend\n󰒒  SSH Server") in
  *Deskflow*) install "Deskflow" "deskflow" ;;
  *LocalSend*) /usr/share/ohmydebn/bin/ohmydebn-localsend ;;
  *SSH*) install "SSH Server" "openssh-server" ;;
  *) show_install_menu ;;
  esac
}

show_install_media_menu() {
  case $(menu "Install" "♫  cliamp terminal music player\n🛜︎ UxPlay Airplay receiver") in
  *cliamp*) install "cliamp" "cliamp" ;;
  *UxPlay*) install "UxPlay Airplay Receiver" "uxplay" ;;
  *) show_install_menu ;;
  esac
}

show_install_containerization_menu() {
  case $(menu "Install" "  Docker\n  Podman\n  Distrobox") in
  *Docker*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-docker-install ;;
  *Podman*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-podman-install ;;
  *Distrobox*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-distrobox-install ;;
  *) show_install_menu ;;
  esac
}

show_install_virtualization_menu() {
  case $(menu "Install" "  Boxes (Simple)\n  Virtual Machine Manager (Advanced)") in
  *Boxes*) /usr/share/ohmydebn/bin/ohmydebn-boxes ;;
  *Manager*) /usr/share/ohmydebn/bin/ohmydebn-virtmanager ;;
  *) show_install_menu ;;
  esac
}

show_install_browser_menu() {
  case $(menu "Install" "󰖟  Brave\n  Chromium (installed by default)\n  Firefox\n󰊯  Google Chrome\n󰖟  Helium") in
  *Brave*) /usr/share/ohmydebn/bin/ohmydebn-brave ;;
  *Chromium*) install "Chromium" "chromium" ;;
  *Firefox*) install "Firefox" "firefox-esr" ;;
  *Google*) install_chrome ;;
  *Helium*) /usr/share/ohmydebn/bin/ohmydebn-helium ;;
  *) show_main_menu ;;
  esac
}

show_install_ai_menu() {
  case $(menu "Install" "󱚤  OpenCode (supports free/$ models)\n󱚤  Claude Code (Anthropic)\n  VSCode (Github Copilot AI)\n  Antigravity (Google Agentic AI)") in
  *OpenCode*) /usr/share/ohmydebn/bin/ohmydebn-opencode ;;
  *Claude*) /usr/share/ohmydebn/bin/ohmydebn-claude-code ;;
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-vscode ;;
  *) show_install_menu ;;
  esac
}

show_install_editor_menu() {
  case $(menu "Install" "  VSCode\n  Antigravity\n  Emacs") in
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-vscode ;;
  *Emacs*) install "Emacs" "emacs" ;;
  *) show_install_menu ;;
  esac
}

show_install_style_menu() {
  case $(menu "Install" "󰸌  Theme\n  Background") in
  *Theme*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-theme-install ;;
  *Background*) nemo ~/.config/ohmydebn/current/theme/backgrounds ;;
  *) show_install_menu ;;
  esac
}

show_remove_menu() {
  case $(menu "Remove" "  Package\n  Web App\n  TUI\n󰸌  Theme") in
  *Package*) terminal /usr/share/ohmydebn/bin/ohmydebn-pkg-remove ;;
  *Web*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-webapp-remove ;;
  *TUI*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-tui-remove ;;
  *Theme*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-theme-remove ;;
  *) show_main_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "  OhMyDebn\n  Password\n  Timezone") in
  *OhMyDebn*) /usr/share/ohmydebn/bin/ohmydebn-update-gui ;;
  *Password*) show_update_password_menu ;;
  *Timezone*) cinnamon-settings calendar ;;
  *) show_main_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  User") in
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_system_menu() {
  case $(menu "System" "  Lock\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown") in
  *Lock*) cinnamon-screensaver-command -l ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) /usr/bin/cinnamon --replace & ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n  Capture\n  Style\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  Demo\n󰍉  Screen Magnifier\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) /usr/share/ohmydebn/bin/ohmydebn-rofi-apps ;;
  *learn*) show_learn_menu ;;
  *style*) show_style_menu ;;
  *theme*) /usr/share/ohmydebn/bin/ohmydebn-theme-set-gui ;;
  *capture*) show_capture_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) /usr/share/ohmydebn/bin/ohmydebn-screenfetch-gui ;;
  *demo*) /usr/share/ohmydebn/bin/ohmydebn-demo-gui ;;
  *magnifier*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-magnifier-enable ;;
  *system*) show_system_menu ;;
  esac
}

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
