#!/bin/bash

URL="https://learn.omacom.io/2/the-omarchy-manual/90/extra-themes"
cat <<EOF
Continuing will install all third-party themes from:
$URL

Depending on the speed of your Internet connection,
this may take a few minutes.

Press Enter to continue or Ctrl-C to cancel.
EOF

read -r

THEMES_DIR="$HOME/.config/ohmydebn/themes"

curl -s $URL | grep github.com | cut -d\" -f2 | while read -r REPO_URL; do
  # Same guard as ohmydebn-theme-install: the page this scrapes is a
  # substring match, not a real HTML parse, so a URL here is only as
  # trustworthy as the page's content.
  if ! /usr/share/ohmydebn/bin/ohmydebn-git-url-check "$REPO_URL" 2>/dev/null; then
    echo "Skipping '$REPO_URL': names a git option or transport helper, not a repository."
    echo
    continue
  fi

  # Strip user@host: prefix from scp-style SSH URLs so basename sees just the path
  REPO_PATH="$REPO_URL"
  [[ "$REPO_PATH" != *"://"* && "$REPO_PATH" == *:*/* ]] && REPO_PATH="${REPO_PATH#*:}"
  THEME_NAME=$(basename -- "$REPO_PATH" .git | sed -E 's/^omarchy-//; s/-theme$//' | tr '[:upper:]' '[:lower:]')

  # Reject names that could escape THEMES_DIR (same check as ohmydebn-theme-install)
  if [[ -z "$THEME_NAME" || "$THEME_NAME" == .* || "$THEME_NAME" == */* ]]; then
    echo "Skipping '$REPO_URL': invalid theme name derived from it."
    echo
    continue
  fi

  THEME_PATH="$THEMES_DIR/$THEME_NAME"

  if [ -d "$THEME_PATH" ]; then
    echo "$THEME_NAME - already installed"
  else
    echo "$THEME_NAME - installing:"
    if ! GIT_TERMINAL_PROMPT=0 git clone -- "$REPO_URL" "$THEME_PATH"; then
      echo "Error: Failed to clone $THEME_PATH"
    fi
  fi
  echo
done
