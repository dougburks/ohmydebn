#!/bin/bash
#
# cliamp tiled to the bottom right corner with gaps immediately after
# launch, via the shared ohmydebn-launch-tiled helper - the same
# TileFocusedWindow grid ("2 2 1 1 1 1") as the "Tile with gaps 3 bottom
# right corner" keybinding. Bound to Ctrl+Alt+M in keybinding-custom.txt
# in place of a bare call to ohmydebn-cliamp. ohmydebn-cliamp is a single
# terminal window for its whole lifecycle (install-if-needed, then run),
# so no OHMYDEBN_LAUNCH_TILED_WATCH_SECOND needed here - see that
# variable's own comment and ohmydebn-cliamp's.

set -euo pipefail

exec /usr/share/ohmydebn/bin/ohmydebn-launch-tiled 2 2 1 1 1 1 -- /usr/share/ohmydebn/bin/ohmydebn-cliamp
