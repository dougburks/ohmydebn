#!/usr/bin/python3
#
# ohmydebn-theme-carousel: full-screen, Omarchy-style theme AND background
# browser - launched by Ctrl+Super+T, Ctrl+Super+B (both bound to this same
# script - see install/keybinding/keybinding-custom.txt), and ohmydebn-menu's
# Style entry directly. Used to be two separate scripts/hotkeys/menu entries
# (this one for themes only, ohmydebn-theme-bg-carousel for backgrounds
# within the current theme only); folded into one after this version proved
# out a D-pad that handles both without the old bg-carousel's separate
# "applies live on every keypress" model - here, nothing touches the live
# desktop until Enter, for backgrounds exactly the same way it always worked
# for themes.
#
# Left/Right browse themes. Up/Down browse *backgrounds within the current
# theme*, whenever it has more than one. The main card always shows the
# actual background that's currently selected (so what's previewed and what
# Enter applies never disagree), with small dimmed thumbnails above/below it
# for the previous/next background - the same left/right-neighbor idea used
# for adjacent themes, just rotated 90 degrees. The choice is passed to the
# real ohmydebn-theme-set via its existing `--background N` flag, once, on
# Enter, alongside the theme itself - a single atomic apply either way.
#
# Aether keeps its own job (building/editing themes) - reachable here via
# the B/C/R single-key shortcuts (Browse more themes, Create new theme using
# Aether, Remove theme), all three also clickable directly in the caption
# panel. R only shows up (as a red chip, since it's destructive) when the
# currently-displayed theme is removable (see is_theme_removable() -
# ohmydebn-theme-remove itself is hardcoded to only ever touch
# ~/.config/ohmydebn/themes/, never the ~20 bundled system ones, so this
# mirrors that same real scope), and is itself a two-step confirm (first
# press/click arms it, second confirms - see _arm_remove()) rather than
# removing on a single keypress.
#
# Browse opens bjarneo.github.io/omarchy-themes (a visual, searchable theme
# gallery) and closes this carousel rather than leaving it open - picking a
# theme there triggers a registered aether:// URI handler (confirmed real:
# see ~/.local/share/applications/aether-protocol-handler.desktop ->
# `aether --import-blueprint %u --auto-apply`) that installs and applies it
# directly, no need to come back here at all.
#
# Each theme's preview.png (where present - about half the themes have one;
# it's each theme's original upstream Omarchy/Hyprland promo mockup, not an
# OhMyDebn/Cinnamon screenshot, so it's representative of the color palette
# rather than literally accurate) is used for the centered card when a
# specific background hasn't been picked via Up/Down yet, falling back to
# the theme's own first background image (confirmed every theme has at
# least one) when no preview.png exists - see preview_image().

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

import os
import subprocess
import sys
import threading
import tomllib
import warnings

OHMYDEBN_BIN = "/usr/share/ohmydebn/bin"
USER_THEMES_DIR = os.path.expanduser("~/.config/ohmydebn/themes")
SYSTEM_THEMES_DIR = "/usr/share/ohmydebn-themes"
CURRENT_THEME_FILE = os.path.expanduser("~/.config/ohmydebn/current/theme.name")
CURRENT_BACKGROUND_LINK = os.path.expanduser("~/.config/ohmydebn/current/background")

CARD_W, CARD_H = 900, 506
SIDE_W, SIDE_H = 340, 191
SIDE_OPACITY = 0.4
BG_THUMB_W, BG_THUMB_H = 320, 90

# Everything above is sized for a full-size desktop monitor. On a MacBook's
# HiDPI/Retina "looks like" resolution (e.g. 1280x800 or 1512x982 logical
# pixels), that fixed 1646x1105 footprint doesn't fit - GTK won't shrink a
# toplevel below the combined minimum size of its fixed-size children, so
# the real window ends up bigger than the monitor and the WM cuts off
# whatever doesn't fit (confirmed as a real report: the whole scrim
# panel wasn't visible on a Retina MacBook). Carousel.__init__ scales
# CARD_W/CARD_H/SIDE_W/SIDE_H/BG_THUMB_W/BG_THUMB_H down (never up) to fit
# the actual monitor before building any widgets, using these two
# constants as the divisor - the natural (min==nat) size of `row` and of
# `caption` (the scrim panel) at the sizes above, measured by hand via a
# real Gtk.OffscreenWindow render, same technique already used elsewhere
# in this file. `caption`'s own size comes entirely from text/button
# padding, not from these six constants, so it doesn't shrink with them -
# it's carried as a fixed vertical budget instead of getting scaled itself.
DESIGN_ROW_W, DESIGN_ROW_H = 1646, 716
DESIGN_CAPTION_H = 365
STACK_SPACING = 24
CAROUSEL_H_MARGIN = 60
CAROUSEL_V_MARGIN = 40

REMOVE_LABEL_DEFAULT = "Remove Theme"
REMOVE_LABEL_ARMED = "Confirm Remove?"
REMOVE_ARM_TIMEOUT_MS = 4000

BROWSE_THEMES_URL = "https://bjarneo.github.io/omarchy-themes/"

CREATE_THEME_ACTION = "action:create-theme"

def build_shortcuts_markup():
    # Name first, shortcut letter last - matches Cancel/Apply/Remove's own
    # "action, then shortcut" ordering elsewhere in the panel now, rather
    # than the letter-first convention these two used to share only with
    # each other.
    return "\n".join([
        f'<a href="{BROWSE_THEMES_URL}">Browse More Themes - B</a>',
        f'<a href="{CREATE_THEME_ACTION}">Create new Theme using Aether - C</a>',
    ])


def slug_to_display(slug):
    return " ".join(word.capitalize() for word in slug.split("-"))


def theme_dir(slug):
    user_path = os.path.join(USER_THEMES_DIR, slug)
    if os.path.isdir(user_path):
        return user_path
    return os.path.join(SYSTEM_THEMES_DIR, slug)


def is_theme_removable(slug):
    return os.path.isdir(os.path.join(USER_THEMES_DIR, slug))


def list_theme_slugs():
    slugs = set()
    for base in (USER_THEMES_DIR, SYSTEM_THEMES_DIR):
        if not os.path.isdir(base):
            continue
        for entry in os.listdir(base):
            if os.path.isdir(os.path.join(base, entry)):
                slugs.add(entry)
    return sorted(slugs)


def first_background(slug):
    bg_dir = os.path.join(theme_dir(slug), "backgrounds")
    try:
        entries = sorted(os.listdir(bg_dir))
    except OSError:
        return None
    for name in entries:
        if name.lower().endswith((".png", ".jpg", ".jpeg")):
            return os.path.join(bg_dir, name)
    return None


def preview_image(slug):
    preview = os.path.join(theme_dir(slug), "preview.png")
    if os.path.isfile(preview):
        return preview
    return first_background(slug)


DEFAULT_ACCENT = "#ffffff"
ACCENT_LUMINANCE_FLOOR = 0.35


def _hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip("#")
    return tuple(int(hex_color[i:i + 2], 16) for i in (0, 2, 4))


def _relative_luminance(rgb):
    r, g, b = (c / 255 for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _ensure_visible(hex_color):
    """Blends a too-dark accent color toward white in fixed steps until it
    clears ACCENT_LUMINANCE_FLOOR, so an unusually dark accent (a custom
    user theme we don't control, say) still shows up against the
    carousel's dark backdrop instead of nearly disappearing. Every accent
    currently shipped with ohmydebn already clears this floor - confirmed
    by hand - so this only ever engages for themes we've never seen."""
    r, g, b = _hex_to_rgb(hex_color)
    for _ in range(20):
        if _relative_luminance((r, g, b)) >= ACCENT_LUMINANCE_FLOOR or (r, g, b) == (255, 255, 255):
            break
        r, g, b = min(255, r + 20), min(255, g + 20), min(255, b + 20)
    return f"#{r:02x}{g:02x}{b:02x}"


def _rgba(hex_color, alpha):
    r, g, b = _hex_to_rgb(hex_color)
    return f"rgba({r}, {g}, {b}, {alpha})"


def theme_accent_color(slug):
    """Reads slug's own accent color straight from its colors.toml -
    independent of whether this theme is actually the live/applied one,
    unlike ohmydebn-menu-picker's load_theme_colors() (which only ever
    knows whatever was last applied, via
    ~/.config/ohmydebn/current/picker-colors - never written to until
    Enter, see this script's own header comment). That's what lets the
    carousel's chrome recolor itself live while browsing, the same way
    the preview images already do, without applying anything for real.
    Falls back to DEFAULT_ACCENT (today's plain white) for a theme with
    no colors.toml or no accent key there - not a regression, just no
    theming available for that one theme. Deliberately doesn't replicate
    ohmydebn-theme-set-colors' full legacy-format/alacritty.toml fallback
    cascade - every theme actually shipped here already has a semantic
    colors.toml with a real accent key (confirmed by hand), so that
    cascade would be dead code for anything but a hand-rolled custom
    theme, and even then the plain-white fallback below still degrades
    gracefully rather than crashing."""
    path = os.path.join(theme_dir(slug), "colors.toml")
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return DEFAULT_ACCENT
    accent = data.get("accent")
    if not isinstance(accent, str):
        return DEFAULT_ACCENT
    accent = accent.strip()
    if len(accent) != 7 or accent[0] != "#":
        return DEFAULT_ACCENT
    try:
        _hex_to_rgb(accent)
    except ValueError:
        return DEFAULT_ACCENT
    return _ensure_visible(accent)


def list_backgrounds_for_theme(slug):
    """Every raw background file for `slug`, from the same two directories
    and same sort order ohmydebn-theme-bg-next itself uses (user overrides
    at ~/.config/ohmydebn/backgrounds/<slug>/, then the theme's own
    backgrounds/ dir - no extension filter, unlike first_background() above,
    since bg-next doesn't filter either). Index N here is therefore the
    same file `ohmydebn-theme-set --background N` would pick, so what's
    previewed and what gets applied on Enter always stay in sync."""
    user_dir = os.path.expanduser(f"~/.config/ohmydebn/backgrounds/{slug}")
    theme_bg_dir = os.path.join(theme_dir(slug), "backgrounds")
    paths = []
    for base in (user_dir, theme_bg_dir):
        if not os.path.isdir(base):
            continue
        for name in os.listdir(base):
            full = os.path.join(base, name)
            if os.path.isfile(full):
                paths.append(full)
    return sorted(paths)


def current_theme_slug():
    try:
        with open(CURRENT_THEME_FILE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def current_background_path():
    try:
        return os.readlink(CURRENT_BACKGROUND_LINK)
    except OSError:
        return None


def get_monitor_geometry():
    display = Gdk.Display.get_default()
    seat = display.get_default_seat()
    _screen, x, y = seat.get_pointer().get_position()
    monitor = display.get_monitor_at_point(x, y) or display.get_primary_monitor() or display.get_monitor(0)
    return monitor.get_geometry()


def load_cover_pixbuf(path, target_w, target_h):
    """Scale-and-crop to fill target_w x target_h exactly, like CSS
    background-size:cover - avoids distorting the image, unlike a plain
    stretch-to-fit scale."""
    pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
    src_w, src_h = pixbuf.get_width(), pixbuf.get_height()
    scale = max(target_w / src_w, target_h / src_h)
    new_w, new_h = max(1, round(src_w * scale)), max(1, round(src_h * scale))
    scaled = pixbuf.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)
    x = max(0, (new_w - target_w) // 2)
    y = max(0, (new_h - target_h) // 2)
    x = min(x, new_w - target_w)
    y = min(y, new_h - target_h)
    return scaled.new_subpixbuf(x, y, min(target_w, new_w), min(target_h, new_h))


