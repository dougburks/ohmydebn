#!/bin/bash

set -euo pipefail

# "Installed" means podman plus the rootless extras (uidmap, passt) - see
# ohmydebn-podman-installed - so a podman missing those gets repaired here.
if ! /usr/share/ohmydebn/bin/ohmydebn-podman-installed; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Podman" /usr/share/ohmydebn/bin/ohmydebn-podman-install
fi

if dpkg -s "podman" >/dev/null 2>&1; then
  # Podman has no GUI, so "launching" it means opening a terminal already
  # running --help - a starting point for whatever subcommand the user
  # actually needs - then dropping into an interactive shell in that same
  # window so they can act on it immediately instead of the terminal just
  # closing again.
  #
  # First, in that terminal: Podman installed before the check existed may
  # still lack the subordinate ID ranges rootless mode needs (a no-op when
  # it has them). Adding them takes sudo, which needs the terminal to ask
  # for a password - run from the menu or hotkey directly, with no
  # terminal, it failed and nothing opened at all.
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal "Podman" "/usr/share/ohmydebn/bin/ohmydebn-podman-subids-ensure; podman --help; exec bash"
fi
