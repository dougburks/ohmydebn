#!/bin/bash
#
# Opens a plain (untiled) terminal running ohmydebn-socrates-launch - see
# ohmydebn-cliamp's own comment on why the payload lives in a separate
# script instead of here.

exec setsid /usr/share/ohmydebn/bin/ohmydebn-terminal --class OhMyDebn --title "SO-CRATES" -e /usr/share/ohmydebn/bin/ohmydebn-socrates-launch
