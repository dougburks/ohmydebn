#!/bin/bash

set -euo pipefail

if ! dpkg -s "brave-origin" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Brave Origin" /usr/share/ohmydebn/bin/ohmydebn-brave-origin-install
fi

if dpkg -s "brave-origin" >/dev/null 2>&1; then
  /usr/bin/brave-origin --skip-origin-startup-dialog
fi
