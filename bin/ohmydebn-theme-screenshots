#!/bin/bash

cat <<EOF
Continuing will iterate through all installed themes and take a screenshot of each.

Please arrange all windows as you like. For example:
- upper left - terminal running lt
- upper right - file manager
- lower left - fastfetch
- lower right - btop

This current window will automatically minimize.

Press Enter to continue or Ctrl-C to cancel.
EOF

read -r

/usr/bin/xdotool getactivewindow windowminimize

cd /usr/share/ohmydebn-themes/ || exit
for i in *; do
  /usr/share/ohmydebn/bin/ohmydebn-theme-set "$i"
  sleep 3s
  /usr/bin/gnome-screenshot -f ~/Pictures/"ohmydebn-theme-$i.png"
done
