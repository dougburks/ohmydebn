#!/bin/bash
#
# ohmydebn-theme-set-btop: Set btop theme configuration
# Usage: ohmydebn-theme-set-btop
#

# SIGUSR2 hot-reloads btop's config/theme from disk without restarting it -
# but only on btop >= 1.3.1, which is where that handler was added
# (upstream changelog: "Add hot-reloading of config file with CTRL+R or
# SIGUSR2 signal"). Any older btop has no handler for SIGUSR2 at all, so
# the signal falls back to its POSIX default action - terminating the
# process - confirmed as the real cause of a reported bug where btop's
# window (run as `alacritty -e btop`, no --hold, so the window closes the
# instant its child dies) vanished the moment a theme was applied, on a
# machine running btop 1.3.0. Version-gating below keeps the broad signal
# away from any btop the user opened by hand in an ordinary terminal - an
# old one of those would simply die. A version that fails to parse
# (unexpected `--version` output, or no btop installed) is treated the
# same as "too old" - skipping the broad signal is always the safe
# default here, never the dangerous one.
BTOP_VERSION=$(/usr/bin/btop --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
if [ -n "$BTOP_VERSION" ] && printf '%s\n' "1.3.1" "$BTOP_VERSION" | sort -C -V 2>/dev/null; then
  pkill -SIGUSR2 btop 2>/dev/null || true
else
  # Can't confirm this btop will hot-reload cleanly (too old, or the
  # version couldn't be parsed at all). The hotkey's own btop window
  # (Super+T / ohmydebn-btop-gui) runs btop under ohmydebn-btop-run, a
  # loop that restarts btop in the same terminal window whenever it is
  # terminated by SIGUSR2 specifically - so for that window alone, the
  # signal is still the right thing to send: an old btop dies and is back
  # a moment later in the new colors, in the same window, with its
  # position, size, workspace, monitor and tiling untouched (the previous
  # kill-the-window-and-relaunch fallback lost all of those, since gTile
  # re-placed the fresh window at the rule's default slot on whichever
  # monitor the pointer was on). Only btop processes that are direct
  # children of a running ohmydebn-btop-run get the signal - a btop the
  # user opened by hand has no loop around it and is left alone.
  while IFS= read -r RUN_PID; do
    [ -z "$RUN_PID" ] && continue
    while IFS= read -r BTOP_PID; do
      [ -z "$BTOP_PID" ] && continue
      kill -SIGUSR2 "$BTOP_PID" 2>/dev/null || true
    done < <(pgrep -P "$RUN_PID" -x btop)
  done < <(pgrep -f "ohmydebn-btop-run")
fi
