#!/bin/bash

mkdir -p ~/socrates-data
/usr/bin/podman run \
  --userns=keep-id \
  --user $(id -u):$(id -g) \
  -v ~/socrates-data:/data \
  -p 8000:8000 \
  ghcr.io/dougburks/so-crates@sha256:1c5ccc73de1a550eb820ecd96ea6c70d60ef7d92abfc1ca92e9f72bbe8601dca

echo
/usr/share/ohmydebn/bin/ohmydebn-socrates-cleanup
echo
echo "Press Enter to close this window."
read input
