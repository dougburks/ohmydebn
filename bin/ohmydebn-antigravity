#!/bin/bash

set -euo pipefail

if ! dpkg -s "antigravity" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-launch-floating-terminal-with-presentation "Antigravity" /usr/share/ohmydebn/bin/ohmydebn-antigravity-install
fi

if dpkg -s "antigravity" >/dev/null 2>&1; then
  # "$@" lets ohmydebn-ai-cli pass a directory to open (e.g. $PWD) while
  # every other caller (menu picks, ohmydebn-ai) still runs with no args.
  /usr/share/antigravity/bin/antigravity "$@"
fi
