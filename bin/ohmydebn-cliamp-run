#!/bin/bash
#
# The install-if-needed-then-run payload for cliamp, meant to run inside
# an already-open terminal (via -e) rather than opening one of its own -
# see ohmydebn-cliamp, which wraps this in a terminal instead of
# duplicating it.

set -euo pipefail

if ! dpkg -s "cliamp" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-show-logo
  /usr/share/ohmydebn/bin/ohmydebn-cliamp-install
  /usr/share/ohmydebn/bin/ohmydebn-show-done
fi
if dpkg -s "cliamp" >/dev/null 2>&1; then
  exec /usr/bin/cliamp
fi
