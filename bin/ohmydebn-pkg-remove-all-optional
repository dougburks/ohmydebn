#!/bin/bash

set -euo pipefail

echo "Continuing will remove all optional packages."
echo
echo "Press Enter to continue or Ctrl-C to cancel."
read input

for PACKAGE in cliamp code gnome-boxes localsend ohmydebn-opencode-cli virt-manager; do
  if dpkg -s $PACKAGE >/dev/null 2>&1; then
    sudo apt -y purge $PACKAGE
  fi
done

sudo apt -y autoremove

if dpkg -s antigravity >/dev/null 2>&1; then
  echo | /usr/share/ohmydebn/bin/ohmydebn-antigravity-remove
fi

if dpkg -s cloudflare-warp >/dev/null 2>&1; then
  echo | /usr/share/ohmydebn/bin/ohmydebn-warp-remove
fi

if dpkg -s brave-browser >/dev/null 2>&1; then
  echo | /usr/share/ohmydebn/bin/ohmydebn-brave-remove
fi
