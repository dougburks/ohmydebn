show_ai_menu() {
  # Picking any of these also makes it ohmydebn-ai's (Super+A's) default -
  # see ohmydebn-ai-set-default - so there's no separate "set default AI"
  # menu duplicating this same list.
  menu "AI" "󱚤  OpenCode (supports free/$ models)\n󱚤  Claude Code (Anthropic)\n󱚤  ChatGPT (OpenAI)\n󱚤  Pi (earendil-works)\n  VSCode (GitHub Copilot AI)\n  Antigravity (Google Agentic AI)"
  case "$MENU_RESULT" in
  *OpenCode*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default opencode; /usr/share/ohmydebn/bin/ohmydebn-opencode ;;
  *Claude*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default claude-code; /usr/share/ohmydebn/bin/ohmydebn-claude-code ;;
  *ChatGPT*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default chatgpt; /usr/share/ohmydebn/bin/ohmydebn-chatgpt ;;
  *Pi*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default pi; /usr/share/ohmydebn/bin/ohmydebn-pi ;;
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default antigravity; /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-ai-set-default vscode; /usr/share/ohmydebn/bin/ohmydebn-code ;;
  *) show_main_menu ;;
  esac
}

show_install_editor_menu() {
  menu "Install" "  VSCode\n  Antigravity\n  Emacs"
  case "$MENU_RESULT" in
  *Antigravity*) /usr/share/ohmydebn/bin/ohmydebn-antigravity ;;
  *VSCode*) /usr/share/ohmydebn/bin/ohmydebn-code ;;
  *Emacs*) install "Emacs" "emacs" ;;
  *) show_install_menu ;;
  esac
}

show_install_style_menu() {
  menu "Install" "󰸌  Theme\n  Background"
  case "$MENU_RESULT" in
  *Theme*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-theme-install ;;
  *Background*) nemo "$HOME/.config/ohmydebn/current/theme/backgrounds" ;;
  *) show_install_menu ;;
  esac
}

show_remove_menu() {
  menu "Remove" "  Package\n  Web App\n  TUI\n󰸌  Theme"
  case "$MENU_RESULT" in
  *Package*) terminal /usr/share/ohmydebn/bin/ohmydebn-pkg-remove ;;
  *Web*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-webapp-remove ;;
  *TUI*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-tui-remove ;;
  *Theme*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-theme-remove ;;
  *) show_main_menu ;;
  esac
}

show_update_menu() {
  menu "Update" "  OhMyDebn\n  Password\n  Timezone"
  case "$MENU_RESULT" in
  *OhMyDebn*) /usr/share/ohmydebn/bin/ohmydebn-update-gui ;;
  *Password*) show_update_password_menu ;;
  *Timezone*) cinnamon-settings calendar ;;
  *) show_main_menu ;;
  esac
}

show_update_password_menu() {
  menu "Update Password" "  User"
  case "$MENU_RESULT" in
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_system_menu() {
  menu "System" "  Lock\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown"
  case "$MENU_RESULT" in
  *Lock*) cinnamon-screensaver-command -l ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) /usr/bin/cinnamon --replace & ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  # go_items is the single source of truth for both the picker's default
  # (empty-query) view and menu_tree_flatten/-categories' recursive walk
  # (bin/ohmydebn-menu-tree) - it's real, executed bash (passed as an
  # argument below), not a comment, so it can't silently drift out of
  # sync the way dead/unused data could.
  local go_items="󰀻  Apps\n󰧑  Learn\n  Capture\n  Style\n󱚤  AI\n󰖟  Browser\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  Demo\n󰍉  Screen Magnifier\n  System"
  menu "Go" "$go_items"
  go_to_menu "$MENU_RESULT"
}

# Dispatches a bare category label - used both for show_main_menu's own
# picker result above, and directly for the DIRECT_ACCESS CLI-arg path at
# the bottom of this script (e.g. `ohmydebn-menu install` from a
# keybinding). menu() now resolves every searched-descendant breadcrumb
# itself before anything gets here, so this never receives one anymore -
# every "${1,,}" case arm here only ever needs to match a same-level label.
go_to_menu() {
  case "${1,,}" in
  *apps*) /usr/share/ohmydebn/bin/ohmydebn-app-launcher ;;
  *learn*) show_learn_menu ;;
  *style*) /usr/share/ohmydebn/bin/ohmydebn-theme-carousel ;;
  *theme*) /usr/share/ohmydebn/bin/ohmydebn-theme-carousel ;;
  *ai*) show_ai_menu ;;
  *browser*) show_browser_menu ;;
  *capture*) show_capture_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) /usr/share/ohmydebn/bin/ohmydebn-fastfetch-gui ;;
  *demo*) /usr/share/ohmydebn/bin/ohmydebn-demo-gui ;;
  *magnifier*) present_terminal /usr/share/ohmydebn/bin/ohmydebn-magnifier-enable ;;
  *system*) show_system_menu ;;
  esac
}

if [[ -n "${1:-}" ]]; then
  DIRECT_ACCESS=true
  go_to_menu "$1"
else
  show_main_menu
fi
