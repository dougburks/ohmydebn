#!/bin/bash
#
# ohmydebn-theme-set-rofi: Set rofi theme based on colors
# Usage: ohmydebn-theme-set-rofi <theme-name> <colors-source> <is-light-mode>
#

set -e

if [[ $# -lt 3 ]]; then
  echo "Usage: ohmydebn-theme-set-rofi <theme-name> <colors-source> <is-light-mode>" >&2
  exit 1
fi

THEME_NAME="$1"
COLORS_SOURCE="$2"
IS_LIGHT_MODE="$3"

ROFI_DIR=~/.config/rofi

ROFI_THEME="$ROFI_DIR/square-gray-dark.rasi"
ROFI_GENERATED=""

# Generate dynamic rofi theme if we have color information
if [[ -n "$COLORS_SOURCE" && -f "$COLORS_SOURCE" ]]; then
  ROFI_GENERATED="$ROFI_DIR/generated-${THEME_NAME}.rasi"

  # Parse colors from the colors source
  BG=$(grep -E "^\s*background\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')
  FG=$(grep -E "^\s*foreground\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')
  ACCENT=$(grep -E "^\s*accent\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')
  COLOR0=$(grep -E "^\s*color0\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')
  COLOR7=$(grep -E "^\s*color7\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')
  COLOR8=$(grep -E "^\s*color8\s*=" "$COLORS_SOURCE" | head -1 | sed -E 's/.*=\s*"([^"]+)".*/\1/')

  # Fallback to FG for missing colors
  COLOR0=${COLOR0:-$FG}
  COLOR7=${COLOR7:-$FG}
  COLOR8=${COLOR8:-$FG}

  # Determine colors based on light/dark mode
  if [[ "$IS_LIGHT_MODE" == "true" ]]; then
    # Light theme: dark text on light backgrounds
    BG0="${BG}F2"      # Add transparency
    BG1="$BG"
    BG2="${COLOR8}80"  # Semi-transparent
    BG3="${ACCENT}F2"
    FG0="$FG"
    FG1="${COLOR0}"    # Darker text
    FG2="${FG}"
    FG3="#3D3D3D"      # Placeholder (gray)
  else
    # Dark theme: light text on dark backgrounds
    BG0="${BG}F2"
    BG1="$BG"
    BG2="${COLOR0}80"
    BG3="${ACCENT}F2"
    FG0="$FG"
    FG1="${COLOR7}"
    FG2="${FG}"
    FG3="#3D3D3D"
  fi

  # Generate the rasi file
  cat >"$ROFI_GENERATED" <<EOF
* {
    bg0:    ${BG0};
    bg1:    ${BG1};
    bg2:    ${BG2};
    bg3:    ${BG3};
    fg0:    ${FG0};
    fg1:    ${FG1};
    fg2:    ${FG2};
    fg3:    ${FG3};
}

@import "template/square-template.rasi"

element selected {
    text-color: @bg1;
}
EOF

  ROFI_THEME="$ROFI_GENERATED"
fi

# Update rofi theme
mkdir -p $ROFI_DIR
ROFI_CONFIG=$ROFI_DIR/config.rasi
if [ -f $ROFI_CONFIG ]; then
  mv $ROFI_CONFIG $ROFI_CONFIG-backup-$(date +%Y%m%d-%H%M%S)
fi
cat <<EOF >$ROFI_CONFIG
@theme "$ROFI_THEME"
EOF
