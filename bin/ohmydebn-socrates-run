#!/bin/bash

mkdir -p ~/socrates-data
/usr/bin/podman run \
  --userns=keep-id \
  --user $(id -u):$(id -g) \
  -v ~/socrates-data:/data \
  -p 8000:8000 \
  ghcr.io/dougburks/so-crates@sha256:3e4f777a54146aa8f8abbd40bd33bdb541d2e75c8e33b8679bb6f68dda5611e6

echo
/usr/share/ohmydebn/bin/ohmydebn-socrates-cleanup
echo
echo "Press Enter to close this window."
read input
