#!/bin/bash

set -euo pipefail

# Rootless podman can't unpack the image without subordinate UID/GID
# ranges for this user, and some installs (Devuan's, for one) leave them
# out - backfill before the pull rather than let it fail on /etc/gshadow.
# If that didn't work (its sudo declined, say), stop here: the pull would
# only fail with the lchown error this exists to prevent.
if ! /usr/share/ohmydebn/bin/ohmydebn-podman-subids-ensure; then
  echo
  echo "SO-CRATES can't start without subordinate UID/GID ranges for $(id -un)."
  echo "Press Enter to close this window."
  read -r || true
  exit 1
fi

mkdir -p ~/socrates-data

IMAGE_REPO="ghcr.io/dougburks/so-crates"
DEFAULT_IMAGE="$IMAGE_REPO@sha256:9dcba4943fb4356138b1f10f3b114b23cb6c67541ff6b79e6e58a80cd7900263"

if [[ -n "${1:-}" ]]; then
  IMAGE="$IMAGE_REPO:$1"
else
  IMAGE="$DEFAULT_IMAGE"
fi

OHMYDEBN_CURRENT_DIR="$HOME/.config/ohmydebn/current"

PODMAN_ARGS=(
  run
  # Remove the container when SO-CRATES stops: everything worth keeping is
  # in ~/socrates-data, mounted below. Without it every launch left a
  # stopped container behind, and ohmydebn-socrates-cleanup only removes
  # those of older images.
  --rm
  --userns=keep-id
  --user "$(id -u):$(id -g)"
  -v ~/socrates-data:/data
  # This computer only: SO-CRATES shows the packet captures it's given, and
  # nothing else on the network needs to reach it, firewall or not.
  # Listening on 127.0.0.1 alone also keeps "localhost" working where it
  # resolves to ::1 first (most Debian-family systems): with nothing
  # listening on ::1 the browser is refused at once and falls back to
  # 127.0.0.1. With -p 8000:8000, pasta accepted on ::1 and the connection
  # hung, since the server listens only on IPv4 - which releases before
  # 4.9.0 worked around by setting pasta_options = ["-4"] in the user's
  # containers.conf, turning off IPv6 in every rootless container they
  # run. That line is no longer written; one already there is left alone.
  -p 127.0.0.1:8000:8000
)

# Best-effort: only mount if OhMyDebn has ever set a theme.
if [[ -d "$OHMYDEBN_CURRENT_DIR" ]]; then
  PODMAN_ARGS+=(
    -v "$OHMYDEBN_CURRENT_DIR:/run/ohmydebn/current:ro"
    -e OHMYDEBN_THEME_DIR=/run/ohmydebn
  )
fi

SOCRATES_URL="http://127.0.0.1:8000/"

# Any HTTP answer at all, not just an open port: pasta takes connections
# on the published port as soon as the container starts, long before the
# server inside listens, and resets them. curl fails on that reset.
socrates_answers() {
  /usr/bin/curl -s -o /dev/null --max-time 2 "$SOCRATES_URL"
}

# Opens the web interface once SO-CRATES answers, so there's no need to
# click the link it prints. That's minutes away on the first run, which
# pulls the image first, so this waits in the background (up to half an
# hour) while podman holds the terminal. setsid keeps a browser it starts
# from closing with this window; one already running just gets a tab.
open_when_ready() {
  local i
  for ((i = 0; i < 900; i++)); do
    if socrates_answers; then
      setsid -f /usr/bin/xdg-open "$SOCRATES_URL" >/dev/null 2>&1 </dev/null || true
      return 0
    fi
    sleep 2
  done
}

# No browser to open without a desktop (run over SSH, say). And when
# something already answers on the port, podman can't publish it and stops
# with its own error: opening the browser would show whatever that is.
OPENER_PID=""
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && ! socrates_answers; then
  open_when_ready &
  OPENER_PID=$!
fi

# Stopping SO-CRATES with Ctrl-C (or a failed pull) makes podman exit
# non-zero; the cleanup and the pause below still run, so its output stays
# readable.
/usr/bin/podman "${PODMAN_ARGS[@]}" \
  "$IMAGE" || true

# A pull that failed never answers: stop waiting for it. Background jobs
# ignore the Ctrl-C that stopped podman, so this has to be explicit.
if [[ -n "$OPENER_PID" ]]; then
  kill "$OPENER_PID" 2>/dev/null || true
  wait "$OPENER_PID" 2>/dev/null || true
fi

echo
/usr/share/ohmydebn/bin/ohmydebn-socrates-cleanup || true
echo
echo "Press Enter to close this window."
read -r || true
