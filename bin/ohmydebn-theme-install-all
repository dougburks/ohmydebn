#!/bin/bash

URL="https://learn.omacom.io/2/the-omarchy-manual/90/extra-themes"
cat <<EOF
Continuing will install all third-party themes from:
$URL

Depending on the speed of your Internet connection,
this may take a few minutes.

Press Enter to continue or Ctrl-C to cancel.
EOF

read input

THEMES_DIR="$HOME/.config/ohmydebn/themes"

curl -s $URL | grep github.com | cut -d\" -f2 | while read REPO_URL; do
  THEME_NAME=$(basename "$REPO_URL" .git | sed -E 's/^omarchy-//; s/-theme$//')
  THEME_PATH="$THEMES_DIR/$THEME_NAME"

  if [ -d "$THEME_PATH" ]; then
    echo "$THEME_NAME - already installed"
  else
    echo "$THEME_NAME - installing:"
    if ! GIT_TERMINAL_PROMPT=0 git clone "$REPO_URL" "$THEME_PATH"; then
      echo "Error: Failed to clone $THEME_PATH"
    fi
  fi
  echo
done
