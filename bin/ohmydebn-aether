#!/bin/bash
#
# ohmydebn-aether: launches the Aether theme builder. gTile-OhMyDebn's
# own window-created auto-tile handler tiles this window itself,
# matching its own wmClass against
# /usr/share/ohmydebn/config/tile-rules.json.

set -euo pipefail

# Aether >= 4.29.9 lists stock Omarchy themes from $OMARCHY_PATH/themes
# (default /usr/share/omarchy/themes) rather than ~/.local/share/omarchy/
# themes, which is where install/config/theme.sh symlinks OhMyDebn's stock
# themes. Point it at the parent of that symlink so the list stays full.
export OMARCHY_PATH="$HOME/.local/share/omarchy"

# Aether >= 4.29.9 applies themes by looking up an `omarchy` executable on
# PATH - OhMyDebn's shim at /usr/share/ohmydebn/bin/omarchy - and reports
# "omarchy is not installed" for every apply when that lookup fails. The
# desktop session normally has that directory on PATH via ~/.xsessionrc
# (install/config/zsh.sh), but only a session started through Debian's X
# session scripts sources that file; on Raspberry Pi OS it isn't, and a
# hotkey launch of Aether arrived with no shim in reach. Put it there
# ourselves so the launch never depends on how the session was started.
case ":$PATH:" in
*":/usr/share/ohmydebn/bin:"*) ;;
*) export PATH="/usr/share/ohmydebn/bin:$PATH" ;;
esac

exec /usr/share/aether/aether
