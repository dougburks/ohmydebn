#!/bin/bash

set -euo pipefail

VERSION="1.14.33"
SCRIPT_DIR="/usr/share/ohmydebn/bin"

# Only prompt if the package is not installed at all
if ! dpkg -s "open-code" >/dev/null 2>&1; then
  echo
  echo "OpenCode is not currently installed."
  echo
  echo "Continuing will install OpenCode $VERSION from:"
  echo "https://github.com/anomalyco/opencode"
  echo
  echo "Press Enter to continue or Ctrl-C to cancel."
  read -r
fi

# Set autoupdate to false
OPENCODE_CONFIG="$HOME/.config/opencode/opencode.json"
OPENCODE_CONFIG_BACKUP="$HOME/.config/opencode/opencode.json.before.disabling.autoupdate"
if [ -f "$OPENCODE_CONFIG" ] && [ ! -f "$OPENCODE_CONFIG_BACKUP" ]; then
  cp "$OPENCODE_CONFIG" "$OPENCODE_CONFIG_BACKUP"
  jq '.autoupdate = false' "$OPENCODE_CONFIG" >"${OPENCODE_CONFIG}.tmp" && mv "${OPENCODE_CONFIG}.tmp" "$OPENCODE_CONFIG"
fi

# Install the package
exec "$SCRIPT_DIR/ohmydebn-github-deb-install" "anomalyco/opencode" "opencode-desktop-linux-\${ARCH}.deb" "${VERSION}"
