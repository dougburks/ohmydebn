#!/bin/bash
#
# Launches a command with its new window tiled to a grid cell, through
# gTile's TileNextWindow (see ohmydebn-gtile-tile-next): gTile takes the
# next new window, keeps it hidden until it's in place, and only then
# shows it. For launchers whose app can't be told apart by the process
# they start: most go through a check or helper first, and a browser
# that's already running hands the launch to its existing process.
#
# This used to tile whatever window took focus after the launch, found
# through xdotool, which only sees X11 windows: in Cinnamon's Wayland
# session Brave, Nemo and other Wayland apps opened untiled in the middle
# of the screen. Now only a new window is tiled. An app that just raises
# a window it already has open leaves that window where it is.
#
# Usage: ohmydebn-launch-tiled <cols> <rows> <colIndex> <rowIndex> <colSpan> <rowSpan> -- <command> [args...]

set -uo pipefail

if [ "$#" -lt 7 ] || [ "$7" != "--" ]; then
  echo "Usage: $0 <cols> <rows> <colIndex> <rowIndex> <colSpan> <rowSpan> -- <command> [args...]" >&2
  exit 1
fi
GRID=("$1" "$2" "$3" "$4" "$5" "$6")
shift 7

# gTile-OhMyDebn's "tiling-mode" setting (System Settings > Extensions >
# gTile > Configure) promises "Off: nothing is tiled automatically - only
# the manual 'Tile with gaps N' hotkeys apply", so this only tiles in
# "rules" mode. In "traditional", "traditional-full" and "scrollable",
# gTile places new windows itself, and a forced grid would fight it. In
# "rules" mode this is a rule given at launch, for windows
# tile-rules.json's title and class matching can't catch (an app-mode
# browser window's title changes with whatever page is loaded).
TILING_MODE=$(/usr/share/ohmydebn/bin/ohmydebn-gtile-tiling-mode)
if [ "$TILING_MODE" = "rules" ]; then
  /usr/share/ohmydebn/bin/ohmydebn-gtile-tile-next "${GRID[@]}" || true
fi

# Backgrounded, and this returns at once: callers (hotkeys, the menu)
# must never wait on the launched app's lifetime.
"$@" &
