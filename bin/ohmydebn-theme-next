#!/bin/bash

set -euo pipefail

THEMES_DIR="$HOME/.config/ohmydebn/themes/"
OHMYDEBN_THEMES_DIR="/usr/share/ohmydebn-themes/"
# ohmydebn-theme-set records the name it switched to here. current/theme
# itself is a real directory (a copy), not a symlink to the theme, so it
# can't tell us which theme is current.
CURRENT_THEME_NAME_FILE="$HOME/.config/ohmydebn/current/theme.name"

# By name, the way ohmydebn-theme-list and ohmydebn-theme-set see them: a
# user theme with the same name as a shipped one is the same theme.
mapfile -t THEMES < <({
  find "$THEMES_DIR" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$OHMYDEBN_THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null
} | sort -u)
TOTAL=${#THEMES[@]}

if [[ "$TOTAL" -eq 0 ]]; then
  echo "No themes found."
  exit 1
fi

CURRENT_THEME=$(cat "$CURRENT_THEME_NAME_FILE" 2>/dev/null || true)

# Unknown or unset current theme: start from the first one.
NEXT_INDEX=0
for i in "${!THEMES[@]}"; do
  if [[ "${THEMES[$i]}" == "$CURRENT_THEME" ]]; then
    NEXT_INDEX=$(((i + 1) % TOTAL))
    break
  fi
done
NEW_THEME_NAME=${THEMES[$NEXT_INDEX]}

/usr/share/ohmydebn/bin/ohmydebn-theme-set "$NEW_THEME_NAME"
if command -v notify-send >/dev/null 2>&1; then
  notify-send "Theme changed to $NEW_THEME_NAME" -t 2000
fi
