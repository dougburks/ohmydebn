#!/bin/bash

set -e

# --yes: skip the "Press Enter to continue" confirmation below. Used by
# ohmydebn-update-gui, whose "Update Now" button - shown alongside this
# same warning text - IS the confirmation, so a second stdin prompt here
# would just hang a process that has no keyboard-owning terminal.
# Deliberately NOT forwarded to install.sh: its own prompts are
# different consents (unsupported-distro and running-as-root warnings)
# that the button never covered, and forwarding --yes would silently
# skip them - found in review. On a supported-distro, non-root system
# (every normal update) install.sh prompts for nothing anyway; where its
# warnings do fire under the GUI, ohmydebn-update-gui detects them and
# reveals its terminal so they can be answered for real.
ASSUME_YES=false
for arg in "$@"; do
  case $arg in
  --yes)
    ASSUME_YES=true
    ;;
  esac
done

# Log every run to a file. A failed update is the commonest support
# case, and until now its output lived only in terminal scrollback or the
# GUI's details pane - gone with the window. The run re-execs itself under
# util-linux's `script`, which gives the child a real pty (so apt keeps
# its progress output and the GUI's stream parser sees exactly what it
# saw before) while copying every byte to the log, and returns the
# child's own exit status (-e). sudo disables echo before reading a
# password, so passwords never reach the log. Logging is best-effort:
# if `script` is missing or the directory can't be made, the update runs
# unlogged rather than not at all. OHMYDEBN_UPDATE_LOG marks the inner,
# already-logged run (and tells later steps where the log is);
# OHMYDEBN_UPDATE_NO_LOG=1 opts out. The newest KEEP_LOGS runs are kept;
# update-latest.log always points at the current one. The log dir sits
# beside ~/.local/state/ohmydebn-config (~/.local/state/ohmydebn itself
# is the "installation complete" marker file, not a directory).
LOG_DIR="$HOME/.local/state/ohmydebn-logs"
KEEP_LOGS=10
if [ -z "${OHMYDEBN_UPDATE_LOG:-}" ] && [ "${OHMYDEBN_UPDATE_NO_LOG:-}" != "1" ] &&
  command -v script >/dev/null 2>&1 && mkdir -p "$LOG_DIR" 2>/dev/null; then
  OHMYDEBN_UPDATE_LOG="$LOG_DIR/update-$(date +%Y%m%d-%H%M%S).log"
  # Rotate before creating: drop everything past the newest KEEP_LOGS-1,
  # so with this run there are at most KEEP_LOGS. The [0-9] keeps the
  # update-latest.log symlink out of the candidate list.
  ls -1t "$LOG_DIR"/update-[0-9]*.log 2>/dev/null | tail -n +"$KEEP_LOGS" | xargs -r rm -f --
  ln -sfn "$OHMYDEBN_UPDATE_LOG" "$LOG_DIR/update-latest.log"
  export OHMYDEBN_UPDATE_LOG
  WRAPPED_CMD=$(printf '%q ' bash "$0" "$@")
  exec script -qefc "$WRAPPED_CMD" "$OHMYDEBN_UPDATE_LOG"
fi

if dpkg -s "ohmydebn" >/dev/null 2>&1; then
  DIR=/usr/share/ohmydebn
else
  DIR=~/.local/share/ohmydebn
fi

VERSION=$($DIR/bin/ohmydebn-version)

$DIR/bin/ohmydebn-headline "OhMyDebn Update - current OhMyDebn version: $VERSION"
if [ -n "${OHMYDEBN_UPDATE_LOG:-}" ]; then
  echo "Logging this update to $OHMYDEBN_UPDATE_LOG"
  echo
fi

if [ "$ASSUME_YES" = false ]; then
  cat <<EOF
Continuing will check for any updates for the
base OS packages and OhMyDebn components.

You can check the OhMyDebn release notes here:
https://github.com/dougburks/ohmydebn/releases

If this update is interrupted, then your machine may be left in an
inconsistent state so please make sure you have stable power and
Internet access before continuing.

Press Enter to continue or Ctrl-C to cancel.
EOF

  read -r
fi

# Update time
sudo /usr/bin/chronyc makestep >/dev/null 2>&1 || true

# Update the ohmydebn package first to get the latest code
if dpkg -s "ohmydebn" >/dev/null 2>&1; then
  $DIR/bin/ohmydebn-headline "Checking for an updated ohmydebn package"
  sudo /usr/bin/apt update && sudo /usr/bin/apt -y install ohmydebn
fi

bash $DIR/install.sh
