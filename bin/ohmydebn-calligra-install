#!/bin/bash

set -euo pipefail

SKIP_PROMPT=false
if [ "${1:-}" = "--skip-prompt" ]; then
  SKIP_PROMPT=true
fi

if ! dpkg -s "calligra" >/dev/null 2>&1; then
  if [ "$SKIP_PROMPT" = false ]; then
    echo
    echo "Calligra Suite is not currently installed."
    echo
    echo "Continuing will install it from your existing distro repo."
    echo
    echo "Press Enter to continue or Ctrl-C to cancel."

    read -r
  fi

  sudo /usr/bin/apt update
  sudo /usr/bin/apt -y install calligra
fi
