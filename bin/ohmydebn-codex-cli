#!/bin/bash

set -euo pipefail

# Companion to ohmydebn-codex: that script launches Codex in a new
# terminal window (via ohmydebn-terminal), for use from the app
# launcher/menu. This one runs Codex directly in the caller's existing
# terminal - the shape the `codex` shell alias needs, matching how the
# `pi` alias runs ohmydebn-pi-cli in-place instead of opening a window.

if ! dpkg -s "ohmydebn-codex-cli" >/dev/null 2>&1; then
  /usr/share/ohmydebn/bin/ohmydebn-codex-install
fi

exec /usr/lib/ohmydebn-codex-cli/bin/codex "$@"
